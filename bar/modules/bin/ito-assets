#!/usr/bin/env python3
"""ito-assets — the index of the pictures you drew yourself (decisions-b9 section 6).

Any PNG under ~/.config/ito/assets/<same path as bar/modules/ito-art> replaces the shipped picture of that name. This tool
only READS that folder and writes one small index; it never copies or changes a picture, and runs no hook, unit or timer.

    ito-assets index [--if-stale]   check every PNG and write ~/.cache/ito/assets-index.json (one JSON line on stdout)
    ito-assets status               the index as it is now (no check)
    ito-assets slots                the named slots of boot-screens-v2 D.3 (path, canvas, what each is for)
    ito-assets ingest FILE --as SLOT [--light]
                                    turn a generator picture (white ink on black; with --light black ink on white) into the
                                    slot's transparent PNG, keep the original under _sources/, rebuild the index

    ito-assets migrate-marks        rename marks/remina-real{,.light}.png (and its bar files) to marks/remina{,.light}.png (idempotent; `index` runs it)
    ito-assets recipe eye-uzumaki|eye-lashed|eye-veined FILE [--dry-run]
                                    the popup-head eyes of S14 from your spiral-eye engraving (1672x941), eye sheet (680x680) or eye cluster (1199x596):
                                    eyes/<id>/{lid,iris}[.light].png (+ hot for the Uzumaki eye) at 512 wide and at the box heights 34 54 68 108.
    ito-assets recipe ws-uzumaki-eye|mark-heather|mark-pyramid FILE [--iris FILE] [--dry-run]
                                    S15c: workspaces/bar/<px>/ws-uzumaki-eye-<n>-<state>[.light|.alt].png from your bleeding-eye.png (105 px) or Silent Hill
                                    sheet (1536x1024); marks/{heather,pyramid}[.light].png + marks/bar/<px>/ from your Heather / Pyramid roundel sheet (1536x1024).
                                    `.alt` = the alternative definition (keys shMicro art, eyeWsIris plain). --iris: the 1672x941 engraving for the spiral iris.
    ito-assets recipe tomie|uzumaki-eye|beetle|ws-beetle|ws-tomie FILE [--dry-run]
                                    the photo recipes of S2c: the user's own Tommie drawing (565x933) or HD Tomie panel (1500x2000), engraving (1672x941) or beetle (920x920) cropped,
                                    levelled and cut at every tier into marks/<name>{,.light}.png + marks/bar/<px>/ (ws-beetle: the Mayan-numeral
                                    workspace set workspaces/bar/<px>/ws-beetle-<n>-<state>.png). Refused for any other size of source.
    ito-assets recipe relic-sys|ws-symbols|relic-apps FILE [--dry-run] [--out DIR --ink R,G,B --blood R,G,B --light]
                                    S18, from your shell asset sheet (1536x1024): bar icons relic/sys/bar/<px>/..., workspace family Symbols workspaces/bar/<px>/ws-symbols-<n>-<state>.png,
                                    relic-apps = the icon theme Ito-verse-icons-v2 (colours baked, written to --out).
    ito-assets recipe sprites FILE [--dry-run]
                                    from your sprite sheet (SHASSETS.png, 1920x1080): marks pyramid-roundel, moth, eye-roundel, key;
                                    hollow/bar/<px>/cassette-on|off, cup-on|off (indicator versions) and key.
    ito-assets recipe pyramid-head FILE [--dry-run]
                                    from your Pyramid Head side view (pyramid-head-hd-side.png, 1254x1254): workspace family `pyramid`
                                    (workspaces/bar/<px>/ws-pyramid-<n>-<state>[.light].png, the ringed figure of your workspace sheet)
                                    and the menu mark pyramid-head. Every workspace family recipe also writes the Control Centre
                                    picker's numeral-free card art, ws-<family>-preview-active[.light].png.
    ito-assets recipe ws-heather FILE [--dry-run]
                                    from your Heather / Pyramid roundel sheet (Heather pyramid.png, 1536x1024): workspace family `heather`
                                    (workspaces/bar/<px>/ws-heather-<n>-<state>[.light].png), her portrait in the workspace sheet's ring.
    ito-assets recipe ws-cult [--dry-run]
                                    workspace family Cult Symbols (style `cult`): Silent Hill's symbols (traced from skillunex.com/silent-hill-symbols) drawn per tier (no FILE):
                                    workspaces/bar/<px>/ws-cult-<n>-<state>[.light].png, tiers 24-128.
    ito-assets recipe sheets [--tomie FILE] [--pyramid FILE] [--sprites FILE] [--only KEY,...] [--dry-run]
                                    the lock scenes of your Boot & Lock sheets, rebuilt in high resolution from your HD pictures (the sheet
                                    cards are only the composition guides; no baked text): lock/<key>-2560x1440.png and lock/<key>-1920x1080.png
                                    for tomie, pyramid, road, moth (lock designs of the same names), and cards/<key>.png (the boot compositions
                                    card-<key> of ito-plymouth). Sources default to the copies in _sources/.
    ito-assets recipe spiral [--dry-run]
                                    the Sheet spiral at every tier (S15) from the shipped hand drawing: system/bar/<px>/system-normal.png (the hand drawing, enhanced) + system-normal-clean.png (centreline rebuild). The tomie /
                                    uzumaki-eye / beetle recipes also write the v10 definition beside the v9 files (`<name>.v10{,.light}.png`, key markDef).
    ito-assets recipe --list        the recipes (below)
    ito-assets recipe lightink|lineart FILE --as REL [--crop x0,y0,x1,y1] [--erase x0,y0,x1,y1] [--size N|WxH] [--seal N]
                                    [--bar] [--dry-run]
                                    turn one picture of yours into theme-ready art (neutral ink + alpha, no opaque black):
                                    lineart also writes the `.light` twin; --bar adds the 24/28/32/40/44/48/56/64/80/88 px files, and a
                                    bar file that fails the legibility gate is not written. Writes only under the assets
                                    folder (never inside a repo), keeps the source in _sources/, rebuilds the index.
                                    --dry-run writes to a temp folder, prints the gate and deletes it.

Light twin and bar sizes: `<dir>/<name>.light.png` is shown instead of `<dir>/<name>.png` on a light theme; `<dir>/bar/<px>/<name>.png`
(exactly px x px, px in 24 28 32 40 44 48 56 64 80 88) is the bar-size picture of a shipped `<dir>/<name>.png`. Your menu marks: `marks/<name>.png`
(512 x 512 +-1 %, name [a-z0-9-]{1,24}), `marks/<name>.light.png`, `marks/bar/<px>/<name>.png`: they show as `user:<name>` in the mark picker.

Slots (boot/, screensaver/, fetch/, lock/, bg/, system/) have no shipped picture: they are listed under "slots" in the index with
their own canvas check; the shell tints them with the theme, you never choose the colour. `_sources/` is never read as art.

The shell reads the index; a picture that is not listed as ok is never used (the shipped picture stays). Limits: a PNG file,
<= 8 MB, each side <= 4096 and <= 8 x the shipped side, >= 0.5 x the shipped side (a warning below 1 x), the aspect within
+-8 % of the shipped file, <= 16.7 Mpx, decodable. The folder `eye/` belongs to the lock screen's eye and is never mapped.
Warnings (never a rejection): more than 20 % of the opaque pixels darker than 0.15 L (draw on transparent), pixel (0,0) not
transparent (the drawn icons sample it), a colour file (it is flattened onto the theme by the shader).
Test overrides: ITO_ASSETS_DIR, ITO_ASSETS_INDEX, ITO_ART_DIR.
"""
import hashlib, json, os, re, sys, time
from pathlib import Path

HERE = Path(__file__).resolve().parent
if str(HERE) not in sys.path:
    sys.path.insert(0, str(HERE))          # ito_sh (S17), a sibling module, whichever way this file is loaded
HOME = Path(os.environ.get("HOME", "~")).expanduser()
ASSETS = Path(os.environ.get("ITO_ASSETS_DIR") or HOME / ".config" / "ito" / "assets")
INDEX = Path(os.environ.get("ITO_ASSETS_INDEX") or HOME / ".cache" / "ito" / "assets-index.json")
ART = Path(os.environ.get("ITO_ART_DIR") or Path(__file__).resolve().parent.parent / "ito-art")
MAX_BYTES, MAX_SIDE, MAX_PX, BUDGET = 8 * 1024 * 1024, 4096, 16.7e6, 20.0
RESERVED = ("eye", "_sources", "lock", "cards")      # lock/, cards/: the lock scenes and boot cards of `recipe sheets` (read by ito-lock / ito-plymouth, not slots of the shell)


# boot-screens-v2 D.3: slot -> (canvas w, h or None, aspect rule). aspect rule: ("ratio", r, tol) | ("range", lo, hi) | ("any",).
# `.light.png` variants share the slot of the same name.
def _r(w, h, tol=0.01):
    return (w, h, ("ratio", w / h, tol))


SLOTS = {
    "boot/eye-shut.png": _r(1672, 941), "boot/wake-01.png": _r(1672, 941), "boot/wake-02.png": _r(1672, 941),
    "boot/wake-03.png": _r(1672, 941), "boot/wake-04.png": _r(1672, 941),
    "boot/bg.png": _r(2560, 1440), "screensaver/spiral.png": _r(2048, 2048),
    "screensaver/fog-a.png": _r(3840, 720), "screensaver/fog-b.png": _r(3840, 720),
    "screensaver/custom.png": (2560, 1440, ("custom",)), "fetch/logo.png": (1000, 1200, ("range", 0.6, 1.4)),
    "lock/bg.png": _r(2560, 1440), "lock/mark.png": _r(512, 512), "bg/grain.png": _r(512, 512), "bg/screen.png": _r(2560, 1440),
    "system/jar.png": _r(512, 512), "system/jar-fill.png": _r(512, 512),
    "system/tray.png": _r(512, 512), "system/tray-fill.png": _r(512, 512),
}
SLOT_USE = {
    "boot/eye-shut.png": "Plymouth, both tiers (the eye with the lids closed)", "boot/bg.png": "Plymouth tier I background",
    "screensaver/spiral.png": "image screensaver: spiral", "screensaver/fog-a.png": "image screensaver: fog strip A",
    "screensaver/fog-b.png": "image screensaver: fog strip B", "screensaver/custom.png": "image screensaver: custom",
    "fetch/logo.png": "fastfetch / About logo", "lock/bg.png": "lock background", "lock/mark.png": "lock seal",
    "bg/grain.png": "grain tile of every ground", "bg/screen.png": "screensaver background",
    "system/jar.png": "bar tray jar", "system/jar-fill.png": "bar tray jar interior", "system/tray.png": "bar tray",
    "system/tray-fill.png": "bar tray interior",
}
for _n in (1, 2, 3, 4):
    SLOT_USE[f"boot/wake-0{_n}.png"] = "Plymouth tier I wake frame"


def slot_of(rel):
    """The registry key of a path (`fetch/logo.light.png` -> `fetch/logo.png`), or None."""
    key = rel[:-10] + ".png" if rel.endswith(".light.png") else rel
    return key if key in SLOTS else None


# A1a / A1b: bar-size buckets, light twins and the user's menu marks.
# S2c: the S2d tier list (bar = the nearest tier to round(size * dpr); cards 56/60 at 1x, 112/120 at 2x; 128 the biggest card).
BAR_PX = (24, 26, 28, 30, 32, 36, 40, 44, 48, 56, 60, 64, 72, 80, 88, 96, 112, 120, 128)   # S15: + 26 (the new default mark size) and 30
LEGACY_BAR_PX = (24, 28, 32, 40, 44, 48, 56, 64, 80, 88)     # what the generic lightink/lineart `--bar` has always written
MARK_RE = re.compile(r"^marks/(?:bar/(\d+)/)?([a-z0-9-]{1,24})(?:\.v1[02])?(\.light)?\.png$")     # S15: `<name>.v10.png` = the v10 definition (markDef)
V10_RE = re.compile(r"\.(v10|v12|alt)(\.light)?\.png$")     # `.alt` (S15c) = the alternative definition of a workspace family (shMicro art, eyeWsIris plain)
BAR_RE = re.compile(r"^(.+)/bar/(\d+)/([^/]+)$")


def split_bar(rel):
    """`system/bar/28/menu-x.png` -> (`system/menu-x.png`, 28); anything else -> (rel, 0). Only the ten buckets count."""
    m = BAR_RE.match(rel)
    if m and int(m.group(2)) in BAR_PX:
        return m.group(1) + "/" + m.group(3), int(m.group(2))
    return rel, 0


def mark_of(rel):
    """`marks/beetle.light.png` -> (`beetle`, True, 0); `marks/bar/28/beetle.png` -> (`beetle`, False, 28); else None."""
    m = MARK_RE.match(rel)
    if not m:
        return None
    px = int(m.group(1)) if m.group(1) else 0
    if m.group(1) and px not in BAR_PX:
        return None
    return m.group(2), bool(m.group(3)), px


WS_FAMILIES = ("beetle", "tomie", "uzumaki-eye", "symbols", "gothic", "pyramid", "heather", "cult")     # `pyramid`: recipe pyramid-head (the side view in the ring; `pyramid-classic` was removed 2026-10-20); `heather`: recipe ws-heather; `cult`: recipe ws-cult (drawn, no source picture)     # v11: `tomie` = both faces / her two sides (the head-crop family `tomie-head` was removed in the HD pass)
FAMILY_RE = re.compile(r"^workspaces/bar/(\d+)/ws-(" + "|".join(WS_FAMILIES) + r")-(\d{1,2}|preview)-(empty|occupied|active|urgent)(?:\.light)?\.png$")     # `preview`: the picker's numeral-free card art


GOTHIC_BAN_RE = re.compile(r"^gothic/banners/(\d+)x(\d+)/(\d{1,2})-(inactive|occupied|active)(\.light)?\.png$")     # the workspace banners were removed; the user's existing banner files stay valid (source art for the lock designs), no recipe writes them
GOTHIC_BANNERS = ((360, 64), (300, 46), (476, 88))
SH_RE = re.compile(r"^(?:hollow|sh)/(?:bar/(\d+)/)?([a-z0-9-]{1,32})(\.light)?\.png$")     # S17a: the Hollow pack, hollow/ (S24; the old sh/ files still index; procedural pieces ship in ito-art/sh/, the pieces cut from your sheets live only here)


# S18: the Relic bar icons (`relic/sys/bar/<px>/<icon>[-<state>].png`; S24: the old gothic/sys/ files still index), cut from the shell asset sheet
GOTHIC_SYS_RE = re.compile(r"^(?:relic|gothic)/sys/bar/(\d+)/([a-z]+(?:-[a-z0-9]+)?)(\.light)?\.png$")


def family_of(rel):
    """`workspaces/bar/28/ws-beetle-3-active.png` -> (`beetle`, `3`, `active`): a workspace family that ships no base picture (S2c); else None."""
    m = FAMILY_RE.match(rel)
    if not m or int(m.group(1)) not in BAR_PX or (m.group(3) != "preview" and not 1 <= int(m.group(3)) <= 10):
        return None
    return m.group(2), m.group(3), m.group(4)


# S14: the popup-head eyes made from the user's sheets. `eyes/<id>/<layer>[.light].png` is the 512-wide master, `eyes/<id>/h<H>/<layer>[.light].png` the
# tier for a box H px high (the popup head 34, the Control Centre card 54, and their x2). Layers: lid (lashes, lid, sclera: a hole where the iris is), iris (the
# disc that turns) and, for the Uzumaki eye only, hot (the iris in blood). The blood point is drawn by the shell, never baked.
EYE_IDS = ("uzumaki", "lashed", "veined")
EYE_TIERS = (34, 54, 68, 108)
EYE_AR = {"uzumaki": (1129, 589), "lashed": (178, 100), "veined": (410, 285)}      # the crop's width : height
EYE_RE = re.compile(r"^eyes/(" + "|".join(EYE_IDS) + r")/(?:h(\d+)/)?(lid|iris|hot)(\.light)?\.png$")


def eye_of(rel):
    """`eyes/uzumaki/h34/iris.light.png` -> (`uzumaki`, `iris`, True, 34); the master has H 0; anything else None."""
    m = EYE_RE.match(rel)
    if not m or (m.group(2) and int(m.group(2)) not in EYE_TIERS) or (m.group(3) == "hot" and m.group(1) != "uzumaki"):
        return None
    return m.group(1), m.group(3), bool(m.group(4)), int(m.group(2) or 0)


def eye_size(eid, H):
    """(w, h) of a product: the 512-wide master (H 0) or the tier of height H."""
    aw, ah = EYE_AR[eid]
    return (512, round(512 * ah / aw)) if H == 0 else (round(H * aw / ah), H)


def aspect_ok(slot, w, h):
    rule = SLOTS[slot][2]
    a = w / h
    if rule[0] == "ratio":
        return abs(a / rule[1] - 1.0) <= rule[2]
    if rule[0] == "range":
        return rule[1] <= a <= rule[2]
    if rule[0] == "custom":
        return abs(a / (16 / 9) - 1.0) <= 0.01 or abs(a - 1.0) <= 0.01
    return True


def out(obj, code=0):
    print(json.dumps(obj, ensure_ascii=False))
    sys.exit(code)


def walk():
    """[(rel, path)] of every .png under the assets folder, except the reserved folders; never follows links out."""
    found = []
    if not ASSETS.is_dir():
        return found
    for root, dirs, files in os.walk(ASSETS, followlinks=False):
        rel_root = Path(root).relative_to(ASSETS)
        if rel_root == Path("."):
            dirs[:] = [d for d in dirs if d not in RESERVED]
        for f in files:
            if f.lower().endswith(".png"):
                found.append(((rel_root / f).as_posix(), Path(root) / f))
    return sorted(found)


def signature(found):
    h = hashlib.sha1()
    for rel, p in found:
        try:
            st = p.stat()
            h.update(f"{rel}|{st.st_size}|{st.st_mtime_ns}\n".encode())
        except OSError:
            h.update(f"{rel}|gone\n".encode())
    h.update(str(ART).encode())
    return h.hexdigest()[:16]


def load_index():
    try:
        return json.loads(INDEX.read_text())
    except (OSError, ValueError):
        return None


def check(rel, path, deadline):
    """(entry, warnings) or raises ValueError(reason)."""
    from PIL import Image
    v10 = bool(V10_RE.search(rel))
    alt = bool(re.search(r"\.alt(\.light)?\.png$", rel))
    mk = mark_of(rel)
    rel = V10_RE.sub(lambda m: (m.group(2) or "") + ".png", rel)       # S15: a v10 file is checked like the plain one beside it
    wf = family_of(rel)
    ey = eye_of(rel)
    base, px = split_bar(rel)
    plain = base[:-10] + ".png" if base.endswith(".light.png") else base
    shipped = ART / rel
    sh = SH_RE.match(rel)
    gs = GOTHIC_SYS_RE.match(rel)
    gb = GOTHIC_BAN_RE.match(rel)
    if gb and (int(gb.group(1)), int(gb.group(2))) not in GOTHIC_BANNERS:
        raise ValueError("a gothic banner is 360x64, 300x46 or 476x88")
    if gs and int(gs.group(1)) not in BAR_PX:
        raise ValueError("not a bar-size tier")
    gg = bool(gs or gb)
    slot = None if (shipped.is_file() or mk or wf or ey or sh or gg) else slot_of(rel)
    if not shipped.is_file() and not mk and not wf and not ey and not sh and not gg and slot is None:
        # a light twin or a bar-size bucket of a shipped picture (or of a named slot) is checked against that picture
        if (px or plain != base) and (ART / plain).is_file():
            shipped = ART / plain
        elif (px or plain != base) and slot_of(plain):
            slot = slot_of(plain)
        else:
            raise ValueError("no shipped picture or named slot of that name")
    if time.time() > deadline:
        raise ValueError("skipped: the check ran out of time (20 s)")
    st = path.stat()
    if st.st_size > MAX_BYTES:
        raise ValueError("larger than 8 MB")
    with open(path, "rb") as fh:
        if fh.read(8) != b"\x89PNG\r\n\x1a\n":
            raise ValueError("not a PNG file")
    old = Image.MAX_IMAGE_PIXELS
    Image.MAX_IMAGE_PIXELS = int(MAX_PX)
    try:
        try:
            with Image.open(path) as im:
                w, h = im.size
                if w * h > MAX_PX:
                    raise ValueError("more than 16.7 megapixels")
                im.verify()
            with Image.open(path) as im:
                im.load()
                rgba = im.convert("RGBA")
        except ValueError:
            raise
        except Exception as e:
            raise ValueError(f"cannot be decoded ({type(e).__name__})")
    finally:
        Image.MAX_IMAGE_PIXELS = old
    if px and (w, h) != (px, px):
        raise ValueError(f"a bar-size picture is exactly {px}x{px} (this is {w}x{h})")
    if gb and (w, h) != (int(gb.group(1)), int(gb.group(2))):
        raise ValueError(f"a banner is exactly {gb.group(1)}x{gb.group(2)} (this is {w}x{h})")
    if ey:
        ew, eh = eye_size(ey[0], ey[3])
        if abs(w - ew) > max(1, 0.01 * ew) or abs(h - eh) > max(1, 0.015 * eh):
            raise ValueError(f"an eye picture of {ey[0]} is {ew}x{eh} here (this is {w}x{h})")
        sw, shh = ew, eh
    elif wf:
        sw = shh = px
    elif gg:
        sw, shh = w, h
    elif sh:
        if max(w, h) > MAX_SIDE:
            raise ValueError(f"too large ({w}x{h}; at most {MAX_SIDE} a side)")
        sw, shh = w, h
    elif mk:
        if not px and (abs(w / 512 - 1.0) > 0.01 or abs(h / 512 - 1.0) > 0.01):
            raise ValueError(f"a menu mark is 512x512 (within 1 %); this is {w}x{h}")
        sw = shh = px or 512
    elif px:
        sw = shh = px
    elif slot:
        sw, shh = SLOTS[slot][0], SLOTS[slot][1]
        if max(w, h) > MAX_SIDE:
            raise ValueError(f"too large ({w}x{h}; at most {MAX_SIDE} a side)")
        if w < 0.25 * sw and h < 0.25 * shh:
            raise ValueError(f"too small ({w}x{h}; the slot is {sw}x{shh})")
        if not aspect_ok(slot, w, h):
            raise ValueError(f"aspect {w}:{h} does not fit the slot {slot} ({sw}x{shh})")
    else:
        try:
            with Image.open(shipped) as shipped_im:     # not `sh`: that name is the sh/ pack regex match used below
                sw, shh = shipped_im.size
        except Exception:
            raise ValueError("the shipped picture cannot be read")
        if max(w, h) > MAX_SIDE or w > 8 * sw or h > 8 * shh:
            raise ValueError(f"too large ({w}x{h}; shipped is {sw}x{shh})")
        if w < 0.5 * sw or h < 0.5 * shh:
            raise ValueError(f"too small ({w}x{h}; shipped is {sw}x{shh})")
        if abs((w / h) / (sw / shh) - 1.0) > 0.08:
            raise ValueError(f"aspect {w}:{h} is not within 8 % of the shipped {sw}:{shh}")
    warn = []
    if w < sw or h < shh:
        warn.append(f"smaller than the shipped {sw}x{shh}")
    try:
        import numpy as np
        a = np.asarray(rgba, np.float32) / 255.0
        op = a[..., 3] > 0.5
        n = int(op.sum())
        if n:
            lum = 0.2126 * a[..., 0] + 0.7152 * a[..., 1] + 0.0722 * a[..., 2]
            if not slot and float((op & (lum < 0.15)).sum()) / n > 0.20:
                warn.append("more than 20 % of the drawing is near black: draw on a transparent ground")
            rgb = a[..., :3]
            nonred = op & ~(rgb[..., 0] > 1.3 * np.maximum(rgb[..., 1], rgb[..., 2]))
            if nonred.any() and float((rgb.max(-1) - rgb.min(-1))[nonred].mean()) > 0.15:
                warn.append("a colour picture: the theme shader flattens colour onto bone and blood")
        if a[0, 0, 3] > 0.02:
            warn.append("pixel (0,0) is not transparent (the drawn icons sample it)")
    except ImportError:
        pass
    entry = {"mtime": int(st.st_mtime * 1000), "w": w, "h": h}
    if v10:
        entry["alt" if alt else "v10"] = True
    if px:
        entry["bar"] = px
    if ey:
        entry["slot"] = f"eyes/{ey[0]}/{ey[1]}.png"        # listed under "slots": an eye is a new picture, it replaces nothing shipped
        entry["eye"] = ey[0]
        entry["light"] = ey[2]
        if ey[3]:
            entry["tier"] = ey[3]
    elif wf:
        entry["slot"] = f"workspaces/ws-{wf[0]}-{wf[1]}-{wf[2]}.png"     # a family with no shipped base: a new picture, listed under "slots"
        entry["family"] = wf[0]
    elif gs:
        entry["slot"] = rel.split("/")[0] + "/sys/" + gs.group(2) + ".png"     # relic/sys/ (S24) or the old gothic/sys/       # listed under "slots": a new picture, it replaces nothing shipped
        entry["light"] = bool(gs.group(3))
    elif gb:
        entry["slot"] = "gothic/banners/" + gb.group(3) + "-" + gb.group(4) + ".png"
        entry["light"] = bool(gb.group(5))
    elif sh:
        entry["slot"] = rel.split("/")[0] + "/" + sh.group(2) + ".png"     # hollow/ (S24) or the old sh/       # listed under "slots": the pack's own names; a shipped twin of the same path is replaced
        entry["light"] = bool(sh.group(3))
    elif mk:
        entry["slot"] = f"marks/{mk[0]}.png"       # listed under "slots": a mark is a new picture, it replaces nothing shipped
        entry["mark"] = mk[0]
        entry["light"] = mk[1]
    elif slot:
        entry["slot"] = slot
        entry["light"] = rel.endswith(".light.png")
    return entry, warn


def build():
    found = walk()
    sig = signature(found)
    files, slots, rejected, warnings = {}, {}, {}, {}
    deadline = time.time() + BUDGET
    try:
        import PIL  # noqa: F401
        have = True
    except ImportError:
        have = False
    for rel, p in found:
        if not have:
            rejected[rel] = "Pillow is missing: the pictures cannot be checked"
            continue
        try:
            entry, warn = check(rel, p, deadline)
            (slots if "slot" in entry else files)[rel] = entry
            if warn:
                warnings[rel] = warn
        except ValueError as e:
            rejected[rel] = str(e)
        except OSError as e:
            rejected[rel] = f"cannot be read ({e.__class__.__name__})"
    return {"version": 1, "root": str(ASSETS), "sig": sig, "files": files, "slots": slots, "rejected": rejected, "warnings": warnings}


def write(index):
    INDEX.parent.mkdir(parents=True, exist_ok=True)
    tmp = INDEX.with_name(INDEX.name + f".{os.getpid()}.tmp")
    tmp.write_text(json.dumps(index, indent=1, sort_keys=True) + "\n")
    os.replace(tmp, INDEX)


IN_MAX_BYTES, IN_EXT = 32 * 1024 * 1024, (".png", ".jpg", ".jpeg", ".webp")


def slot_arg(name):
    """`fetch/logo`, `fetch/logo.png` -> the registry key; anything else is refused with the list."""
    n = name.strip().lstrip("/")
    if n.startswith("eye/"):
        out({"error": "eye/ belongs to the lock screen's eye and is not an ingest slot (drop its files there by hand)"}, 1)
    n = n[:-10] + ".png" if n.endswith(".light.png") else n
    n = n if n.endswith(".png") else n + ".png"
    if n not in SLOTS:
        out({"error": f"unknown slot {name!r}; slots: " + ", ".join(sorted(SLOTS))}, 1)
    return n


def levels(img, light):
    """(alpha float [0,1], mean_chroma, notes) from a picture of ink on a flat ground: white on black, or black on white (--light).
    Black point = the 10th percentile of the border + 0.02, white point = the 99.5th percentile of the ink."""
    import numpy as np
    a = np.asarray(img.convert("RGB"), np.float32) / 255.0
    lum = 0.2126 * a[..., 0] + 0.7152 * a[..., 1] + 0.0722 * a[..., 2]
    ink = 1.0 - lum if light else lum
    h, w = ink.shape
    t = max(2, int(round(0.01 * min(h, w))))
    ring = np.concatenate([ink[:t].ravel(), ink[-t:].ravel(), ink[:, :t].ravel(), ink[:, -t:].ravel()])
    if float(ring.mean()) > 0.5:
        raise ValueError("the ground is " + ("black" if light else "white") + ": generate " +
                         ("black ink on pure white for --light" if light else "white ink on pure black (or pass --light for black ink on white)"))
    bp = float(np.percentile(ring, 10)) + 0.02
    wp = float(np.percentile(ink, 99.5))
    if wp - bp < 0.08:
        raise ValueError("no ink found: the picture is empty or the ground is not plain")
    alpha = np.clip((ink - bp) / (wp - bp), 0.0, 1.0)
    mask = alpha > 0.05
    chroma = float((a.max(-1) - a.min(-1))[mask].mean()) if mask.any() else 0.0
    return alpha, chroma, {"black_point": round(bp, 3), "white_point": round(wp, 3)}


def cmd_ingest(argv):
    import shutil
    slot = file = None
    light = False
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--as" and i + 1 < len(argv):
            slot = slot_arg(argv[i + 1])
            i += 2
        elif a == "--light":
            light = True
            i += 1
        elif not a.startswith("-") and file is None:
            file = Path(a).expanduser()
            i += 1
        else:
            out({"error": "usage: ito-assets ingest FILE --as SLOT [--light]"}, 2)
    if not file or not slot:
        out({"error": "usage: ito-assets ingest FILE --as SLOT [--light]"}, 2)
    try:
        import numpy as np
        from PIL import Image
    except ImportError:
        out({"error": "Pillow and numpy are needed to ingest a picture"}, 1)
    if file.is_symlink() or not file.is_file():
        out({"error": f"{file} is not a regular file"}, 1)
    if file.suffix.lower() not in IN_EXT:
        out({"error": "ingest takes a PNG, JPEG or WebP picture"}, 1)
    if file.stat().st_size > IN_MAX_BYTES:
        out({"error": "the picture is larger than 32 MB"}, 1)
    Image.MAX_IMAGE_PIXELS = int(MAX_PX)
    try:
        with Image.open(file) as im:
            if im.format not in ("PNG", "JPEG", "WEBP"):
                raise ValueError(f"a {im.format} file is not accepted")
            im.verify()
        with Image.open(file) as im:
            im.load()
            src = im.convert("RGBA")
    except ValueError as e:
        out({"error": f"rejected: {e}"}, 1)
    except Exception as e:
        out({"error": f"rejected: the picture cannot be decoded ({type(e).__name__})"}, 1)
    warnings = []
    arr = np.asarray(src)
    if float((arr[..., 3] < 230).mean()) > 0.01:                      # the generator did give real transparency: keep it
        alpha = arr[..., 3].astype(np.float32) / 255.0
        a = arr[..., :3].astype(np.float32) / 255.0
        chroma = float((a.max(-1) - a.min(-1))[alpha > 0.05].mean()) if (alpha > 0.05).any() else 0.0
        notes = {"alpha": "kept"}
    else:
        try:
            alpha, chroma, notes = levels(src, light)
        except ValueError as e:
            out({"error": f"rejected: {e}"}, 1)
    if chroma > 0.08:
        warnings.append(f"the picture is not monochrome (mean chroma {chroma:.2f}): colour is dropped, the shell tints it")
    h, w = alpha.shape
    alpha[:1], alpha[-1:], alpha[:, :1], alpha[:, -1:] = 0, 0, 0, 0       # nothing touches the edge: corners are transparent
    rgb = np.full((h, w, 3), 0 if light else 255, np.uint8)
    res = Image.fromarray(np.dstack([rgb, np.round(alpha * 255).astype(np.uint8)]), "RGBA")
    if max(w, h) > MAX_SIDE:
        k = MAX_SIDE / max(w, h)
        res = res.resize((max(1, round(w * k)), max(1, round(h * k))), Image.LANCZOS)
        warnings.append(f"scaled down from {w}x{h}")
    w, h = res.size
    if not aspect_ok(slot, w, h):
        out({"error": f"rejected: {w}:{h} does not fit the slot {slot} (canvas {SLOTS[slot][0]}x{SLOTS[slot][1]}, aspect within 1 %)"}, 1)
    dest = ASSETS / (slot[:-4] + ".light.png" if light else slot)
    dest.parent.mkdir(parents=True, exist_ok=True)
    tmp = dest.with_name(dest.name + f".{os.getpid()}.tmp")
    for _try in range(6):
        res.save(tmp, format="PNG", optimize=True)
        if tmp.stat().st_size <= MAX_BYTES:
            break
        res = res.resize((int(res.width * 0.85), int(res.height * 0.85)), Image.LANCZOS)
        warnings.append("scaled down to fit 8 MB")
    else:
        tmp.unlink(missing_ok=True)
        out({"error": "rejected: the result is larger than 8 MB even scaled down"}, 1)
    os.replace(tmp, dest)
    keep = ASSETS / "_sources" / (dest.relative_to(ASSETS).as_posix().replace("/", "__")[:-4] + file.suffix.lower())
    keep.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(file, keep)
    idx = build()
    write(idx)
    rel = dest.relative_to(ASSETS).as_posix()
    listed = rel in idx["slots"]
    out({"ok": listed, "slot": slot, "file": str(dest), "size": list(res.size), "source": str(keep), "levels": notes,
         "warnings": warnings, "indexed": listed, **({} if listed else {"rejected": idx["rejected"].get(rel)})}, 0 if listed else 1)


# ---- A1d: recipes (decisions-userart section 1 and 6) ---------------------------------------------------------
# A recipe turns ONE picture of the user's into theme-ready art: neutral ink (R=G=B=200) + alpha, never an opaque dark ground.
# The pixels go to ~/.config/ito/assets (never into a repo); the recipe is just code and numbers.
INK = 200
RECIPES = {
    "lightink": "white ink on black (a light drawing on a dark ground): alpha = the levels of the luminance; one file for both themes",
    "lineart": "black ink on white paper: <rel> = paper polarity (the paper inside the figure is ink, for dark themes) and "
               "<rel>.light = ink polarity (for light themes); the bar-size files are ink polarity, grown so thin lines survive",
}
GATE = {"crisp": 0.45, "fill": 0.55, "black": 0.05}      # decisions-barsize section 3 (crisp >=, fill <=, black <=)
RECIPE_USAGE = ("usage: ito-assets recipe --list | recipe lightink|lineart FILE --as REL [--crop x0,y0,x1,y1] [--erase x0,y0,x1,y1] "
                "[--size N|WxH] [--seal N] [--bar] [--dry-run]")


def _box(text):
    try:
        v = [int(x) for x in text.split(",")]
    except ValueError:
        v = []
    if len(v) != 4 or v[2] <= v[0] or v[3] <= v[1]:
        out({"error": f"bad box {text!r}: x0,y0,x1,y1 in pixels"}, 2)
    return tuple(v)


def _lum(im):
    import numpy as np
    a = np.asarray(im.convert("RGB"), np.float32) / 255.0
    return 0.2126 * a[..., 0] + 0.7152 * a[..., 1] + 0.0722 * a[..., 2]


def _outside(L, seal):
    """the paper outside the figure: flood from the border over light pixels after sealing the contour by `seal` px."""
    import numpy as np
    from PIL import Image, ImageDraw, ImageFilter
    dark = Image.fromarray(((L < 0.62) * 255).astype(np.uint8)).filter(ImageFilter.MaxFilter(2 * seal + 1))
    img = Image.fromarray(np.pad(np.where(np.asarray(dark) == 0, 255, 0).astype(np.uint8), 1, constant_values=255)).copy()
    ImageDraw.floodfill(img, (0, 0), 128)
    o = Image.fromarray(((np.asarray(img)[1:-1, 1:-1] == 128) * 255).astype(np.uint8)).filter(ImageFilter.MaxFilter(max(1, 2 * seal - 1)))
    return np.asarray(o) > 0


def _rgba(alpha):
    import numpy as np
    from PIL import Image
    h, w = alpha.shape
    o = np.zeros((h, w, 4), np.uint8)
    o[..., :3] = INK
    o[..., 3] = np.round(np.clip(alpha, 0, 1) * 255)
    o[:1, :, 3] = o[-1:, :, 3] = 0                      # nothing touches the edge: the corners are transparent
    o[:, :1, 3] = o[:, -1:, 3] = 0
    return Image.fromarray(o, "RGBA")


def _down(img, size):
    import numpy as np
    from PIL import Image
    r = np.array(img.convert("RGBa").resize(size, Image.LANCZOS).convert("RGBA"))      # premultiplied: no dark fringe
    r[..., :3] = INK                                                                    # the ink stays exactly neutral
    return Image.fromarray(r, "RGBA")


def _metrics(img):
    import numpy as np
    arr = np.asarray(img, np.float32) / 255.0
    a, rgb = arr[..., 3], arr[..., :3]
    mx = float(a.max()) or 1.0
    crisp = float((a >= 0.6 * mx).sum()) / max(1, int((a >= 0.15 * mx).sum()))
    h, w = a.shape
    yy, xx = np.mgrid[0:h, 0:w]
    disc = np.hypot(xx - (w - 1) / 2, yy - (h - 1) / 2) <= min(w, h) / 2
    fill = float(((a >= 0.5) & disc).sum()) / max(1, int(disc.sum()))
    black = float(((a > 0.85) & (rgb.mean(-1) < 0.15)).sum()) / max(1, int((a > 0.15).sum()))
    return {"crisp": round(crisp, 2), "fill": round(fill, 2), "black": round(black, 2)}


def _target(rel):
    """(w, h) the product has by default, or exit: a recipe only writes where the shell would read it."""
    if rel.endswith(".light.png") or not rel.endswith(".png") or rel.startswith(("eye/", "_sources/")) or ".." in rel:
        out({"error": f"{rel!r} is not a plain target path (<dir>/<name>.png; the .light twin and bar files are made for you)"}, 2)
    if mark_of(rel) and mark_of(rel)[1:] == (False, 0):
        return (512, 512)
    if (ART / rel).is_file():
        from PIL import Image
        with Image.open(ART / rel) as sh:
            return sh.size
    if slot_of(rel):
        return (SLOTS[rel][0], SLOTS[rel][1])
    out({"error": f"{rel!r} is neither a shipped picture, a named slot nor marks/<name>.png"}, 2)


def make_recipe(kind, src, rel, crop=None, erase=None, size=None, seal=4, bar=False):
    """[(rel, PIL RGBA)] and a list of notes for one source picture. Pure (no files)."""
    import numpy as np
    from PIL import Image, ImageFilter
    ground = 0.0 if kind == "lightink" else 1.0
    L = _lum(src)
    notes = []
    if erase:
        L[erase[1]:erase[3], erase[0]:erase[2]] = ground
    if crop:
        if crop[2] > L.shape[1] or crop[3] > L.shape[0] or min(crop[:2]) < 0:
            raise ValueError(f"the crop {crop} is outside the {L.shape[1]}x{L.shape[0]} picture")
        L = L[crop[1]:crop[3], crop[0]:crop[2]]
    tw, th = size or _target(rel)
    if abs(tw / th - 1.0) <= 0.01 and L.shape[0] != L.shape[1]:        # a square product: centre the crop on a square canvas
        side = max(L.shape) + 16
        sq = np.full((side, side), ground, np.float32)
        y0, x0 = (side - L.shape[0]) // 2, (side - L.shape[1]) // 2
        sq[y0:y0 + L.shape[0], x0:x0 + L.shape[1]] = L
        L = sq
    elif abs((L.shape[1] / L.shape[0]) / (tw / th) - 1.0) > 0.01:
        raise ValueError(f"the picture is {L.shape[1]}:{L.shape[0]}, the target {rel} is {tw}:{th}: crop it to that shape (--crop)")
    L8 = Image.fromarray(np.round(L * 255).astype(np.uint8))
    products = []
    if kind == "lightink":
        alpha, chroma, lv = levels(L8, False)
        notes.append(f"levels {lv}")
        products.append((rel, _down(_rgba(alpha), (tw, th))))
    else:
        paper = np.clip((L - 0.35) / 0.55, 0, 1)
        paper[_outside(L, seal)] = 0
        ink = np.clip((0.78 - L) / 0.60, 0, 1)
        products.append((rel, _down(_rgba(paper), (tw, th))))
        products.append((rel[:-4] + ".light.png", _down(_rgba(ink), (tw, th))))
    if bar:
        if tw != th:
            raise ValueError("bar-size files are square: the target is not")
        d, f = rel.rsplit("/", 1) if "/" in rel else ("", rel)
        for px in LEGACY_BAR_PX:
            if kind == "lightink":
                bimg = _down(_rgba(alpha), (px, px))
            else:
                l4 = np.asarray(L8.resize((4 * px, 4 * px), Image.LANCZOS).filter(ImageFilter.MinFilter(5)), np.float32) / 255
                bimg = _down(_rgba(np.clip((0.70 - l4) / 0.30, 0, 1)), (px, px))
            products.append(((d + "/" if d else "") + f"bar/{px}/{f}", bimg))
    return products, notes


def cmd_recipe(argv):
    import shutil, tempfile
    if argv[:1] == ["--list"]:
        out({"ok": True, "recipes": {**RECIPES, **PHOTO_RECIPES}, "gate": GATE, "photo_gate": TONAL})
    if len(argv) < 1 or argv[0] not in RECIPES:
        out({"error": RECIPE_USAGE}, 2)
    kind, file, rel, crop, erase, size, seal, bar, dry = argv[0], None, None, None, None, None, 4, False, False
    i = 1
    while i < len(argv):
        a = argv[i]
        if a == "--as" and i + 1 < len(argv):
            rel, i = argv[i + 1].strip().lstrip("/"), i + 2
            rel = rel if rel.endswith(".png") else rel + ".png"
        elif a == "--crop" and i + 1 < len(argv):
            crop, i = _box(argv[i + 1]), i + 2
        elif a == "--erase" and i + 1 < len(argv):
            erase, i = _box(argv[i + 1]), i + 2
        elif a == "--size" and i + 1 < len(argv):
            m = re.fullmatch(r"(\d{1,4})(?:x(\d{1,4}))?", argv[i + 1])
            if not m:
                out({"error": RECIPE_USAGE}, 2)
            size, i = (int(m.group(1)), int(m.group(2) or m.group(1))), i + 2
        elif a == "--seal" and i + 1 < len(argv) and argv[i + 1].isdigit():
            seal, i = max(1, min(12, int(argv[i + 1]))), i + 2
        elif a == "--bar":
            bar, i = True, i + 1
        elif a == "--dry-run":
            dry, i = True, i + 1
        elif not a.startswith("-") and file is None:
            file, i = Path(a).expanduser(), i + 1
        else:
            out({"error": RECIPE_USAGE}, 2)
    if not file or not rel:
        out({"error": RECIPE_USAGE}, 2)
    repo = ART.resolve().parents[2]
    if not dry and (ASSETS.resolve() == repo or repo in ASSETS.resolve().parents):
        out({"error": f"refused: {ASSETS} is inside {repo}; user pictures never go into a repo"}, 1)
    try:
        import numpy  # noqa: F401
        from PIL import Image
    except ImportError:
        out({"error": "Pillow and numpy are needed for a recipe"}, 1)
    if file.is_symlink() or not file.is_file() or file.suffix.lower() not in IN_EXT or file.stat().st_size > IN_MAX_BYTES:
        out({"error": f"{file} is not a regular PNG/JPEG/WebP file of at most 32 MB"}, 1)
    Image.MAX_IMAGE_PIXELS = int(MAX_PX)
    try:
        with Image.open(file) as im:
            im.load()
            src = im.convert("RGBA") if im.mode in ("RGBA", "LA", "P") else im.convert("RGB")
        if src.mode == "RGBA":                                  # flatten any transparency onto the kind's ground
            bg = Image.new("RGBA", src.size, (0, 0, 0, 255) if kind == "lightink" else (255, 255, 255, 255))
            src = Image.alpha_composite(bg, src).convert("RGB")
        products, notes = make_recipe(kind, src, rel, crop, erase, size, seal, bar)
    except ValueError as e:
        out({"error": f"rejected: {e}"}, 1)
    except Exception as e:
        out({"error": f"rejected: the picture cannot be read ({type(e).__name__})"}, 1)
    root = Path(tempfile.mkdtemp(prefix="ito-recipe-")) if dry else ASSETS
    report, written, refused = [], [], []
    try:
        for prel, img in products:
            m = _metrics(img)
            is_bar = split_bar(prel)[1] > 0
            ok = m["black"] <= GATE["black"] and (not is_bar or (m["crisp"] >= GATE["crisp"] and m["fill"] <= GATE["fill"]))
            report.append({"file": prel, "gate": "pass" if ok else "FAIL", **m})
            if not ok:
                refused.append(prel)                              # a failing bar file is not offered (it may still be used >= 48 px)
                continue
            dest = root / prel
            dest.parent.mkdir(parents=True, exist_ok=True)
            tmp = dest.with_name(dest.name + f".{os.getpid()}.tmp")
            img.save(tmp, format="PNG", optimize=True)
            os.replace(tmp, dest)
            written.append(prel)
        rejected = {}
        if dry:
            deadline = time.time() + BUDGET
            for prel in written:
                try:
                    check(prel, root / prel, deadline)
                except ValueError as e:
                    rejected[prel] = str(e)
        elif kind != "spiral":
            keep = ASSETS / "_sources" / (rel.replace("/", "__")[:-4] + file.suffix.lower())
            keep.parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(file, keep)
            idx = build()
            write(idx)
            rejected = {p: idx["rejected"][p] for p in written if p in idx["rejected"]}
    finally:
        if dry:
            shutil.rmtree(root, ignore_errors=True)
    out({"ok": not rejected and bool(written), "recipe": kind, "dry_run": dry, "target": str(ASSETS / rel), "written": [] if dry else written,
         "would_write": written if dry else [], "not_offered": refused, "rejected": rejected, "gate": report, "notes": notes},
        0 if written and not rejected else 1)


# ---- S2c: photo recipes (tomie, uzumaki-eye, beetle, ws-beetle) ---------------------------------------------------
# Ports of the lab generators (tomie.py, uzeye.py, beetle.py): the user's own picture is cropped, levelled and cut at every tier, never
# redrawn. Colour = neutral ink (200) + the one blood accent the picture itself carries (200,16,20). The pixels go under the assets folder.
RECIPE_ALIASES = {"gothic-sys": "relic-sys", "ws-gothic": "ws-symbols", "gothic-apps": "relic-apps", "sh-pack": "hollow-pack"}
PHOTO_RECIPES = {
    "tomie": "your Tommie drawing (565x933) or your HD Tomie panel (1500x2000, only the inside of its frame is read): the die-cut head sticker at every tier; mole = blood",
    "uzumaki-eye": "your spiral-eye engraving (1672x941): the whole eye at every tier; the spiral's centre = blood",
    "beetle": "your beetle (920x920): ink polarity on every theme; the abdomen eye = blood",
    "ws-beetle": "workspace family: the beetle over a Mayan dot-and-bar numeral (dot 1, bar 5), 10 numbers x 4 states (+ the sharper v10 files, key wsBeetleDef)",
    "ws-tomie": "workspace family from your Tommie drawing (565x933) or HD Tomie panel (1500x2000): her eye + mole + a numeral; the second face in a circle when active, in blood when urgent",
    "ws-uzumaki-eye": "workspace family from your bleeding-eye.png (105 px: native up to 96, 112/128 are a gentle upscale): the eye bleeds on the active one; the iris is your spiral engraving's when `_sources/uzumaki-eye__*` (1672x941) or --iris has it",
    "mark-heather": "menu mark Heather from your Heather / Pyramid roundel sheet (1536x1024): a sigil (broken ring, blood ticks, her glyph) at 24-32, her portrait from 36",
    "mark-pyramid": "menu mark Pyramid from your Heather / Pyramid roundel sheet (1536x1024): a sigil (broken ring, blood ticks, a blood triangle) at 24-32, the helmet from 36",
    "hollow-pack": "the Hollow asset pack (S17a, old recipe name sh-pack) from your fog-town sheet (1536x1024) + your Heather / Pyramid sheet (`--hp`): hollow/<asset>[.light].png + hollow/bar/<px>/ (radio, sign, lamp, fog, streaks, roundel) and the procedural pieces redistressed with YOUR grain (sh/grain.png)",
