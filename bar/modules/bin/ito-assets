             "eye-uzumaki": (1672, 941), "eye-lashed": (680, 680), "eye-veined": (1199, 596), "sprites": (1920, 1080), "ws-cult": None, "pyramid-head": (1254, 1254), "ws-heather": (1536, 1024)}
CRISP_REPORT = ("beetle", "tomie", "ws-tomie", "ws-uzumaki-eye", "mark-pyramid", "mark-heather", "hollow-pack", "relic-sys", "ws-symbols", "sprites", "pyramid-head", "ws-heather")     # tonal art: `crisp` (share of full-strength pixels) is reported, not gated
TONAL = {"crisp": 0.30, "fill": 0.80, "black": 0.05}     # the photo class of the S2c gate (line art keeps GATE)
PHOTO_STATES = ("empty", "occupied", "active", "urgent")
SERIF_BOLD = "/usr/share/fonts/noto/NotoSerif-Bold.ttf"


def _p_area(m, W, H=None):
    import numpy as np
    from PIL import Image
    H = H or W
    return np.asarray(Image.fromarray((np.clip(m, 0, 1) * 65535).astype(np.uint16).astype(np.int32), "I")
                      .resize((W, H), Image.BOX), np.float32) / 65535


def _p_curve(a, lo, hi):
    import numpy as np
    t = np.clip((a - lo) / max(1e-3, hi - lo), 0, 1)
    return t * t * (3 - 2 * t)


def _p_rgba(ink, blood):
    """ink + blood coverage -> RGBA (ink 200 grey, blood 200/16/20), the recipe convention."""
    import numpy as np
    from PIL import Image
    blood = np.clip(blood, 0, 1)
    a = np.clip(ink, 0, 1) * (1 - blood)
    h, w = a.shape
    o = np.zeros((h, w, 4), np.float32)
    al = np.clip(a + blood, 0, 1)
    o[..., 3] = al
    with np.errstate(invalid="ignore", divide="ignore"):
        fb = np.where(al > 0, blood / np.maximum(al, 1e-6), 0)
    o[..., 0] = (INK * (1 - fb) + 200 * fb) / 255
    o[..., 1] = (INK * (1 - fb) + 16 * fb) / 255
    o[..., 2] = (INK * (1 - fb) + 20 * fb) / 255
    return Image.fromarray((np.clip(o, 0, 1) * 255).astype(np.uint8), "RGBA")


def _p_figure(L, seal=4, thr=0.6):
    """the inside of a black-on-white drawing: whatever the border cannot reach through paper."""
    import numpy as np
    from PIL import Image, ImageDraw, ImageFilter
    dark = (L < thr).astype(np.uint8) * 255
    sealed = np.asarray(Image.fromarray(dark).filter(ImageFilter.MaxFilter(2 * seal + 1)))
    paper = np.where(sealed > 0, 0, 255).astype(np.uint8)
    img = Image.fromarray(np.pad(paper, 2, constant_values=255)).copy()
    ImageDraw.floodfill(img, (0, 0), 128, thresh=0)
    outside = np.asarray(img)[2:-2, 2:-2] == 128
    o = np.asarray(Image.fromarray((outside * 255).astype(np.uint8)).filter(ImageFilter.MaxFilter(2 * seal - 1))) > 0
    return ~o


class _Tomie:
    MOLE = (371, 323, 4.5)
    CROPS = {"head": (55, 0, 430), "face": (150, 92, 272), "eye": (262, 168, 184)}   # S2c fix: the head (hair + both faces) at EVERY tier
    PAPER_DARK = 0.85

    def __init__(self, im):
        self.L = _lum(im)
        self.FIG = _p_figure(self.L, 3, 0.6)

    def coverage(self, crop, light, px):
        import numpy as np
        x, y, s = self.CROPS[crop]
        m = self.MOLE
        mr = max(m[2], 0.9 * s / px)                    # the mole stays >= 1.8 px wide at the target
        l = self.L[y:y + s, x:x + s]
        f = self.FIG[y:y + s, x:x + s]
        yy, xx = np.mgrid[0:s, 0:s] + np.array([y, x])[:, None, None]
        mole = np.clip(mr + 0.5 - np.hypot(xx - m[0], yy - m[1]), 0, 1) * ((l < 0.5) | (mr > m[2]))
        ink = np.clip((0.80 - l) / 0.6, 0, 1) * f if light else np.clip((l - 0.30) / 0.55, 0, 1) * f
        return ink * (1 - mole), mole

    def crop_for(self, px):
        return "head"

    def mark(self, px, light=False):
        import numpy as np
        from PIL import Image
        crop = self.crop_for(px)
        ink, blood = self.coverage(crop, light, px)
        s = ink.shape[0]
        yy, xx = np.mgrid[0:s, 0:s]
        d = np.hypot(xx - (s - 1) / 2, yy - (s - 1) / 2)
        edge = np.clip((s / 2 - d) / (s / px), 0, 1)
        if crop == "head":                                # the head keeps its own silhouette; only the bottom fades out
            edge = np.clip((s - 1 - yy) / (0.10 * s), 0, 1)
        a, b = _p_area(ink * edge, px), _p_area(blood * edge, px)
        if px < 40:                                       # threshold-at-size: tones resolve to paper or ink
            a, b = _p_curve(a, 0.22, 0.70), _p_curve(b, 0.15, 0.6)
        elif px < 128:
            a = _p_curve(a, 0.10, 0.85)
        im = _p_rgba(a, b)
        if light:
            return im
        arr = np.asarray(im).copy()                       # dark themes: the paper at 72 % of the bone token (no glare), blood untouched
        red = arr[..., 0].astype(int) - arr[..., 1] > 60
        arr[..., :3] = np.where(red[..., None], arr[..., :3], (arr[..., :3] * self.PAPER_DARK).astype(np.uint8))
        return Image.fromarray(arr, "RGBA")


class _UzEye:
    CORE = (850.0, 482.0, 16.0)

    def __init__(self, im):
        import numpy as np
        from PIL import Image, ImageFilter
        self.L = _lum(im)
        m = Image.fromarray(((self.L > 0.10) * 255).astype(np.uint8)).filter(ImageFilter.MaxFilter(15)).filter(ImageFilter.MinFilter(9)).filter(ImageFilter.GaussianBlur(3))
        self.EYEMASK = np.asarray(m, np.float32) / 255
        self.LV = np.clip((self.L - 0.06) / 0.80, 0, 1)
        H, W = self.L.shape
        self.YY, self.XX = np.mgrid[0:H, 0:W]

    def mark(self, px, light=False):
        import numpy as np
        cx, cy, side = 836.0, 462.0, 900.0     # tight on the eye (bbox 231-1417 x 139-785): it fills the tile, outer lash tips run off
        x0, y0 = cx - side / 2, cy - side / 2
        box = (int(round(x0)), int(round(y0)), int(round(x0 + side)), int(round(y0 + side)))
        k = side / px
        pad = lambda m: np.pad(m, 1200)[box[1] + 1200:box[3] + 1200, box[0] + 1200:box[2] + 1200]
        core_r = max(self.CORE[2], 0.85 * k)               # the blood core stays >= 1.7 px wide at the target
        core = np.clip(core_r + 0.5 - np.hypot(self.XX - self.CORE[0], self.YY - self.CORE[1]), 0, 1)
        ink = (1 - self.LV) * 0.92 * self.EYEMASK if light else self.LV * self.EYEMASK
        ink = ink * (1 - core)
        a, b = _p_area(pad(ink), px), _p_area(pad(core), px)
        if px < 40:
            a = _p_curve(a, 0.18, 0.75)
        elif px < 128:
            a = _p_curve(a, 0.08, 0.90)
        return _p_rgba(a, _p_curve(b, 0.12, 0.55))


class _Beetle:
    SEAL = (698, 212, 756, 298)
    IRIS = (459, 549, 8.5, 17.5)
    BBOX = (29, 148, 890, 771)
    CX = 459.5
    WING_TONE = 0.42

    def __init__(self, im):
        import numpy as np
        from PIL import ImageDraw
        im = im.copy()
        ImageDraw.Draw(im).rectangle(self.SEAL, fill=(255, 255, 255))
        L = _lum(im)
        self.FIG = _p_figure(L, 4, 0.6)
        ink = np.clip((0.80 - L) / 0.6, 0, 1) * self.FIG
        yy, xx = np.mgrid[0:920, 0:920]
        self.rr = np.hypot(xx - self.IRIS[0], yy - self.IRIS[1])
        self.BLOOD = ink * (self.rr >= self.IRIS[2] - 1) * (self.rr <= self.IRIS[3] + 1)
        self.INK = ink * (1 - self.BLOOD)

    def _edge(self, kk):
        from PIL import Image, ImageFilter
        import numpy as np
        r = max(1, int(round(0.5 * kk)))
        cache = self.__dict__.setdefault("_edges", {})
        if r in cache:
            return cache[r]
        fig = (self.FIG * 255).astype(np.uint8)
        er = np.asarray(Image.fromarray(fig).filter(ImageFilter.MinFilter(2 * r + 1)))
        cache[r] = (fig.astype(np.float32) - er) / 255
        return cache[r]

    def parts(self, px, light, h_px=None):
        key = (px, light, h_px)
        memo = self.__dict__.setdefault("_pmemo", {})
        if key not in memo:
            memo[key] = self._parts(px, light, h_px)
        return memo[key]

    def _parts(self, px, light, h_px=None):
        """v9 (lab/v9/beetle9.py): dark = the drawing's PAPER is bone (wings bone with dark veins), its black body is ink, a bone outline
        closes the silhouette; light = the drawing's ink is the ink token, wings a faint film + outline. Tones resolve to two levels."""
        import numpy as np
        over = 1.15 if px < 40 else 1.08 if px < 64 else 1.0
        B = self.BBOX
        W, H = B[2] - B[0], B[3] - B[1]
        h_px = h_px or px
        k = min((px - 1.0) * over / W, (h_px - 1.0) / H)
        sw, sh = px / k, h_px / k
        cy = (B[1] + B[3]) / 2
        w, h = int(round(sw)), int(round(sh))
        x0, y0 = int(round(self.CX - w / 2)), int(round(cy - h / 2))
        b = (x0, y0, x0 + w, y0 + h)
        pad_img = lambda m: np.pad(m, 1000)[b[1] + 1000:b[3] + 1000, b[0] + 1000:b[2] + 1000]
        kk = 1 / k
        edge = self._edge(kk)
        paper = self.FIG.astype(np.float32) * (1 - np.clip(self.INK + self.BLOOD, 0, 1))
        eye = np.clip((max(self.IRIS[3], 0.95 * kk) if px < 40 else self.IRIS[3]) + 0.5 - self.rr, 0, 1) if px < 40 else self.BLOOD
        A_ink, A_pap, A_edge, A_fig, A_eye = (_p_area(pad_img(m), px, h_px) for m in (self.INK, paper, edge, self.FIG.astype(np.float32), eye))
        lo, hi = (0.25, 0.60) if px < 40 else (0.12, 0.75) if px < 128 else (0.0, 1.0)
        cv = (lambda a: _p_curve(a, lo, hi)) if px < 128 else (lambda a: a)
        if not light:
            a = np.maximum(cv(A_pap), _p_curve(A_edge, 0.2, 0.55) if px < 128 else A_edge)
        else:
            a = np.maximum(cv(A_ink), _p_curve(A_edge, 0.2, 0.55) if px < 128 else A_edge)
            if px < 128:
                a = np.maximum(a, 0.22 * _p_curve(A_fig, 0.3, 0.7))
        return a, (_p_curve(A_eye, 0.10, 0.55) if px < 128 else A_eye)

    def mark(self, px, light=False):
        a, eye = self.parts(px, light)
        return _p_rgba(a, eye)

    # the workspace family: the beetle in the top strip, a Mayan numeral under it (dot = 1, bar = 5), whole device px
    @staticmethod
    def layout(px):
        d = max(2, int(round(px * 0.075)))            # dot / bar thickness: 2 @24-32, 3 @40-48, 4 @56+
        g = 1 if px < 48 else 2
        return d, g, 2 * d + g + 1

    def mayan(self, n, px):
        import numpy as np
        from PIL import Image, ImageDraw
        if _numeral_off():
            return np.zeros((px, px), np.float32)
        d, g, nz = self.layout(px)
        SS = 8
        m = Image.new("L", (px * SS, px * SS), 0)
        dr = ImageDraw.Draw(m)
        bars, dots = (2, 0) if n == 10 else (n // 5, n % 5)
        span = 4 * d + 3 * g
        x0 = (px - span) // 2
        rows = ["bar"] * bars + (["dots"] if dots else [])
        y = px - d
        for r in rows:                                # the bottom row first: the dots ride on the bars
            if r == "bar":
                dr.rectangle((x0 * SS, y * SS, (x0 + span) * SS - 1, (y + d) * SS - 1), fill=255)
            else:
                w = dots * d + (dots - 1) * g
                xs = (px - w) // 2
                for i in range(dots):
                    xx = xs + i * (d + g)
                    if px < 40:
                        dr.rectangle((xx * SS, y * SS, (xx + d) * SS - 1, (y + d) * SS - 1), fill=255)
                    else:
                        dr.ellipse((xx * SS, y * SS, (xx + d) * SS - 1, (y + d) * SS - 1), fill=255)
            y -= d + g
        return np.asarray(m.resize((px, px), Image.BOX), np.float32) / 255

    def ws(self, n, state, px, light=False):
        import numpy as np
        d, g, nz = self.layout(px)
        bh = px - nz
        a, eye = self.parts(px, light, h_px=bh)
        A = np.zeros((px, px), np.float32)
        E = np.zeros_like(A)
        A[:bh], E[:bh] = a, eye
        N = self.mayan(n, px)
        z = np.zeros_like(A)
        if state == "empty":
            ink, blood = np.maximum(np.maximum(A, E) * 0.55, N * 0.7), z
        elif state == "occupied":
            ink, blood = np.maximum(np.maximum(A, E), N), z
        elif state == "active":
            ink, blood = A, np.maximum(E, N)
        else:
            ink, blood = z, np.maximum(np.maximum(A, E), N)
        return _p_rgba(ink, blood)


# ---- S14: the eye recipes (ports of lab/v9/s14/eyes14.py and lab/v4/eyes5.py) ---------------------------------------------------------
# crop box in source px, the iris (centre x, y, radius) and its feather, the almond mask (cx, cy, rx, ry in crop px) of the cluster
_EYE_GEO = {
    "uzumaki": dict(box=(255, 160, 1384, 749), iris=(848, 492, 195), feather=6),
    "lashed": dict(box=(22, 392, 200, 492), iris=(112, 440, 26), feather=2),
    "veined": dict(box=(150, 205, 560, 490), iris=(353, 348, 30), feather=2, mask=(198, 140, 200, 128)),
}


def _eye_alpha(eid, L, light):
    """(alpha 0..1 over the crop, the iris disc mask 0..1) for the polarity (light = ink polarity, for light themes)."""
    import numpy as np
    from PIL import Image, ImageDraw, ImageFilter
    g = _EYE_GEO[eid]
    x0, y0, x1, y1 = g["box"]
    crop = L[y0:y1, x0:x1].copy()
    h, w = crop.shape
    yy, xx = np.mgrid[0:h, 0:w]
    ix, iy, ir = g["iris"][0] - x0, g["iris"][1] - y0, g["iris"][2]
    if eid == "uzumaki":
        if light:       # ink polarity inside the eye's own silhouette (lashes included)
            fig = np.asarray(Image.fromarray((crop * 255).astype(np.uint8)).filter(ImageFilter.GaussianBlur(6)), np.float32) / 255 > 0.10
            fig = np.asarray(Image.fromarray((fig * 255).astype(np.uint8)).filter(ImageFilter.MinFilter(9)), np.float32) / 255
            a = np.clip((0.62 - crop) / 0.50, 0, 1) * fig
        else:
            a = np.clip((crop - 0.06) / 0.86, 0, 1)
    else:
        if light:
            a = np.clip((0.80 - crop) / 0.6, 0, 1)
        else:           # the paper reachable from the crop's border is ground, not eye
            a = np.clip((crop - 0.30) / 0.6, 0, 1)
            dark = (crop < 0.6).astype(np.uint8) * 255
            sealed = np.asarray(Image.fromarray(dark).filter(ImageFilter.MaxFilter(5)))
            img = Image.fromarray(np.pad(np.where(sealed > 0, 0, 255).astype(np.uint8), 2, constant_values=255)).copy()
            ImageDraw.floodfill(img, (0, 0), 128)
            out_ = np.asarray(img)[2:-2, 2:-2] == 128
            out_ = np.asarray(Image.fromarray((out_ * 255).astype(np.uint8)).filter(ImageFilter.MaxFilter(3))) > 0
            a[out_] = 0
        if "mask" in g:
            mx, my, rx, ry = g["mask"]
            q = np.sqrt(((xx - mx) / rx) ** 2 + ((yy - my) / ry) ** 2)
            a = a * np.clip((1.0 - q) / 0.06, 0, 1)
    disc = np.clip((ir - np.hypot(xx - ix, yy - iy)) / g["feather"], 0, 1)
    return a, disc


def make_eye(eid, src):
    """[(rel, PIL RGBA)] of one eye recipe: lid, iris (and hot for the Uzumaki eye), both polarities, the master and every tier. Pure."""
    import numpy as np
    from PIL import Image
    L = _lum(src)
    outl = []
    for light in (False, True):
        a, disc = _eye_alpha(eid, L, light)
        layers = {"lid": a * (1 - disc), "iris": a * disc}
        if eid == "uzumaki":    # the spiral runs blood (the hot state): the iris, a little inside its rim; dark polarity a touch quieter
            h, w = a.shape
            yy, xx = np.mgrid[0:h, 0:w]
            ix, iy, ir = _EYE_GEO[eid]["iris"][0] - _EYE_GEO[eid]["box"][0], _EYE_GEO[eid]["iris"][1] - _EYE_GEO[eid]["box"][1], _EYE_GEO[eid]["iris"][2]
            layers["hot"] = a * np.clip((ir - 8 - np.hypot(xx - ix, yy - iy)) / 10, 0, 1) * (1.0 if light else 0.85)
        for name, m in layers.items():
            for H in (0,) + EYE_TIERS:
                W, Hh = eye_size(eid, H)
                small = _p_area(m, W, Hh)
                rel = f"eyes/{eid}/" + (f"h{H}/" if H else "") + name + (".light" if light else "") + ".png"
                outl.append((rel, _p_rgba(small * 0 if name == "hot" else small, small if name == "hot" else small * 0)))
    return outl


# ---- S15a: the v10 DEFINITION pipeline (lab/v10/def10.py ported; markDef v10). Real art only: crop, tone, local contrast, resample, clean-up. ----
# Per mark: 1 local contrast at source scale (an unsharp mask whose radius is ONE target px), 2 tone curve, 3 area (BOX) resample, 4 target sharpen,
# 5 threshold-at-size, 6 clean-up of islands / pinholes, 7 optical fill. The blood accent keeps its floor (>= 1.8 px) and is never sharpened.
# The files are written as `<name>.v10{,.light}.png` beside the v9 ones; the shell picks them with `markDef v10` (default v9 = today's files).
def _d_gblur(m, sig):
    import numpy as np
    if sig <= 0.05:
        return m.astype(np.float32)
    r = max(1, int(3 * sig + 0.5)); x = np.arange(-r, r + 1); k = np.exp(-x * x / (2 * sig * sig)); k /= k.sum()
    p = np.pad(m.astype(np.float32), r, mode="reflect")
    h = sum(k[i] * p[:, i:i + p.shape[1] - 2 * r] for i in range(2 * r + 1))
    return sum(k[i] * h[i:i + h.shape[0] - 2 * r, :] for i in range(2 * r + 1))


def _d_usm(m, sig, amt):
    return m + amt * (m - _d_gblur(m, sig))


def _d_cleanup(a, thr_island=0.55):
    import numpy as np
    h, w = a.shape; p = np.pad(a, 1)
    nb = np.stack([p[1 + dy:h + 1 + dy, 1 + dx:w + 1 + dx] for dy in (-1, 0, 1) for dx in (-1, 0, 1) if (dy, dx) != (0, 0)])
    on = nb > 0.35
    iso = (a > 0) & (on.sum(0) == 0) & (a < thr_island)
    a = np.where(iso, 0, a)
    pin = (a < 0.35) & ((nb > 0.7).sum(0) >= 7)
    return np.where(pin, nb.mean(0), a)


def _d_finish(a, px, s2=0.45, t=(0.22, 0.66)):
    import numpy as np
    a = np.clip(_d_usm(a, 0.55, s2), 0, 1) if s2 else a
    if px < 48:
        a = _p_curve(a, *t)
    elif px < 128:
        a = _p_curve(a, 0.06, 0.88)
    return _d_cleanup(a) if px < 64 else a


def _d_win(m, cx, cy, sw, sh):
    import numpy as np
    x0, y0 = int(round(cx - sw / 2)), int(round(cy - sh / 2)); P = 1400
    return np.pad(m, P)[y0 + P:y0 + P + int(round(sh)), x0 + P:x0 + P + int(round(sw))]


def _d_disc(cx, cy, r, shape):
    import numpy as np
    yy, xx = np.mgrid[0:shape[0], 0:shape[1]]
    return np.clip(r + 0.5 - np.hypot(xx - cx, yy - cy), 0, 1)


def _d_uzeye(U, px, light=False):
    """Uzumaki Eye: the eye fills the width (window side 930); the lid line and the iris rim are lifted by the source-scale USM."""
    import numpy as np
    h_px = px; side = 930.0; sw, sh = side, side * h_px / px; k = side / px
    cx, cy = 838.0, 466.0
    L = _d_win(U.L, cx, cy, sw, sh); M = _d_win(U.EYEMASK, cx, cy, sw, sh)
    L = np.clip(_d_usm(L, 1.0 * k, 1.1), 0, 1)
    core_r = max(U.CORE[2], 0.95 * k)
    core = _d_disc(U.CORE[0] - (cx - sw / 2), U.CORE[1] - (cy - sh / 2), core_r, L.shape)
    lv = np.clip((L - 0.07) / 0.72, 0, 1)
    cov = (1 - lv) ** 0.9 * 0.95 * M if light else lv ** 0.85 * M
    cov = cov * (1 - core)
    a, b = _p_area(cov, px, h_px), _p_area(core, px, h_px)
    a = _d_finish(a, px, 0.55, (0.18, 0.70)); b = _p_curve(b, 0.12, 0.55)
    return _p_rgba(a, b)


# ---- S15b: the v10 workspace sets (lab/v10/ws10.py ported). Tomie from the user's Tommie drawing, Beetle's strip = the three-level read ----
WS_CROPS = {"gaze": (348, 286, 150), "bulge": (212, 300, 118)}      # the fringe's tips over her eye + the mole / the second face's bulging eye
WS_PUPIL = (221, 287, 4.0)


def _numeral_off():
    """True inside ito_sh.no_numeral(): the picker preview of a family is drawn without its numeral (the bar tiles keep theirs)."""
    sh = sys.modules.get("ito_sh")
    return sh is not None and sh.NUMERAL_OFF[0]


def _w_numeral(n, px):
    """(digit coverage, moat) of the Noto Serif Bold numeral, bottom-left on whole device px (her cheek; the mole is bottom-right)."""
    import numpy as np
    from PIL import Image, ImageDraw, ImageFont, ImageFilter
    if _numeral_off():
        return np.zeros((px, px), np.float32), np.zeros((px, px), np.float32)
    SS = 8
    h = max(8, int(round(0.40 * px)) if px <= 32 else int(round(12.8 + 0.18 * (px - 32))))
    m = Image.new("L", (px * SS, px * SS), 0); dr = ImageDraw.Draw(m)
    f = ImageFont.truetype(SERIF_BOLD, int(h * SS * 1.36)); t = str(n)
    bb = dr.textbbox((0, 0), t, font=f); w = bb[2] - bb[0]; hh = bb[3] - bb[1]
    sx = 0.86 if n == 10 else 1.0
    tmp = Image.new("L", (w + 4, hh + 4), 0); ImageDraw.Draw(tmp).text((2 - bb[0], 2 - bb[1]), t, font=f, fill=255)
    tmp = tmp.resize((max(1, int(w * sx)), int(h * SS)), Image.LANCZOS)
    m.paste(tmp, (1 * SS, px * SS - tmp.height - 1 * SS))
    d = _p_curve(np.asarray(m.resize((px, px), Image.BOX), np.float32) / 255, 0.18, 0.62)
    moat = np.asarray(Image.fromarray((d * 255).astype(np.uint8)).filter(ImageFilter.MaxFilter(3)), np.float32) / 255
    return d, moat


# ---- v11: the Tomie mark and workspaces from BOTH faces / each half of her face (user decision; the older head-crop family `tomie-head` was removed in the HD pass) ----
# Real art only: boxes of the user's Tommie drawing, made square by padding (the padding is transparent, never a cut through a face).
TOMIE_STICKER_BOX = (45, 20, 500, 430)                              # S19c: the die-cut sticker takes the whole head (hair tuft, left cheek, long hair), so the silhouette is hers and not the crop's; (75, 120, 430, 415) inside the figure only gives a rectangle
WS11_BOX = {"fair": (275, 215, 425, 365), "melt": (100, 225, 250, 375)}     # the human side (eye + mole + fringe) / the transformed side (second eye + lips)
WS11_PUPIL = (221, 287, 5.0)                                         # the transformed side's bulging eye


def _t11_maps(T, px, box, light, accent, mask_fig=False):
    """(ink, accent) coverage of `box` of the drawing, square-padded, at `px`. accent = (cx, cy, r) in source px, or None."""
    import numpy as np
    x0, y0, x1, y1 = box
    w, h = x1 - x0, y1 - y0
    s = max(w, h); cx, cy = (x0 + x1) / 2, (y0 + y1) / 2; k = s / px
    L = _d_win(T.L, cx, cy, s, s); F = _d_win(T.FIG.astype(np.float32), cx, cy, s, s)
    ox, oy = cx - s / 2, cy - s / 2
    yy, xx = np.mgrid[0:L.shape[0], 0:L.shape[1]]
    inside = ((xx + ox >= x0) & (xx + ox < x1) & (yy + oy >= y0) & (yy + oy < y1)).astype(np.float32)
    L0 = L
    L = np.clip(_d_usm(L, 0.9 * k, 0.9), 0, 1)
    if light:
        cov = np.clip((0.78 - L) / 0.55, 0, 1) ** 0.85 * F
    else:
        cov = np.clip((L - 0.34) / 0.48, 0, 1) ** 1.15 * F
    cov = cov * inside
    acc = np.zeros_like(cov)
    if accent:
        r = max(accent[2], 0.95 * k)
        acc = _d_disc(accent[0] - ox, accent[1] - oy, r, L.shape) * (((L < 0.55) | (r > accent[2])) & (inside > 0))
        cov = cov * (1 - acc)
    a = _d_finish(_p_area(cov, px), px, 0.5, (0.26, 0.64)); b = _p_curve(_p_area(acc, px), 0.15, 0.55)
    if px <= TOMIE_HC_MAX:
        a, b = _t_hc(L0, F * inside, acc, light, px, mask_fig)
    return a, b


def _d_tomie_sticker(T, px, light=False, box=None):
    """S19c: the Tomie mark as a DIE-CUT STICKER of the real drawing: no tile, no rim rectangle, transparent everywhere outside the figure.
    The silhouette is the figure mask of the drawing (the white page flood-filled from the borders, `_p_figure`; small leaks closed) cut by `box`
    (TOMIE_STICKER_BOX, padded to a square). Inside it the drawing in two theme tokens: dark twin = paper bone (lum 200) + ink (lum 0, the theme ground);
    light twin = the roles inverted (paper 0 = the light ground, ink 200 = the dark foreground). A thin outline in the paper token (dark twin) / the ink
    token (light twin) closes the silhouette, so the hair shape reads on the bar: 1 px up to 36, 1.5 px up to 128, proportional above. The mole stays blood.
    Drawing recipe as the old tile (Lanczos to 8x, curve (a - 0.12) / 0.62, MinFilter 3 up to 36, BOX down); the silhouette is smoothed at 8x and the
    outline is the silhouette grown by a blur + threshold, all premultiplied before the BOX down."""
    import numpy as np
    from PIL import Image, ImageFilter
    x0, y0, x1, y1 = box or getattr(T, "STICKER_BOX", TOMIE_STICKER_BOX)
    s0 = max(x1 - x0, y1 - y0); cx, cy = (x0 + x1) / 2, (y0 + y1) / 2
    ow = 1.0 if px <= 36 else 1.5 if px <= 128 else 1.5 * px / 128      # outline width, device px
    s = s0 * px / (px - 2 * (ow + 0.5))                                 # window side in source px: room for the outline all round
    L = _d_win(T.L, cx, cy, s, s)
    F = _d_win(T.FIG.astype(np.float32), cx, cy, s, s)
    ox, oy = cx - s / 2, cy - s / 2
    yy, xx = np.mgrid[0:L.shape[0], 0:L.shape[1]]
    inside = (xx + ox >= x0) & (xx + ox < x1) & (yy + oy >= y0) & (yy + oy < y1)
    SS = 8 if px <= 128 else 2
    S = px * SS
    fi = Image.fromarray((F * 255 + 0.5).astype(np.uint8)).filter(ImageFilter.MaxFilter(7)).filter(ImageFilter.MinFilter(7))      # close the leaks of the mask
    fi = Image.fromarray((np.asarray(fi, np.float32) * inside).astype(np.uint8)).resize((S, S), Image.BICUBIC).filter(ImageFilter.GaussianBlur(0.6 * SS * px / max(1, s)))
    M = fi.point(lambda v: 255 if v > 127 else 0)                       # the silhouette at SS x
    sg = ow * SS / 1.2816                                               # blur + threshold 0.1 grows the shape by 1.28 sigma = the outline width
    Mo = M.filter(ImageFilter.GaussianBlur(sg)).point(lambda v: 255 if v > 25 else 0)
    g = Image.fromarray((np.clip(np.where(inside, L, 1.0), 0, 1) * 255 + 0.5).astype(np.uint8)).resize((S, S), Image.LANCZOS)
    gi = Image.fromarray((np.clip((np.asarray(g, np.float32) / 255 - 0.12) / 0.62, 0, 1) * 255 + 0.5).astype(np.uint8))
    if px <= 36:
        gi = gi.filter(ImageFilter.MinFilter(3))
    paper = np.asarray(gi, np.float32) / 255                            # 1 = paper, 0 = ink
    sil = np.asarray(M, np.float32) / 255; grown = np.asarray(Mo, np.float32) / 255
    ink = np.where(sil > 0, 1 - paper, 1.0 if light else 0.0)           # outside the silhouette (the ring): the paper token (dark) / the ink token (light)
    A = _p_area(grown, px)
    C = _p_area(ink * grown, px) / np.maximum(A, 1e-6)
    m = T.MOLE; k = s / px; mr = max(m[2], 0.95 * k)
    acc = _d_disc(m[0] - ox, m[1] - oy, mr, L.shape) * ((L < 0.55) | (mr > m[2])) * inside
    b = _p_curve(_p_area(acc, px), 0.15, 0.55)
    g8 = INK * C if light else INK * (1 - C)
    o = np.zeros((px, px, 4), np.float32)
    o[..., 0] = g8 * (1 - b) + 200 * b; o[..., 1] = g8 * (1 - b) + 16 * b; o[..., 2] = g8 * (1 - b) + 20 * b
    o[..., 3] = np.maximum(A, b) * 255
    return Image.fromarray(np.clip(o + 0.5, 0, 255).astype(np.uint8), "RGBA")


TOMIE12_CIRCLE = (230, 305, 180)                                    # centre x, y and radius in source px: the transformed face (second eye, lips) fills the left, the human eye + mole stay in


TOMIE_HC_MAX = 56      # up to this tier the Tomie faces are drawn for maximum contrast (full paper, line-weight floor); above it the original tonal render


def _t_hc(L, F, acc, light, px, mask_fig=False):
    """S17 high-contrast Tomie below 57 px (the orchestrator's verified badge recipe, lab/v11/tomie_badge.py, ported): the square grey window of the drawing is
    resampled (Lanczos) to 8x the tier, the contrast curve (a - 0.12) / 0.62 makes the paper full strength, a MinFilter (3 px on the 8x canvas) thickens every ink line to at least a whole device pixel, and a BOX resample brings it to the tier. Dark themes: the paper is the
    bone token at full strength and the ink is clear (the ground shows, never an opaque black); the light twin swaps the roles (ink lines in the ink token on
    clear paper). The accent (mole / pupil) is kept apart, as before. -> (a, b) coverage."""
    import numpy as np
    from PIL import Image, ImageFilter
    S = px * 8
    g = Image.fromarray((np.clip(L, 0, 1) * 255 + 0.5).astype(np.uint8)).resize((S, S), Image.LANCZOS)
    a = np.clip((np.asarray(g, np.float32) / 255 - 0.12) / 0.62, 0, 1)
    # the verified recipe thickens with 7 / 5 / 3 px at <= 32 / <= 48 / above; lab/s17/tomie-kernels.png shows 7 and 5 eat the paper into mush at 26-36 (the left face is lost),
    # so the 3 px kernel is used at every tier <= 56 (deviation from the recipe, reported)
    gi = Image.fromarray((a * 255 + 0.5).astype(np.uint8)).filter(ImageFilter.MinFilter(3)).resize((px, px), Image.BOX)
    paper = np.asarray(gi, np.float32) / 255
    acc_px = _p_area(acc, px)
    a = (1 - paper) if light else paper
    if mask_fig:                                      # the mark: only inside the figure and the box (the workspaces keep the full window)
        fa = _p_curve(_p_area(F, px), 0.30, 0.70)
        a = a * fa if light else np.maximum(a * fa, 0.24 * fa)      # dark: her black hair is a faint bone tone, so the head and the fringe read as a shape
    return a * (1 - np.clip(acc_px * 2, 0, 1)), _p_curve(acc_px, 0.15, 0.55)


def _w_tomie11(T, n, st, px, light, memo):
    """v11 workspace: the human side while empty/occupied, the transformed side when active, that side in blood when urgent."""
    import numpy as np
    from PIL import Image
    half = "fair" if st in ("empty", "occupied") else "melt"
    key = (px, half, light)
    if key not in memo:
        memo[key] = _t11_maps(T, px, getattr(T, "WS11_BOX", WS11_BOX)[half], light, T.MOLE if half == "fair" else getattr(T, "WS11_PUPIL", WS11_PUPIL))
    a, b = memo[key]
    N, moat = _w_numeral(n, px)
    a = a * (1 - moat); b = b * (1 - moat)
    z = 0 * a
    if st == "empty":      ink, blood = np.maximum(a * 0.45, N * 0.70), b * 0.45
    elif st == "occupied": ink, blood = np.maximum(a, N), b
    elif st == "active":   ink, blood = np.maximum(a, N), b
    else:                  ink, blood = np.maximum(b, N), a        # the transformed side's lines in blood, its eye and the numeral in bone
    im = _p_rgba(ink, blood)
    if not light and st != "urgent" and px > TOMIE_HC_MAX:
        arr = np.asarray(im).copy(); red = arr[..., 0].astype(int) - arr[..., 1] > 60
        arr[..., :3] = np.where(red[..., None], arr[..., :3], (arr[..., :3] * 0.85).astype(np.uint8)); im = Image.fromarray(arr, "RGBA")
    return im


WS12_CIRCLE = (172, 300, 80)                                        # the transformed face: second eye + lips inside a circle (active / urgent)


def _t12_maps(T, px, light):
    """(ink, accent, rim) of the transformed face inside the circle `WS12_CIRCLE`, at `px`: transparent outside the rim, no ground."""
    import numpy as np
    cx, cy, r = getattr(T, "WS12_CIRCLE", WS12_CIRCLE); s = 2 * r; k = s / px
    pupil = getattr(T, "WS11_PUPIL", WS11_PUPIL)
    L = _d_win(T.L, cx, cy, s, s); F = _d_win(T.FIG.astype(np.float32), cx, cy, s, s); ox, oy = cx - r, cy - r
    L0 = L
    L = np.clip(_d_usm(L, 0.9 * k, 0.9), 0, 1)
    cov = (np.clip((0.78 - L) / 0.55, 0, 1) ** 0.85 if light else np.clip((L - 0.34) / 0.48, 0, 1) ** 1.15) * F
    acr = max(pupil[2], 0.95 * k)
    acc = _d_disc(pupil[0] - ox, pupil[1] - oy, acr, L.shape) * ((L < 0.55) | (acr > pupil[2]))
    cov = cov * (1 - acc)
    a = _d_finish(_p_area(cov, px), px, 0.5, (0.26, 0.64)); b = _p_curve(_p_area(acc, px), 0.15, 0.55)
    if px <= TOMIE_HC_MAX:
        a, b = _t_hc(L0, F, acc, light, px)
    yy, xx = np.mgrid[0:px, 0:px]; d = np.hypot(xx - (px - 1) / 2, yy - (px - 1) / 2); R = px / 2; w = max(1.0, 0.05 * px)
    ring = np.clip(np.minimum(R - d, d - (R - w)) + 0.5, 0, 1); inner = np.clip(R - w - d + 0.5, 0, 1)
    return np.maximum(a * inner, ring) * np.clip(R - d, 0, 1), b * inner, ring


def _w_tomie12(T, n, st, px, light, memo, memo11):
    """v12 workspace: the human side (square, as v11) while empty / occupied; the transformed face inside a circle when active, in blood when urgent."""
    import numpy as np
    from PIL import Image
    if st in ("empty", "occupied"):
        return _w_tomie11(T, n, st, px, light, memo11)
    key = (px, light)
    if key not in memo:
        memo[key] = _t12_maps(T, px, light)
    a, b, ring = memo[key]
    N, moat = _w_numeral(n, px)
    a = a * (1 - moat); b = b * (1 - moat)
    ink, blood = (np.maximum(a, N), b) if st == "active" else (np.maximum(b, N), a)
    im = _p_rgba(ink, blood)
    if not light and st != "urgent" and px > TOMIE_HC_MAX:
        arr = np.asarray(im).copy(); red = arr[..., 0].astype(int) - arr[..., 1] > 60
        arr[..., :3] = np.where(red[..., None], arr[..., :3], (arr[..., :3] * 0.85).astype(np.uint8)); im = Image.fromarray(arr, "RGBA")
    return im


class _TomieHD(_Tomie):
    """The user's HD Tomie (1500x2000: an ink drawing on paper, a black framed panel with a white halo; a signature under the frame).
    Only the inside of the frame is read (`FRAME`: the paper margin and the signature never reach a product). The halo is flood-filled from
    `HALO` (the dark ink sealed by 3 px so it cannot leak through her outline) and the spray outside it from the frame's sides: what is left
    is her figure, put on white paper so the Tommie recipes (sticker, workspaces) work unchanged. The thin pen lines are thickened by a
    3 px MinFilter (crisp ink at bar size). Every box below is in the frame's own pixels (1245x1520)."""
    FRAME = (135, 255, 1380, 1775)
    HALO = ((1000, 300), (1100, 1200), (100, 1300), (200, 250), (150, 700))
    MOLE = (753, 601, 6.0)
    STICKER_BOX = (255, 110, 915, 790)                               # the whole head: hair crown, both faces, the long hair, down to the chin
    WS11_BOX = {"fair": (600, 440, 840, 680), "melt": (290, 420, 560, 690)}
    WS11_PUPIL = (501, 550, 5.0)                                     # the second face's bulging eye
    WS12_CIRCLE = (440, 570, 150)

    def __init__(self, im):
        import numpy as np
        from PIL import Image, ImageDraw, ImageFilter
        g = np.asarray(im.convert("L").crop(self.FRAME), np.float32) / 255
        lo, hi = np.percentile(g, 3), np.percentile(g, 97)
        L = np.clip((g - lo) / max(1e-3, hi - lo), 0, 1)

        def grow(m, r):
            return np.asarray(Image.fromarray(m.astype(np.uint8) * 255).filter(ImageFilter.MaxFilter(2 * r + 1))) > 0

        def flood(mask, seeds):
            img = Image.fromarray(np.where(mask, 255, 0).astype(np.uint8)).copy()
            for xy in seeds:
                if img.getpixel(xy) == 255:
                    ImageDraw.floodfill(img, xy, 128, thresh=0)
            return np.asarray(img) == 128

        halo = grow(flood(~grow(L < 0.5, 3), self.HALO), 4)
        h, w = L.shape
        spray = flood(~halo, ((2, 2), (w - 3, 2), (2, h // 2), (w - 3, h // 2)))
        fig = ~halo & ~spray
        img = Image.fromarray(np.where(fig, 255, 0).astype(np.uint8)).copy()     # specks of paper left inside the spray: every piece under 2000 px goes
        while True:
            a = np.asarray(img)
            i = int(np.argmax(a == 255))
            if a.flat[i] != 255:
                break
            xy = (i % w, i // w)
            ImageDraw.floodfill(img, xy, 100, thresh=0)
            if int((np.asarray(img) == 100).sum()) >= 2000:
                ImageDraw.floodfill(img, xy, 200, thresh=0)
            else:
                ImageDraw.floodfill(img, xy, 0, thresh=0)
        self.FIG = np.asarray(img) == 200
        thick = np.asarray(Image.fromarray((L * 255 + 0.5).astype(np.uint8)).filter(ImageFilter.MinFilter(3)), np.float32) / 255
        self.L = np.where(self.FIG, thick, 1.0).astype(np.float32)


def _tomie_of(src):
    return _TomieHD(src) if src.size == TOMIE_HD_SRC else _Tomie(src)


class _BeetleFix(_Beetle):
    """S18 beetle (the orchestrator's verified recipe, lab/v11/beetle_fix.py): thin lines kept, NO dilation. The seal is erased, the drawing is cropped to
    (0.03W, 0.14H, 0.97W, 0.86H), cut per tier with LANCZOS to 8x, ink = 1 - lum, curve clip((v - 0.10) / 0.7), BOX down to the tier, gain 1.15; alpha = the ink
    coverage on a TRANSPARENT ground (the theme shader makes it the bone token on dark themes, the ink token on light ones). The abdomen eye is the blood accent."""
    ERASE = (0.76, 0.22, 0.84, 0.33)
    CROP = (0.03, 0.14, 0.97, 0.86)

    def __init__(self, im):
        import numpy as np
        from PIL import Image, ImageDraw
        W, H = im.size
        im = im.convert("RGB").copy()
        e = self.ERASE
        ImageDraw.Draw(im).rectangle((int(e[0] * W), int(e[1] * H), int(e[2] * W), int(e[3] * H)), fill=(255, 255, 255))
        c = self.CROP; self.box = (int(c[0] * W), int(c[1] * H), int(c[2] * W), int(c[3] * H))
        self.crop = im.convert("L").crop(self.box)
        self.eye = (self.IRIS[0] - self.box[0], self.IRIS[1] - self.box[1], self.IRIS[3])
        self._memo = {}

    def _strip(self, px, h):
        """(ink, blood) coverage maps (h, px) of the beetle fitted whole (never cut) in a px x h cell, centred."""
        key = (px, h)
        if key in self._memo:
            return self._memo[key]
        import numpy as np
        from PIL import Image
        cw, ch = self.crop.size
        s = min(px / cw, h / ch)
        tw, th = max(1, int(round(cw * s))), max(1, int(round(ch * s)))
        ss = 8 if px <= 128 else 2
        g = np.asarray(self.crop.resize((tw * ss, th * ss), Image.LANCZOS), np.float32) / 255
        ink = np.clip(((1 - g) - 0.10) / 0.7, 0, 1)
        yy, xx = np.mgrid[0:th * ss, 0:tw * ss]
        k = 1 / (s * ss)                                          # source px per 8x px
        r = max(self.eye[2] + 1.0, 0.95 / s) if px < 40 else self.eye[2] + 1.0
        m = np.clip(r * s * ss + 0.5 - np.hypot(xx - self.eye[0] * s * ss, yy - self.eye[1] * s * ss), 0, 1)
        ink = np.maximum(ink, 0.9 * m)                            # the eye is a solid blood point at every tier
        blood, rest = ink * m, ink * (1 - m)
        down = lambda a: np.asarray(Image.fromarray(a.astype(np.float32), "F").resize((tw, th), Image.BOX))
        A, B = np.clip(down(rest) * 1.15, 0, 1), np.clip(down(blood) * 1.15, 0, 1)
        outA, outB = np.zeros((h, px), np.float32), np.zeros((h, px), np.float32)
        x0, y0 = (px - tw) // 2, (h - th) // 2
        outA[y0:y0 + th, x0:x0 + tw], outB[y0:y0 + th, x0:x0 + tw] = A, B
        self._memo[key] = (outA, outB)
        return self._memo[key]

    def mark(self, px, light=False):
        a, b = self._strip(px, px)
        return _p_rgba(a, b)

    def ws(self, n, state, px, light=False):
        import numpy as np
        d, g, nz = self.layout(px); bh = px - nz
        a, e = self._strip(px, bh)
        A = np.zeros((px, px), np.float32); E = np.zeros_like(A); A[:bh], E[:bh] = a, e
        N = self.mayan(n, px); z = np.zeros_like(A)
        if state == "empty":      ink, blood = np.maximum(np.maximum(A, E) * 0.55, N * 0.7), z
        elif state == "occupied": ink, blood = np.maximum(np.maximum(A, E), N), z
        elif state == "active":   ink, blood = A, np.maximum(E, N)
        else:                     ink, blood = z, np.maximum(np.maximum(A, E), N)
        return _p_rgba(ink, blood)


# the Sheet spiral (system-normal.png, 282 px hand drawing): rebuilt from ITS OWN centreline (polar unwrap + least-squares Archimedean fit),
# drawn per tier as a ribbon: < 48 w 1.45 -> 1.9 px, gap >= 2.0 / 2.4, <= 2.9 / 3.8 turns; >= 48 w 0.040 -> 0.058 x px, gap 0.055 x px, 3.4 turns.
def _d_spiral_fit(src):
    import math
    import numpy as np
    im = src.convert("RGBA"); fill = 0.93
    al = np.asarray(im)[..., 3]; ys, xs = np.where(al > 8)
    x0, x1, y0, y1 = xs.min(), xs.max() + 1, ys.min(), ys.max() + 1
    side = int(math.ceil(max(x1 - x0, y1 - y0) / fill)); cx, cy = (x0 + x1) / 2, (y0 + y1) / 2
    box = (int(round(cx - side / 2)), int(round(cy - side / 2))); box = box + (box[0] + side, box[1] + side)
    im = im.crop(box)
    a = np.asarray(im, np.float32)[..., 3] / 255; s = a.shape[0]
    ys, xs = np.nonzero(a > 0.7); w = a[ys, xs]
    c0 = np.array([s / 2, s / 2])
    for _ in range(3):
        d = np.hypot(xs - c0[0], ys - c0[1]); m = d < 0.25 * s / 2
        c0 = np.array([np.average(xs[m], weights=w[m]), np.average(ys[m], weights=w[m])])
    N = 360; R = int(s / 2); pts = []; TAU = math.tau
    for i in range(N):
        th = i / N * TAU; rr = np.arange(2, R, 0.5)
        x = c0[0] + rr * math.cos(th); y = c0[1] + rr * math.sin(th)
        v = a[np.clip(y.astype(int), 0, s - 1), np.clip(x.astype(int), 0, s - 1)]
        on = v > 0.7; edges = np.flatnonzero(np.diff(on.astype(int)) == 1)
        for e in edges:
            j = e + 1; k = j
            while k < len(on) and on[k]:
                k += 1
            pts.append((th, rr[(j + k - 1) // 2]))
    pts = np.array(pts)
    best = None
    pts = pts[pts[:, 1] < 0.40 * s]
    for pitch in np.linspace(0.06 * s, 0.20 * s, 200):
        b = pitch / TAU
        for a0 in np.linspace(0, pitch, 32, endpoint=False):
            k = np.round((pts[:, 1] - a0 - b * pts[:, 0]) / pitch)
            res = pts[:, 1] - (a0 + b * (pts[:, 0] + TAU * k))
            score = (np.abs(res) < 0.12 * pitch).mean()
            if best is None or score > best[0]:
                best = (score, a0, b, k)
    err, a0, b, k = best
    phi = pts[:, 0] + TAU * k; A = np.vstack([np.ones_like(phi), phi]).T
    a0, b = np.linalg.lstsq(A, pts[:, 1], rcond=None)[0]
    res = pts[:, 1] - (a0 + b * phi); ok = np.abs(res) < 0.5 * TAU * b
    phi, res = phi[ok], res[ok]
    M = np.column_stack([f(h * pts[ok, 0]) for h in range(1, 7) for f in (np.cos, np.sin)])
    coef = np.linalg.lstsq(M, res, rcond=None)[0]
    return dict(s=s, cx=float(c0[0]), cy=float(c0[1]), a=float(a0), b=float(b), phi0=float(phi.min()), phi1=float(phi.max()),
                wob=[float(c) for c in coef])


def _d_spiral(g, px):
    import math
    import numpy as np
    from PIL import Image, ImageDraw
    TAU = math.tau; SS = 16
    if px >= 48:
        w0, w1, G, max_turns = 0.040 * px, 0.058 * px, 0.055 * px, 3.4
    else:
        w0, w1, G, max_turns = 1.45, 1.9, (2.0 if px < 32 else 2.4), (2.9 if px < 36 else 3.8)
    k = px / g["s"]; cx, cy = g["cx"] * k, g["cy"] * k
    b = g["b"] * k; a = g["a"] * k; p0, p1 = g["phi0"], g["phi1"]
    r1 = min(a + b * p1, px / 2 - 1.0 - w1 / 2)
    b = max(b, (w1 + G) / TAU)
    p0 = max(p1 - max_turns * TAU, p1 - (r1 - 1.2) / b)
    a = r1 - b * p1
    n = 900; left, right = [], []
    hf = list(zip([(h, f) for h in range(1, 7) for f in (np.cos, np.sin)], g["wob"]))[:4]
    for i in range(n + 1):
        t = i / n; ph = p0 + (p1 - p0) * t
        wob = 0.5 * sum(c * f(h * ph) for (h, f), c in hf) * k
        r = a + b * ph + wob; w = (w0 + (w1 - w0) * t) / 2
        x, y = cx + r * math.cos(ph), cy + r * math.sin(ph)
        left.append((x + math.cos(ph) * w, y + math.sin(ph) * w)); right.append((x - math.cos(ph) * w, y - math.sin(ph) * w))
    m = Image.new("L", (px * SS, px * SS), 0); d = ImageDraw.Draw(m)
    d.polygon([(x * SS, y * SS) for x, y in left + right[::-1]], fill=255)
    ex, ey, er_ = cx + (a + b * p1) * math.cos(p1), cy + (a + b * p1) * math.sin(p1), w1 / 2
    d.ellipse(((ex - er_) * SS, (ey - er_) * SS, (ex + er_) * SS, (ey + er_) * SS), fill=255)
    cov = np.asarray(m.resize((px, px), Image.BOX), np.float32) / 255
    acc = np.zeros((px, px, 4), np.float32)                       # the lab's premultiplied "over" of one bone layer, step for step
    col = np.array((0xc7, 0xcc, 0xd1), np.float32) / 255
    acc[..., :3] = col * cov[..., None] + acc[..., :3] * (1 - cov[..., None]); acc[..., 3] = cov + acc[..., 3] * (1 - cov)
    out = np.zeros_like(acc); al = acc[..., 3:4]
    out[..., :3] = np.where(al > 1e-6, acc[..., :3] / np.maximum(al, 1e-6), 0); out[..., 3:4] = al
    return Image.fromarray((np.clip(out, 0, 1) * 255 + 0.5).astype(np.uint8), "RGBA")


# the Sheet spiral, ENHANCED (S15 correction): the hand drawing itself, never redrawn. Optical fill 0.985 of the tile, 2x Lanczos for >= 64 px, local
# contrast at source scale, a light dilation that only matters where a stroke is thinner than ~1 target px, area (BOX) filter, target sharpen, tone curve, island clean-up.
# The source is 282 px: below ~128 px it is always a downscale (honest); above that it would be an upscale (not shipped, the 282 raster is used).
def _d_spiral_hand(src, px):
    import math
    import numpy as np
    from PIL import Image, ImageFilter
    al = np.asarray(src.convert("RGBA"), np.float32)[..., 3] / 255
    ys, xs = np.where(al > 0.25); x0, x1, y0, y1 = xs.min(), xs.max() + 1, ys.min(), ys.max() + 1
    side = int(math.ceil(max(x1 - x0, y1 - y0) / 0.985)); bx, by = int(round((x0 + x1) / 2 - side / 2)), int(round((y0 + y1) / 2 - side / 2))
    P = 40; A = np.pad(al, P)[by + P:by + P + side, bx + P:bx + P + side]
    up = 2 if px >= 64 else 1
    if up > 1:
        A = np.clip(np.asarray(Image.fromarray(A.astype(np.float32), "F").resize((side * up, side * up), Image.LANCZOS), np.float32), 0, 1)
    k = A.shape[0] / px
    A = np.clip(A + 0.8 * (A - _d_gblur(A, 0.45 * k)), 0, 1)
    rho = max(0.0, (0.95 * k - 3.0 * up) / 2.0) * 0.35
    if rho > 0.5:
        sz = 2 * int(round(rho)) + 1
        D = _d_gblur(np.asarray(Image.fromarray((A * 255).astype(np.uint8)).filter(ImageFilter.MaxFilter(sz)), np.float32) / 255, rho * 0.35)
        A = np.maximum(A, D * (0.7 if px < 48 else 0.8))
    a = _p_area(A, px)
    a = np.clip(a + 0.7 * (a - _d_gblur(a, 0.55)), 0, 1)
    a = _p_curve(a, *((0.15, 0.65) if px < 48 else (0.08, 0.75))) ** 0.8
    h, w = a.shape; p = np.pad(a, 1)
    nb = np.stack([p[1 + dy:h + 1 + dy, 1 + dx:w + 1 + dx] for dy in (-1, 0, 1) for dx in (-1, 0, 1) if (dy, dx) != (0, 0)])
    a = np.where((a > 0) & ((nb > 0.30).sum(0) == 0) & (a < 0.5), 0, a)
    o = np.zeros((px, px, 4), np.float32); o[..., :3] = np.array((0xc7, 0xcc, 0xd1), np.float32) / 255; o[..., 3] = np.clip(a, 0, 1)
    return Image.fromarray((o * 255 + 0.5).astype(np.uint8), "RGBA")


# ---- S15c: new user assets (lab/v10/s15c.py ported). Workspace family `uzumaki-eye` (bleeding-eye.png), marks `heather` / `pyramid` (the `silenthill` workspace family was removed) ----
# User pixels never ship: every product is written under the assets folder only. Gate rule (like Tomie, S15b): these are tonal families, so `crisp` is report-only
# for the eye family below 32 px (the asset is an eye + drips in a square: ~14-18 px wide at 24-32) and for the portraits of the sheets; `fill` and `black` are enforced.
EYE_SRC_MIN = 96                                          # the bleeding eye is 105 x 103; anything smaller is refused
HP_ROUND = {"heather": (395, 470, 278), "pyramid": (1115, 470, 278)}      # the roundels of the Heather / Pyramid sheet: (cx, cy, r)


def _s_rgb(im):
    import numpy as np
    return np.asarray(im.convert("RGB"), np.float32) / 255


def _s_red(a):
    import numpy as np
    return np.clip((a[..., 0] - (a[..., 1] + a[..., 2]) / 2 - 0.16) / 0.30, 0, 1)


def _s_digit(n, px, h, corner="tl"):
    """(digit coverage, moat) of the Noto Serif Bold numeral on whole device px; corner top-left."""
    import numpy as np
    from PIL import Image, ImageDraw, ImageFont, ImageFilter
    if _numeral_off():
        return np.zeros((px, px), np.float32), np.zeros((px, px), np.float32)
    SS = 8
    m = Image.new("L", (px * SS, px * SS), 0); f = ImageFont.truetype(SERIF_BOLD, int(h * SS * 1.36)); t = str(n)
    dr = ImageDraw.Draw(m); bb = dr.textbbox((0, 0), t, font=f); w = bb[2] - bb[0]; hh = bb[3] - bb[1]
    tmp = Image.new("L", (w + 4, hh + 4), 0); ImageDraw.Draw(tmp).text((2 - bb[0], 2 - bb[1]), t, font=f, fill=255)
    tmp = tmp.resize((max(1, int(w * (0.86 if n == 10 else 1))), int(h * SS)), Image.LANCZOS)
    m.paste(tmp, (SS, 0))
    d = _p_curve(np.asarray(m.resize((px, px), Image.BOX), np.float32) / 255, 0.18, 0.62)
    moat = np.asarray(Image.fromarray((d * 255).astype(np.uint8)).filter(ImageFilter.MaxFilter(3)), np.float32) / 255
    return d, moat


class _BleedEye:
    """bleeding-eye.png (105 x 103 in the lab; any picture within 4 % of that aspect and >= 96 px wide, the crop scales with it). The source is
    only ever upsampled to an 752 px anti-alias canvas and area-resampled back: <= 96 px is exactly the source's information, 112/128 are an upscale."""
    OX, OY, SIDE, K = 4, 10, 94, 8

    def __init__(self, im, iris_src=None):
        import numpy as np
        from PIL import Image
        w, h = im.size
        if w < EYE_SRC_MIN or h < EYE_SRC_MIN * 0.9 or abs((w / h) / (105 / 103) - 1) > 0.04:
            raise ValueError(f"the bleeding-eye recipe takes the eye picture (105x103, or the same shape at least {EYE_SRC_MIN} px wide); this is {w}x{h}")
        s = w / 105.0; K = self.K; S = self.SIDE
        crop = im.convert("RGB").crop((int(round(self.OX * s)), int(round(self.OY * s)), int(round((self.OX + S) * s)), int(round((self.OY + S) * s))))
        canvas = crop.resize((S * K, S * K), Image.BICUBIC)
        BE = _s_rgb(canvas); self.L = _lum(canvas); R = _s_red(BE)
        self.iris = ((52.0 - self.OX) * K, (47.0 - self.OY) * K, 13.5 * K)
        eyeline = (62 - self.OY) * K
        self.have_spiral = iris_src is not None
        self.layers = {False: self._layers(R, eyeline, None)}
        if iris_src is not None:
            self.layers[True] = self._layers(R, eyeline, _lum(iris_src))

    def _layers(self, R, eyeline, U):
        import numpy as np
        from PIL import Image
        L = self.L; K = self.K
        lv = np.clip((L - 0.05) / 0.50, 0, 1) ** 0.8
        ink = lv * (1 - R); blood = R * np.clip(lv * 1.4 + 0.3, 0, 1)
        yy, xx = np.mgrid[0:L.shape[0], 0:L.shape[1]]
        drips = (yy > eyeline).astype(np.float32)
        ix, iy, ir = self.iris
        if U is not None:                                   # the Uzumaki engraving's own spiral iris (disc 848,485 r 208), scaled into the iris disc
            cx, cy, r = 848.0, 485.0, 208.0
            sp = U[int(cy - r):int(cy + r), int(cx - r):int(cx + r)]
            sp = np.asarray(Image.fromarray((sp * 255).astype(np.uint8)).resize((int(2 * ir), int(2 * ir)), Image.LANCZOS), np.float32) / 255
            dm = _d_disc(ir, ir, ir - 2, sp.shape)
            x0, y0 = int(ix - ir), int(iy - ir)
            reg = (slice(y0, y0 + sp.shape[0]), slice(x0, x0 + sp.shape[1]))
            spl = np.clip((sp - 0.08) / 0.42, 0, 1)
            ink[reg] = ink[reg] * (1 - dm) + spl * dm
            blood[reg] = blood[reg] * (1 - dm)
        core = _d_disc(ix, iy, 2.2 * K, ink.shape)
        return ink, blood, drips, core

    def ws(self, n, st, px, spiral, memo):
        import numpy as np
        key = (px, spiral)
        if key not in memo:
            ink, blood, drips, core = self.layers[spiral]
            i, b, dr, c = (_p_area(m, px) for m in (ink, blood, drips, core))
            if px >= 112:
                i = np.clip(_d_usm(i, 0.6, 0.6), 0, 1)
            i = _d_finish(i, px, 0.45, (0.20, 0.66)); b = _p_curve(b, 0.12, 0.55) if px < 48 else b
            memo[key] = (i, b, _p_curve(c, 0.2, 0.6), 1 - _p_curve(dr, 0.3, 0.7))
        i, b, cc, eye_only = memo[key]
        N, moat = _s_digit(n, px, max(8, int(round(0.36 * px))) if px <= 32 else int(round(11.5 + 0.16 * (px - 32))))
        if st == "empty":      ink_, bl_ = np.maximum(i * eye_only * 0.45, N * 0.7), 0 * i
        elif st == "occupied": ink_, bl_ = np.maximum(np.maximum(i, b) * eye_only, N), 0 * i
        elif st == "active":   ink_, bl_ = np.maximum(i, N), np.maximum(b, cc)
        else:                  ink_, bl_ = np.maximum(cc, N), np.maximum(i, b) * (1 - cc)
        ink_ = ink_ * (1 - moat) + N * moat; bl_ = bl_ * (1 - moat)
        return _p_rgba(ink_, bl_)


def _lum_a(a):
    return 0.2126 * a[..., 0] + 0.7152 * a[..., 1] + 0.0722 * a[..., 2]


class _HeatherPyramid:
    """`Heather pyramid.png` (1536x1024): two roundels. Micro (< 36 px) = SIGIL (broken ring + blood ticks + glyph), >= 36 = the PORTRAIT of the art."""
    def __init__(self, im):
        self.im = im.convert("RGB")

    def sigil(self, name, px):
        import numpy as np
        from PIL import Image, ImageDraw
        SS = 8; S = px * SS; c = S / 2; r = 0.36 * S
        ink = Image.new("L", (S, S), 0); bl = Image.new("L", (S, S), 0); di, db = ImageDraw.Draw(ink), ImageDraw.Draw(bl)
        w = max(1.4, 0.055 * px) * SS
        for a0 in (0, 90, 180, 270):
            di.arc((c - r, c - r, c + r, c + r), a0 + 12, a0 + 78, fill=255, width=int(w))
        tw = max(1.0, 0.04 * px) * SS
        for y0, y1 in ((c - r - 0.12 * S, c - r + 0.10 * S), (c + r - 0.10 * S, c + r + 0.12 * S)):
            db.rectangle((c - tw / 2, y0, c + tw / 2, y1), fill=255)
        if name == "heather":
            rr = 0.17 * S; di.ellipse((c - rr, c - rr, c + rr, c + rr), outline=255, width=int(max(1.2, 0.05 * px) * SS))
            rb = 0.10 * S; db.ellipse((c - rb, c - rb, c + rb, c + rb), fill=255)
        else:
            tri = 0.22 * S; db.polygon([(c - tri, c - 0.6 * tri), (c + tri, c - 0.6 * tri), (c, c + 0.9 * tri)], fill=255)
        g = lambda im: np.asarray(im.resize((px, px), Image.BOX), np.float32) / 255
        return g(ink), g(bl)

    def portrait(self, name, px):
        import numpy as np
        cx, cy, R = HP_ROUND[name]; R2 = int(R * 1.16); t = _s_rgb(self.im.crop((cx - R2, cy - R2, cx + R2, cy + R2)))
        L = _lum_a(t); Rd = _s_red(t); k = t.shape[0] / px
        L = np.clip(_d_usm(L, 0.9 * k, 0.9), 0, 1); lv = np.clip((L - 0.10) / 0.70, 0, 1)
        i, b = _p_area(lv * (1 - Rd), px), _p_area(Rd, px)
        i = _d_finish(i, px, 0.45, (0.24, 0.66)); b = _p_curve(b, 0.10, 0.50) if px < 64 else b
        return i, b

    ROUNDEL = {"heather": (408, 474, 282), "pyramid": (1122, 474, 285)}      # ring centre x, y and radius in the 1536x1024 sheet (measured on the red ring)
    WIN_H = 340                                                              # half side of the square cut: ring + ticks + the glyph under it

    def roundel(self, name, px, light=False):
        """S18 XL roundel (`Heather pyramid.png`): the portrait INSIDE the red broken ring, with its ticks and the glyph below. >= 36 px the real roundel is cut
        (portrait = the picture's own tone, ring / ticks / glyph = the picture's red -> blood); < 36 px a clean ring (4 broken arcs, blood), two ticks and the glyph are drawn
        on whole pixels around a simplified portrait. Dark: the portrait's light is the bone; light twin: its shade is the ink. -> (ink, blood) coverage."""
        import numpy as np
        from PIL import Image, ImageDraw
        cx, cy, R = self.ROUNDEL[name]; H = self.WIN_H; oy = 505
        t = _s_rgb(self.im.crop((cx - H, oy - H, cx + H, oy + H)))
        L = _lum_a(t); red = np.clip((t[..., 0] - np.maximum(t[..., 1], t[..., 2]) - 0.04) / 0.14, 0, 1)     # the picture's ring is a dark crimson: a low threshold keeps it
        yy, xx = np.mgrid[0:2 * H, 0:2 * H]
        rc = np.hypot(xx - H, yy - (cy - (oy - H)))
        disc = np.clip(R * 0.93 - rc + 0.5, 0, 1)
        inside = disc > 0.5
        lo, hi = np.percentile(L[inside], [4, 99.5])
        tone = np.clip((L - lo) / max(hi - lo, 1e-3), 0, 1)
        tone = tone ** (0.85 if name == "heather" else 0.7)
        k = 2 * H / px
        tone = np.clip(_d_usm(tone, 0.9 * k, 0.8), 0, 1)
        pt = (1 - tone) ** (1.8 if name == "pyramid" else 1.3) * 0.92 if light else tone      # the light twin: shade = ink, lifted so a dark scene is not a black disc
        pt = pt * disc * (1 - red)
        g = lambda m: _p_area(m, px)
        I = g(pt)
        I = _p_curve(I, 0.10, 0.85) if px < 64 else I
        if px >= 36:
            from PIL import Image as _I, ImageDraw as _D
            SS = 8; S = px * SS; c = S / 2; ccy = (cy - (oy - H)) / (2 * H) * S; Rr = R / (2 * H) * S
            bl = _I.new("L", (S, S), 0); d = _D.Draw(bl); w = max(1.2, 0.032 * px) * SS
            for a0 in (0, 90, 180, 270):                                        # the broken ring, clean, under the picture's own red
                d.arc((c - Rr, ccy - Rr, c + Rr, ccy + Rr), a0 + 13, a0 + 77, fill=255, width=int(w))
            arcs = np.asarray(bl.resize((px, px), _I.BOX), np.float32) / 255
            Bm = g(red); Bm = _p_curve(Bm, 0.05, 0.40) if px < 96 else Bm
            Bm = np.maximum(Bm, arcs * (0.9 if px < 96 else 0.75))
            return I * (1 - Bm), Bm
        # ---- micro: a clean ring drawn on whole pixels
        SS = 8; S = px * SS; c = S / 2; ccy = 0.45 * S; Rr = 0.36 * S
        bl = Image.new("L", (S, S), 0); d = ImageDraw.Draw(bl)
        w = max(1.0, 0.055 * px) * SS
        for a0 in (0, 90, 180, 270):
            d.arc((c - Rr, ccy - Rr, c + Rr, ccy + Rr), a0 + 14, a0 + 76, fill=255, width=int(w))
        tw = max(1.0, 0.045 * px) * SS
        d.rectangle((c - tw / 2, ccy - Rr - 0.085 * S, c + tw / 2, ccy - Rr + 0.07 * S), fill=255)
        gy = ccy + Rr + 0.105 * S
        if name == "heather":
            rr = max(1.5, 0.07 * px) * SS; d.ellipse((c - rr, gy - rr, c + rr, gy + rr), fill=255)
        else:
            rr = max(1.8, 0.075 * px) * SS; d.polygon([(c - rr, gy - 0.7 * rr), (c + rr, gy - 0.7 * rr), (c, gy + 0.9 * rr)], fill=255)
        Bm = np.asarray(bl.resize((px, px), Image.BOX), np.float32) / 255
        # the portrait re-fitted inside the small ring (radius 0.30 px)
        sc = (0.30 * px) / (R * 0.93)
        P = np.zeros((px, px), np.float32)
        tw_ = int(round(2 * H * sc)); big = Image.fromarray((np.clip(pt, 0, 1) * 255).astype(np.uint8)).resize((tw_ * 4, tw_ * 4), Image.LANCZOS)
        small = np.asarray(big.resize((tw_, tw_), Image.BOX), np.float32) / 255
        x0 = int(round(px / 2 - (H) * sc)); y0 = int(round(0.45 * px - (cy - (oy - H)) * sc))
        for yy_ in range(tw_):
            for xx_ in range(tw_):
                Y, X = y0 + yy_, x0 + xx_
                if 0 <= Y < px and 0 <= X < px: P[Y, X] = small[yy_, xx_]
        P = _p_curve(P, 0.12, 0.80)
        return P * (1 - Bm), Bm

    def mark(self, name, px, light=False):
        I, B = self.roundel(name, px, light)
        return _p_rgba(I, B)

    def mark_old(self, name, px):
        if px < 36:
            I, B = self.sigil(name, px)
            return _p_rgba(I * (1 - B), B)
        i, b = self.portrait(name, px)
        return _p_rgba(i, b)


def make_photo(kind, src, iris=None, extra=None):
    """[(rel, PIL RGBA)] of one photo recipe for every tier. Pure (no files); raises ValueError on a source of the wrong size."""
    from PIL import Image
    if PHOTO_SRC[kind] is not None and src.size != PHOTO_SRC[kind] and not (kind in ("tomie", "ws-tomie") and src.size == TOMIE_HD_SRC):
        raise ValueError(f"the {kind} recipe takes a {PHOTO_SRC[kind][0]}x{PHOTO_SRC[kind][1]} picture; this is {src.size[0]}x{src.size[1]}")
    out = []
    extra = extra or {}
    if kind in ("mark-heather", "mark-pyramid", "ws-uzumaki-eye", "beetle", "ws-beetle", "hollow-pack"):
        import ito_sh
        ito_sh.set_sources(sheet={"hollow-pack": src}.get(kind) or extra.get("sheet"), hp=src if kind in ("mark-heather", "mark-pyramid") else extra.get("hp"),
                           eye=src if kind == "ws-uzumaki-eye" else None, beetle=src if kind in ("beetle", "ws-beetle") else None)
    if kind.startswith("eye-"):
        return make_eye(kind[4:], src)
    if kind in ("relic-sys", "ws-symbols", "relic-apps"):
        import ito_gothic
        return ito_gothic.products(kind, src, extra.get("ink"), extra.get("blood"), bool(extra.get("light")))
    if kind == "ws-cult":
        import ito_cult
        return ito_cult.products(BAR_PX)
    if kind == "sprites":
        import ito_sprites
        ito_sprites.set_source(src)
        return ito_sprites.products(BAR_PX)
    if kind == "pyramid-head":
        import ito_pyramid
        ito_pyramid.set_source(src)
        return ito_pyramid.products(BAR_PX)
    if kind == "ws-heather":
        import ito_ringws
        ito_ringws.set_source(src)
        return ito_ringws.products_heather(BAR_PX)
    if kind == "spiral":
        g = _d_spiral_fit(src)
        return [(f"system/bar/{px}/system-normal.png", _d_spiral_hand(src, px)) for px in BAR_PX] + \
               [(f"system/bar/{px}/system-normal-clean.png", _d_spiral(g, px)) for px in BAR_PX]
    if kind == "tomie":
        T = _tomie_of(src)
        # The menu mark picker offers only Tomie Classic (a stored `tomie` reads as it), so a fresh install needs marks/tomie-classic* too.
        # Written from this picture, except that the HD panel never replaces a Tomie Classic that is already there (the user's own earlier drawing).
        classic = not (src.size == TOMIE_HD_SRC and (ASSETS / "marks" / "tomie-classic.png").is_file())
        for px in BAR_PX + (512,):
            d = "marks" if px == 512 else f"marks/bar/{px}"
            if px != 512:                                  # S15: the v10 definition beside the v9 files (markDef); the head-crop products were removed
                n11 = (_d_tomie_sticker(T, px, False), _d_tomie_sticker(T, px, True))      # S19c: the die-cut sticker (tomie-clear and tomie-wide were removed)
                out += [(f"{d}/tomie.png", n11[0]), (f"{d}/tomie.light.png", n11[1]), (f"{d}/tomie.v10.png", n11[0]), (f"{d}/tomie.v10.light.png", n11[1])]
                if classic:
                    out += [(f"{d}/tomie-classic.png", n11[0]), (f"{d}/tomie-classic.light.png", n11[1])]
            else:
                out += [(f"{d}/tomie.png", _d_tomie_sticker(T, 512, False)), (f"{d}/tomie.light.png", _d_tomie_sticker(T, 512, True))]
                if classic:
                    out += [(f"{d}/tomie-classic.png", out[-2][1]), (f"{d}/tomie-classic.light.png", out[-1][1])]
    elif kind == "uzumaki-eye":
        U = _UzEye(src)
        for px in BAR_PX + (512,):
            d = "marks" if px == 512 else f"marks/bar/{px}"
            out += [(f"{d}/uzumaki-eye.png", U.mark(px, False)), (f"{d}/uzumaki-eye.light.png", U.mark(px, True))]
            if px != 512:
                out += [(f"{d}/uzumaki-eye.v10.png", _d_uzeye(U, px, False)), (f"{d}/uzumaki-eye.v10.light.png", _d_uzeye(U, px, True))]
    elif kind == "ws-uzumaki-eye":
        E = _BleedEye(src, iris); memo = {}
        main = E.have_spiral                                # the spiral iris is the default; without the engraving the plain iris is the only set
        for px in BAR_PX:
            for n in range(1, 11):
                for st in PHOTO_STATES:
                    im = E.ws(n, st, px, main, memo)
                    out += [(f"workspaces/bar/{px}/ws-uzumaki-eye-{n}-{st}.png", im), (f"workspaces/bar/{px}/ws-uzumaki-eye-{n}-{st}.light.png", im)]
                    if main:                                # key eyeWsIris plain
                        out.append((f"workspaces/bar/{px}/ws-uzumaki-eye-{n}-{st}.alt.png", E.ws(n, st, px, False, memo)))
        out += ito_sh.ws_eye_tight(BAR_PX)                  # S17c: the tight crop (`.v12`, key eyeWsCrop tight = the default); the files above are `wide`
        out += ito_sh.previews("uzumaki-eye", lambda n, st, px, lt: E.ws(n, st, px, main, memo), BAR_PX, light=False)      # the picker's numeral-free card art
        out += ito_sh.previews("uzumaki-eye", lambda n, st, px, lt: ito_sh.to_rgba(ito_sh.uz_eye(n, st, px)), BAR_PX, light=False, suffix=".v12")
    elif kind in ("mark-heather", "mark-pyramid"):
        H = _HeatherPyramid(src); nm = kind[5:]
        for px in BAR_PX + (512,):
            d = "marks" if px == 512 else f"marks/bar/{px}"
            out += [(f"{d}/{nm}-sigil.png", H.mark(nm, px, False)), (f"{d}/{nm}-sigil.light.png", H.mark(nm, px, True))]      # S17b: the old sigil / portrait stays selectable as `<name>-sigil`
        out += ito_sh.mark_character(nm, BAR_PX)            # S17b: `heather` / `pyramid` are now the characters themselves (no ring, ticks or glyph)
    elif kind == "hollow-pack":
        out += ito_sh.pack_user() + ito_sh.pack_procedural()
    elif kind == "ws-tomie":
        T = _tomie_of(src); memo = {}; memo11 = {}
        for px in BAR_PX:
            for n in range(1, 11):
                for st in PHOTO_STATES:
                    out.append((f"workspaces/bar/{px}/ws-tomie-{n}-{st}.png", _w_tomie12(T, n, st, px, False, memo, memo11)))
                    out.append((f"workspaces/bar/{px}/ws-tomie-{n}-{st}.light.png", _w_tomie12(T, n, st, px, True, memo, memo11)))
        import ito_sh
        out += ito_sh.previews("tomie", lambda n, st, px, lt: _w_tomie12(T, n, st, px, lt, memo, memo11), BAR_PX)      # the picker's numeral-free card art
    else:
        B = _BeetleFix(src)
        # S18: ONE beetle (the verified thin-line recipe) is the default under every definition: the old v9 / v10 / v12 products were replaced
        # (kept as a tarball in ~/.config/omarchy/backups/2026-10-15-beetle-old/), so markDef / beetleDef / wsBeetleDef all resolve to the same pictures
        if kind == "beetle":
            for px in BAR_PX + (512,):
                d = "marks" if px == 512 else f"marks/bar/{px}"
                im = B.mark(px)
                out += [(f"{d}/beetle{suf}.png", im) for suf in ("", ".light")]
                if px != 512:
                    out += [(f"{d}/beetle.{v}{suf}.png", im) for v in ("v10", "v12") for suf in ("", ".light")]
        else:
            for px in BAR_PX:
                for n in range(1, 11):
                    for st in PHOTO_STATES:
                        im = B.ws(n, st, px)
                        out += [(f"workspaces/bar/{px}/ws-beetle-{n}-{st}{v}{suf}.png", im) for v in ("", ".v10", ".v12") for suf in ("", ".light")]
            for prel, im in ito_sh.previews("beetle", lambda n, st, px, lt: B.ws(n, st, px), BAR_PX, light=False):      # the picker's card art, no Mayan numeral
                out += [(prel[:-4] + v + suf + ".png", im) for v in ("", ".v10", ".v12") for suf in ("", ".light")]
    return out


def cmd_photo(argv):
    import shutil, tempfile
    kind, file, dry, iris_file = argv[0], None, False, None
    extra_files = {}
    gopt = {}                                              # S18 relic-apps: --out DIR, --ink R,G,B, --blood R,G,B, --light
    args = list(argv[1:])
    while args:
        a = args.pop(0)
        if a in ("--out", "--ink", "--blood") and args:
            gopt[a[2:]] = args.pop(0)
        elif a == "--light":
            gopt["light"] = True
        elif a == "--iris" and args:
            iris_file = Path(args.pop(0)).expanduser()
        elif a in ("--hp", "--sheet") and args:           # S17: the second sheet of hollow-pack
            extra_files[a[2:]] = Path(args.pop(0)).expanduser()
        elif a == "--dry-run":
            dry = True
        elif not a.startswith("-") and file is None:
            file = Path(a).expanduser()
        else:
            out({"error": "usage: ito-assets recipe tomie|uzumaki-eye|beetle|ws-beetle|ws-tomie|eye-uzumaki|eye-lashed|eye-veined FILE [--dry-run]"}, 2)
    if not file and kind == "spiral":
        file = ART / "system" / "system-normal.png"
    nosrc = kind == "ws-cult"                              # drawn from the games' designs: no source picture is read or kept
    if not file and not nosrc:
        out({"error": "usage: ito-assets recipe tomie|uzumaki-eye|beetle|ws-beetle|ws-tomie|spiral|eye-uzumaki|eye-lashed|eye-veined [FILE] [--dry-run]"}, 2)
    repo = ART.resolve().parents[2]
    if not dry and (ASSETS.resolve() == repo or repo in ASSETS.resolve().parents):
        out({"error": f"refused: {ASSETS} is inside {repo}; user pictures never go into a repo"}, 1)
    apps_dir = None
    if kind == "relic-apps":                              # the icon theme is GTK's: its own folder, no index, never inside the repo
        apps_dir = Path(gopt.get("out") or HOME / ".local" / "share" / "icons").expanduser().resolve()
        if apps_dir == repo or repo in apps_dir.parents:
            out({"error": f"refused: {apps_dir} is inside {repo}; user pictures never go into a repo"}, 1)
        try:
            for k in ("ink", "blood"):
                if k in gopt:
                    v = tuple(int(x) for x in str(gopt[k]).split(","))
                    if len(v) != 3 or not all(0 <= x <= 255 for x in v):
                        raise ValueError
                    extra_files[k] = v
        except ValueError:
            out({"error": "--ink and --blood take R,G,B (0-255)"}, 2)
    try:
        import numpy  # noqa: F401
        from PIL import Image
    except ImportError:
        out({"error": "Pillow and numpy are needed for a recipe"}, 1)
    if not nosrc and (file.is_symlink() or not file.is_file() or file.stat().st_size > IN_MAX_BYTES):
        out({"error": f"{file} is not a regular picture file of at most 32 MB"}, 1)
    Image.MAX_IMAGE_PIXELS = int(MAX_PX)
    try:
        if nosrc:
            src = None
        else:
            with Image.open(file) as im:
                if im.format not in ("PNG", "JPEG", "WEBP"):
                    raise ValueError(f"a {im.format} file is not accepted")
                im.load()
                src = im.convert("RGBA" if kind in ("spiral", "sprites", "pyramid-head") else "RGB")
        iris = None
        if kind == "ws-uzumaki-eye":                       # the spiral iris: --iris FILE, else the engraving the uzumaki-eye recipe kept
            cands = [iris_file] if iris_file else sorted((ASSETS / "_sources").glob("uzumaki-eye__*")) + sorted((ASSETS / "_sources").glob("eye-uzumaki__*"))
            for c in cands:
                if c and c.is_file() and not c.is_symlink() and c.stat().st_size <= IN_MAX_BYTES:
                    with Image.open(c) as ii:
                        ii.load()
                        if ii.size == PHOTO_SRC["uzumaki-eye"]:
                            iris = ii.convert("RGB")
                            break
        extra = {}
        for key, prefixes in (("hp", ("mark-heather__", "mark-pyramid__")), ("sheet", ("hollow-pack__", "sh-pack__"))):
            cands = [extra_files[key]] if key in extra_files else [c for pre in prefixes for c in sorted((ASSETS / "_sources").glob(pre + "*"))]
            for c in cands:
                if c and c.is_file() and not c.is_symlink() and c.stat().st_size <= IN_MAX_BYTES:
                    with Image.open(c) as ii:
                        ii.load()
                        if ii.size == (1536, 1024):
                            extra[key] = ii.convert("RGB")
                            break
        if kind == "hollow-pack" and "hp" not in extra:
            raise ValueError("hollow-pack needs your Heather / Pyramid sheet too: --hp FILE (1536x1024)")
        extra.update({k: v for k, v in extra_files.items() if k in ("ink", "blood")})
        if gopt.get("light"):
            extra["light"] = True
        products = make_photo(kind, src, iris, extra)
    except ValueError as e:
        out({"error": f"rejected: {e}"}, 1)
    except Exception as e:
        out({"error": f"rejected: the picture cannot be read ({type(e).__name__})"}, 1)
    root = Path(tempfile.mkdtemp(prefix="ito-recipe-")) if dry else (apps_dir or ASSETS)
    report, written, refused = [], [], []
    try:
        for prel, img in products:
            m = _metrics(img)
            is_bar = split_bar(prel)[1] > 0 and kind != "relic-apps"     # apps: sizes 16-128 are not bar tiers, only the no-black-ground gate
            tile = re.match(r"^marks/(?:bar/\d+/)?tomie(?:-classic|\.v10)?(?:\.light)?\.png$", prel) is not None     # the opaque bone tile with real ink (S19b): fill and black are by design
            natural = kind == "pyramid-head" and re.match(r"^(?:marks/(?:bar/\d+/)?pyramid-head|workspaces/bar/\d+/ws-pyramid-)", prel) is not None     # S22/S23: the sprite's true deep shadows in theme tokens (the shader maps black to the theme's darkest colour), by design
            ok = tile or natural or m["black"] <= TONAL["black"] and (not is_bar or (kind == "ws-beetle" and ".v12" not in prel) or (m["fill"] <= TONAL["fill"] and (kind in CRISP_REPORT or ".v12" in prel or m["crisp"] >= TONAL["crisp"])))     # tonal families: crisp is report-only (as ws-tomie, S2d); fill and black are enforced
            report.append({"file": prel, "gate": "pass" if ok else "FAIL", **m})
            if not ok:
                refused.append(prel)
                continue
            dest = root / prel
            dest.parent.mkdir(parents=True, exist_ok=True)
            tmp = dest.with_name(dest.name + f".{os.getpid()}.tmp")
            img.save(tmp, format="PNG", optimize=True)
            os.replace(tmp, dest)
            written.append(prel)
        rejected = {}
        if dry:
            deadline = time.time() + BUDGET
            for prel in ([] if kind == "relic-apps" else written):
                try:
                    check(prel, root / prel, deadline)
                except ValueError as e:
                    rejected[prel] = str(e)
        else:
            if apps_dir is not None:
                import ito_gothic
                (apps_dir / "Ito-verse-icons-v2").mkdir(parents=True, exist_ok=True)
                (apps_dir / "Ito-verse-icons-v2" / "index.theme").write_text(ito_gothic.index_theme())
                rejected = {}
            else:
                if not nosrc:
                    keep = ASSETS / "_sources" / (f"{kind}__" + file.name + (file.suffix.lower() if not file.suffix else ""))
                    keep.parent.mkdir(parents=True, exist_ok=True)
                    shutil.copyfile(file, keep)
                idx = build()
                write(idx)
                rejected = {p: idx["rejected"][p] for p in written if p in idx["rejected"]}
    finally:
        if dry:
            shutil.rmtree(root, ignore_errors=True)
    worst = {}
    for r in report:
        px = split_bar(r["file"])[1] or 512
        w = worst.setdefault(px, {"crisp": 9, "fill": 0, "black": 0})
        w["crisp"], w["fill"], w["black"] = min(w["crisp"], r["crisp"]), max(w["fill"], r["fill"]), max(w["black"], r["black"])
    out({"ok": not rejected and bool(written) and not refused, "recipe": kind, "dry_run": dry, "files": len(written) if not dry else 0,
         "would_write": len(written) if dry else 0, "not_offered": refused, "rejected": rejected, "worst_per_tier": worst,
         "gate": [r for r in report if r["gate"] != "pass"]},
        0 if written and not rejected and not refused else 1)


SHEETS_SOURCES = {"tomie": ("tomie__", (1500, 2000)), "pyramid": ("pyramid-head__", (1254, 1254)), "sprites": ("sprites__", (1920, 1080))}


def cmd_sheets(argv):
    """ito-assets recipe sheets: the lock scenes and boot pictures (ito_sheets.py) from the user's HD pictures, written only to <assets>/lock/ and <assets>/cards/."""
    import shutil, tempfile
    files, only, dry, args = {}, None, False, list(argv)
    while args:
        a = args.pop(0)
        if a in ("--tomie", "--pyramid", "--sprites") and args:
            files[a[2:]] = Path(args.pop(0)).expanduser()
        elif a == "--only" and args:
            only = [k for k in args.pop(0).split(",") if k]
        elif a == "--dry-run":
            dry = True
        else:
            out({"error": "usage: ito-assets recipe sheets [--tomie FILE] [--pyramid FILE] [--sprites FILE] [--only KEY,...] [--dry-run]"}, 2)
    repo = ART.resolve().parents[2]
    if not dry and (ASSETS.resolve() == repo or repo in ASSETS.resolve().parents):
        out({"error": f"refused: {ASSETS} is inside {repo}; user pictures never go into a repo"}, 1)
    try:
        import numpy  # noqa: F401
        from PIL import Image
        import ito_sheets
    except ImportError:
        out({"error": "Pillow and numpy are needed for a recipe"}, 1)
    Image.MAX_IMAGE_PIXELS = int(MAX_PX)
    pics, used = {}, {}
    try:
        for key, (prefix, size) in SHEETS_SOURCES.items():
            cands = [files[key]] if key in files else sorted((ASSETS / "_sources").glob(prefix + "*"))
            for c in cands:
                if c.is_symlink() or not c.is_file() or c.stat().st_size > IN_MAX_BYTES:
                    if key in files:
                        raise ValueError(f"{c} is not a regular picture file of at most 32 MB")
                    continue
                with Image.open(c) as im:
                    if im.format not in ("PNG", "JPEG", "WEBP"):
                        raise ValueError(f"a {im.format} file is not accepted")
                    if im.size != size:
                        if key in files:
                            raise ValueError(f"the {key} picture is {size[0]}x{size[1]}; this is {im.size[0]}x{im.size[1]}")
                        continue
                    im.load()
                    pics[key], used[key] = im.convert("RGBA"), str(c)
                    break
        ito_sheets.set_sources(**pics)
        keys = only or ito_sheets.available()
        unknown = [k for k in keys if k not in ito_sheets.KEYS]
        if unknown:
            raise ValueError(f"unknown scene {unknown[0]!r}; scenes: {', '.join(ito_sheets.KEYS)}")
        if not keys:
            raise ValueError("no source picture found (tomie / pyramid-head / sprites in _sources, or pass --tomie / --pyramid / --sprites)")
        products = ito_sheets.products(keys)
    except ValueError as e:
        out({"error": f"rejected: {e}"}, 1)
    root = Path(tempfile.mkdtemp(prefix="ito-sheets-")) if dry else ASSETS
    written, report = [], []
    try:
        for rel, img in products:
            if not rel.startswith(("lock/", "cards/")) or ".." in rel:
                raise ValueError(rel)
            w, h = img.size
            report.append({"file": rel, "size": [w, h]} | ({"safe": ito_sheets.safe_report(img, w, h)} if rel.startswith("lock/") else {}))
            dest = root / rel
            dest.parent.mkdir(parents=True, exist_ok=True)
            tmp = dest.with_name(dest.name + f".{os.getpid()}.tmp")
            img.save(tmp, format="PNG", optimize=True)
            os.replace(tmp, dest)
            written.append(rel)
        if not dry:
            for key, path in used.items():          # the sources the recipe read are kept beside the others (never in a repo)
                p = Path(path)
                if p.parent != ASSETS / "_sources":
                    keep = ASSETS / "_sources" / (SHEETS_SOURCES[key][0] + p.name)
                    keep.parent.mkdir(parents=True, exist_ok=True)
                    shutil.copyfile(p, keep)
    finally:
        if dry:
            shutil.rmtree(root, ignore_errors=True)
    out({"ok": bool(written), "recipe": "sheets", "dry_run": dry, "files": 0 if dry else len(written), "would_write": len(written) if dry else 0,
         "target": str(ASSETS / "lock"), "cards_target": str(ASSETS / "cards"), "sources": used, "report": report}, 0 if written else 1)


def cmd_migrate_marks():
    """marks/remina-real{,.light}.png (+ marks/bar/<px>/) -> marks/remina{,.light}.png, once; never over an existing file."""
    moved = []
    if ASSETS.is_dir():
        for rel, p in walk():
            m = re.match(r"^(marks/(?:bar/\d+/)?)remina-real(\.light)?\.png$", rel)
            if not m:
                continue
            dst = ASSETS / (m.group(1) + "remina" + (m.group(2) or "") + ".png")
            if not dst.exists():
                os.replace(p, dst)
                moved.append(rel)
    return moved


def cmd_slots():
    idx = load_index() or {}
    have = idx.get("slots", {})
    out({"ok": True, "root": str(ASSETS), "slots": [
        {"slot": k, "canvas": [v[0], v[1]], "for": SLOT_USE.get(k, ""), "present": k in have, "light": k[:-4] + ".light.png" in have}
        for k, v in sorted(SLOTS.items())]})


def main(argv):
    cmd = argv[0] if argv else ""
    if cmd == "status":
        out(load_index() or {"version": 1, "files": {}, "rejected": {}})
    if cmd == "slots":
        cmd_slots()
    if cmd == "ingest":
        cmd_ingest(argv[1:])
    if cmd == "recipe" and argv[1:2] == ["sheets"]:
        cmd_sheets(argv[2:])
    if cmd == "recipe" and argv[1:2] and argv[1] in RECIPE_ALIASES:     # S24: the old recipe names still run, under the new ones
        argv[1] = RECIPE_ALIASES[argv[1]]
    if cmd == "recipe" and argv[1:2] and argv[1] in PHOTO_RECIPES:
        cmd_photo(argv[1:])
    if cmd == "recipe":
        cmd_recipe(argv[1:])
    if cmd == "migrate-marks":
        out({"ok": True, "moved": cmd_migrate_marks()})
    if cmd == "index":
        cmd_migrate_marks()
        old = load_index()
        if "--if-stale" in argv and old and old.get("sig") == signature(walk()):
            out({"ok": True, "unchanged": True, "files": len(old.get("files", {})), "rejected": len(old.get("rejected", {}))})
        try:
            idx = build()
            if not idx["files"] and not idx["rejected"] and old is None and not ASSETS.is_dir():
                idx["sig"] = signature([])
            write(idx)
        except Exception as e:      # never leave a half index: an empty one means the shipped art
            try:
                write({"version": 1, "root": str(ASSETS), "sig": "", "files": {}, "slots": {}, "rejected": {}, "warnings": {}, "error": f"{type(e).__name__}"})
            except OSError:
                pass
            out({"ok": False, "error": f"index failed: {type(e).__name__}"}, 1)
        out({"ok": True, "files": len(idx["files"]), "slots": len(idx["slots"]), "rejected": len(idx["rejected"]), "warnings": len(idx["warnings"])})
    out({"error": "usage: ito-assets index [--if-stale] | status | slots | ingest FILE --as SLOT [--light] | recipe --list | recipe lightink|lineart FILE --as REL [options]"}, 2)


if __name__ == "__main__":
    main(sys.argv[1:])
