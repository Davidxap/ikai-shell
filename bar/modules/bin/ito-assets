TOMIE_HD_SRC = (1500, 2000)                                          # the user's HD Tomie panel (class _TomieHD); the tomie / ws-tomie recipes take it as well as the Tommie drawing
PHOTO_SRC = {"spiral": (282, 282), "tomie": (565, 933), "uzumaki-eye": (1672, 941), "beetle": (920, 920), "ws-beetle": (920, 920), "ws-tomie": (565, 933),
