#!/usr/bin/env bash
# ito-fastfetch — Omarchy's own fastfetch (same modules, same colour names, so your terminal theme drives every colour),
# with your own picture as the logo.
#
# Three layouts are written next to your own fastfetch config; nothing you already have is changed unless you ask:
#   image    your picture (the _fastfetch slot of ito-marks) beside the machine's lines. Drawn with the kitty graphics
#            protocol (Ghostty, kitty). `ito-fastfetch run` shows it as text art in a terminal without that protocol
#            or over ssh. No picture: no image, no error.
#   compact  the same, a small picture and fewer lines
#   text     Omarchy's official logo, works in any terminal
#
# Usage: ito-fastfetch layouts                      the layouts and the files they are written to
#        ito-fastfetch apply [LAYOUT] [--set-default]
#                                                   write the layout (all three when none is named) to
#                                                   ~/.config/fastfetch/config-ito-<layout>.jsonc; with --set-default
#                                                   also make it your default config.jsonc (image when none is named),
#                                                   after saving the one you had under ~/.config/ito/backups/
#        ito-fastfetch fit                          measure the real About window and make it open hugging this content (a size
#                                                   rule, live and in ~/.config/hypr/ito-about.lua); Omarchy skips its own fit with a custom config
#        ito-fastfetch status                       what is installed, and whether a picture is set
#        ito-fastfetch run [LAYOUT]                 the real fastfetch with that layout, in Omarchy's own placement (nothing is centred or moved)
#        ito-fastfetch wrapper --uninstall|--status
#                                                   remove (or report) the launchers older versions wrote; fastfetch and About now run as Omarchy ships them
#        ito-fastfetch revert                       remove the generated files (and the About shadow and the wrapper) and give the default config back
#
# Ornaments (boot-lock-v2 §4): Omarchy's modules, keys and colour names stay; Ito only decorates the three frames (a kanji in the
# title, a katakana sound effect on the bottom rule), the key separator and, with `fetchLogo`, the logo:
#   fetchOrnaments  ito (default) | off      fetchLogo  omarchy | eye | picture (unset: the layout decides, as before)
# The picture logo type is decided at `apply` time from Omarchy's default terminal (`omarchy-default-terminal`, else TERM_PROGRAM / TERM):
# Ghostty and kitty get `kitty-direct` (the terminal draws the PNG itself, pixel-accurate); every other terminal gets `chafa` text art
# with its best quality settings. Never `auto` (it printed the PNG bytes in Alacritty). The placement is Omarchy's own.
#        ito-fastfetch preview [LAYOUT|--all]  a PNG of the fetch: the real fastfetch run offscreen with the same config, in your theme's colours
#        ito-fastfetch eye                     (re)write the eye logo ~/.config/ito/fetch/eye.txt (54 x 26, deterministic)
#
# Try one without changing anything else:  fastfetch -c ~/.config/fastfetch/config-ito-compact.jsonc
# Every command prints one JSON line and exits 0, or prints {"error": ...} and exits 1. Running apply twice with the
# same inputs changes nothing the second time.
set -euo pipefail
ITO_BIN_DIR="$(dirname "$(readlink -f "$0")")"
export ITO_BIN_DIR

python3 - "$@" <<'PY'
import json, os, re, sys, tempfile, time
from pathlib import Path

sys.path.insert(0, os.environ.get("ITO_BIN_DIR", "."))
HOME = Path(os.environ.get("HOME", "~")).expanduser()
FF = HOME / ".config" / "fastfetch"
BK = HOME / ".config" / "ito" / "backups"
MARKS = HOME / ".config" / "ito" / "marks"
DEFAULT = FF / "config.jsonc"

# Omarchy's own fastfetch config: the structure and the colouring (terminal colour names such as green/blue/magenta,
# so the terminal's theme drives every colour) are taken from it as they are; only the logo is replaced.
OFFICIAL = Path("/etc/fastfetch/config.jsonc")
LAYOUTS = ("image", "compact", "text")
ALIASES = {"text-only": "text"}
DEFAULT_LAYOUT = "image"
MARK = "// ito-verse: generated by ito-fastfetch; run `ito-fastfetch apply` to regenerate, `ito-fastfetch revert` to undo."
IMG_EXT = (".png", ".jpg", ".jpeg", ".webp", ".bmp")
FETCH_DIR = HOME / ".config" / "ito" / "fetch"
CACHE = HOME / ".cache" / "ito" / "fetch"
STYLE_PATH = Path(os.environ.get("ITO_STYLE_PATH") or HOME / ".config" / "omarchy" / "bar" / "modules" / "ito-style.json")
LOGO_FILE = HOME / ".config" / "omarchy" / "branding" / "about.txt"
FRAME_RE = re.compile(r"^\x1b\[90m[┌└]─+.*[┐┘]$")
SEPARATOR = " ┄ "
BOX_W = 54


def wide(ch):
    import unicodedata
    return 0 if unicodedata.combining(ch) else (2 if unicodedata.east_asian_width(ch) in "WF" else 1)


def columns(text):
    return sum(wide(c) for c in text)


def box(kind, title_kanji, key_sgr, title, left, right):
    """One ornamented frame line, exactly BOX_W display columns. kind 'top': a kanji in the box's key colour and the title;
    'bottom': a dim katakana sound effect near the right corner (the heartbeat in the one red)."""
    if kind == "top":
        text = f"┌{'─' * left} {title_kanji}  {title} {'─' * right}┐"
        fmt = f"\x1b[90m┌{'─' * left} \x1b[{key_sgr}m{title_kanji}\x1b[90m  {title} {'─' * right}┐"
    else:
        sfx, colour = title_kanji, key_sgr
        text = f"└{'─' * left} {sfx} {'─' * right}┘"
        fmt = f"\x1b[90m└{'─' * left} \x1b[0;{colour}m{sfx}\x1b[0;90m {'─' * right}┘"
    assert columns(text) == BOX_W, (text, columns(text))
    return fmt


# fetchStyle (S16c): a frame glyph set, three ornaments, three sound effects, a separator and colour ROLES (terminal colour names only, so
# the theme drives every colour). `ito` is today's look and keeps the box() above, byte for byte. Every line is exactly BOX_W columns.
BOX_TITLES = ("Hardware", "Software", "Age / Uptime / Update")
BOX_KEYC = (2, 4, 5)
STYLES = {
    "ito":        dict(label="Ito", note="Kanji on the boxes, a sound effect on each bottom rule.", sep=" ┄ ", sepc="90"),
    "rust":       dict(label="Silent Hill", note="Rusted plates, rivets, seepage stains.",
                       L="┏", R="┓", BL="┗", BR="┛", fill="━", sep=" ╍ ", orn=("錆", "霧", "鐘"), sfx=("░▒▓▒░", "░▒░", "▒▓▒"),
                       roles=dict(frame="33", orn="1;33", title="1;37", sfx="2;33", accent="31", sep="33"), deco=("◘", 15, "90"), caps=True),
    "otherworld": dict(label="Otherworld", note="Heavy plates, a rusted mesh, blood in the seams.",
                       L="▛", R="▜", BL="▙", BR="▟", fill="▀", bfill="▄", sep=" ╳ ", orn=("裏", "腐", "血"), sfx=("ジジ", "ザザ", "ドクン"),
                       roles=dict(frame="90", orn="31", title="37", sfx="2;31", accent="31", sep="2;31"), deco=("╳╳", 11, "2;31")),
    "chains":     dict(label="Chains", note="The boxes hang from chains with a red shackle.",
                       L="╭", R="╮", BL="╰", BR="╯", fill="─∞", sep=" ∞ ", orn=("鎖", "縛", "錠"), sfx=("ジャラ", "ギィ", "カチ"),
                       roles=dict(frame="90", orn="37", title="39", sfx="2", accent="31", sep="90"), deco=("⊕", 0, "31"), chains=True),
    "ink":        dict(label="Ito ink", note="Screentone rules and bold manga titles.",
                       L="⣴", R="⣦", BL="⠻", BR="⠟", fill="⠶", sep=" ⠶ ", orn=("渦", "髪", "呪"), sfx=("ゴゴゴ", "ゾワ", "ドクン"),
                       roles=dict(frame="90", orn="1;39", title="1;39", sfx="1;37", accent="31", sep="90"), deco=None),
    "eyes":       dict(label="Eyes", note="Eyes open along the top of every box, closed along the bottom.",
                       L="┌", R="┐", BL="└", BR="┘", fill="─", sep=" ◦ ", orn=("目", "視", "瞳"), sfx=("ジッ", "ジロ", "ギョロ"),
                       roles=dict(frame="90", orn="key", title="39", sfx="2", accent="31", sep="90"), deco=("◉", 13, "37"), bdeco=("◡", 12, "90")),
}
STYLE_KEYS = tuple(STYLES)


def style_key():
    v = style().get("fetchStyle", "ito")
    return v if v in STYLES else "ito"


def style_rule(key, kind, i):
    """One frame line of a style as an SGR string, exactly BOX_W columns (the width is asserted)."""
    S, titles = STYLES[key], BOX_TITLES
    R, keyc = S["roles"], BOX_KEYC[i]
    role = lambda r: (str(30 + keyc) if R[r] == "key" else R[r])
    fill, bfill = S["fill"], S.get("bfill") or S["fill"]
    if kind == "top":
        t = titles[i].upper() if S.get("caps") else titles[i]
        head = [(S["L"] + fill[0] * 2 + " ", role("frame")), (S["orn"][i], role("orn")), ("  " + t + " ", role("title"))]
        n = BOX_W - sum(columns(x) for x, _ in head) - 1
        segs = head + [((fill * BOX_W)[:n], role("frame")), (S["R"], role("frame"))]
        deco, at = S.get("deco"), -2
    else:
        sfx = S["sfx"][i]
        srole = "accent" if (i == 2 and sfx == "ドクン") else "sfx"
        tail = [(" " + sfx + " ", role(srole)), (bfill[0] * 3 + S["BR"], role("frame"))]
        n = BOX_W - 1 - sum(columns(x) for x, _ in tail)
        segs = [(S["BL"], role("frame")), ((bfill * BOX_W)[:n], role("frame"))] + tail
        deco = S.get("bdeco") or (S["deco"] if key in ("rust", "otherworld", "chains") else None)
        at = 1
    if deco:                                  # stamped into the long rule: (glyph, every n cols (0 = once, in the centre), sgr)
        g, every, col = deco
        txt, base = segs[at]
        cells = list(txt)
        pos = [len(cells) // 2] if every == 0 else list(range(every // 2, len(cells) - len(g), every))
        pieces, cur, j = [], "", 0
        while j < len(cells):
            if j in pos:
                if cur:
                    pieces.append((cur, base))
                    cur = ""
                pieces.append((g, col))
                j += len(g)
                continue
            cur += cells[j]
            j += 1
        if cur:
            pieces.append((cur, base))
        segs = segs[:at] + pieces + segs[at + 1:] if at == 1 else segs[:-2] + pieces + segs[-1:]
    w = sum(columns(x) for x, _ in segs)
    assert w == BOX_W, (key, kind, i, w)
    return "".join(f"\x1b[0;{c}m{x}" for x, c in segs) + "\x1b[0m"


def style_separator():
    k = style_key()
    return STYLES[k]["sep"], (STYLES[k].get("sepc") or STYLES[k]["roles"]["sep"])


ORN_TOPS = [box("top", "骸", "32", "Hardware", 19, 19), box("top", "呪", "34", "Software", 19, 19),
            box("top", "刻", "35", "Age / Uptime / Update", 12, 13)]
ORN_BOTTOMS = [box("bottom", "ギギ", "2", "", 42, 4), box("bottom", "ズズ", "2", "", 42, 4), box("bottom", "ドクン", "31", "", 40, 4)]


STYLE_OVERRIDE = {}                          # `preview --style/--picture` try a value without writing it


def style():
    try:
        d = json.loads(STYLE_PATH.read_text())
    except (OSError, ValueError):
        d = {}
    return {**d, **STYLE_OVERRIDE} if STYLE_OVERRIDE else d


def out(obj, code=0):
    print(json.dumps(obj))
    sys.exit(code)


def fail(message):
    out({"error": message}, 1)


def slot_picture():
    """The picture in the _fastfetch slot, or None. A file that is not an image stops the run and names the slot."""
    for ext in IMG_EXT:
        f = MARKS / ("_fastfetch" + ext)
        if f.is_file():
            try:
                from PIL import Image
                with Image.open(f) as im:
                    im.verify()
            except ImportError:
                pass
            except Exception:
                fail("slot _fastfetch: the picture is corrupt or not an image; choose another one (ito-marks pick --as _fastfetch)")
            return f
    return None


def official():
    """Omarchy's official fastfetch config, parsed (whole-line // comments dropped)."""
    try:
        text = OFFICIAL.read_text()
    except OSError:
        fail(f"Omarchy's fastfetch config {OFFICIAL} is not readable")
    try:
        return json.loads("\n".join(l for l in text.splitlines() if not l.lstrip().startswith("//")))
    except ValueError:
        fail(f"Omarchy's fastfetch config {OFFICIAL} is not valid JSON")


# compact keeps the official boxes, frames and colours, with fewer lines: the modules of these types only.
COMPACT_TYPES = ("host", "cpu", "gpu", "memory", "kernel", "wm", "terminal")


def ornament(mods):
    """The official frame lines replaced, by position (1st/2nd/3rd top and bottom), and whether it was possible. If
    Omarchy's config changed shape (a different count of frame lines), the official lines stay as they are."""
    idx = [(i, m["format"]) for i, m in enumerate(mods) if isinstance(m, dict) and m.get("type") == "custom"
           and FRAME_RE.match(m.get("format", ""))]
    tops = [i for i, f in idx if "┌" in f]
    bottoms = [i for i, f in idx if "└" in f]
    if len(tops) != 3 or len(bottoms) != 3:
        return mods, False
    out = [dict(m) if isinstance(m, dict) else m for m in mods]
    key = style_key()
    for pos, i in enumerate(tops):
        out[i]["format"] = ORN_TOPS[pos] if key == "ito" else style_rule(key, "top", pos)
    for pos, i in enumerate(bottoms):
        out[i]["format"] = ORN_BOTTOMS[pos] if key == "ito" else style_rule(key, "bottom", pos)
    return out, True


def eye_file():
    f = FETCH_DIR / "eye.txt"
    return f if f.is_file() else None


def logo_choice(layout, picture):
    """(mode, why): omarchy | eye | picture | none. `fetchLogo` wins; unset, the layout decides as it always did."""
    want = style().get("fetchLogo")
    if want == "eye":
        if not eye_file():
            try:
                FETCH_DIR.mkdir(parents=True, exist_ok=True)
                write_atomic(FETCH_DIR / "eye.txt", eye_text()[0])      # deterministic, so this is the same file `eye` writes
            except Exception:
                pass
        return ("eye", "") if eye_file() else ("omarchy", "eye_missing")
    if want == "picture":
        return ("picture", "") if picture is not None else ("omarchy", "picture_missing")
    if want == "omarchy":
        return "omarchy", ""
    if layout == "text":
        return "omarchy", ""
    return ("picture", "") if picture is not None else ("none", "")


NOTES = {}


def terminal_name():
    """The default terminal as a lowercase word (ghostty, kitty, alacritty, foot...) or ''. Omarchy's own choice first, then the environment
    of whoever runs us (a terminal we are started from), so a shell without TERM_PROGRAM still decides the right way."""
    import shutil
    import subprocess
    override = os.environ.get("ITO_FETCH_TERMINAL")
    if override:
        return override.lower()
    exe = shutil.which("omarchy-default-terminal")
    if exe:
        try:
            r = subprocess.run([exe], capture_output=True, text=True, timeout=5)
            name = r.stdout.strip().lower()
            if r.returncode == 0 and name:
                return name.removesuffix(".desktop").rsplit(".", 1)[-1]
        except (OSError, subprocess.SubprocessError):
            pass
    env = os.environ
    if env.get("KITTY_WINDOW_ID") or "kitty" in env.get("TERM", ""):
        return "kitty"
    return (env.get("TERM_PROGRAM") or "").lower()


GRAPHICS_TERMINALS = ("ghostty", "kitty")


def logo_source(picture):
    """The file the terminal draws: your picture as it is, or, with `fetchPicture` engraving (the Control Centre's toggle), its transparent
    engraving baked once into the cache, so the real fastfetch shows what the preview shows. A bake that fails is the photo."""
    if style().get("fetchPicture", "photo") != "engraving":
        return picture
    try:
        cols_, _i = COL.resolve()
        light_ = lum(cols_["ink"]) > lum(cols_["bone"])
        pol = style().get("fetchPicturePolarity", "auto")
        baked, _mode = FET.bake_engraving(picture, pol if pol in FET.POLARITIES else "auto", light_)
        from PIL import Image
        bone = cols_["bone"].lstrip("#")
        rgb = tuple(int(bone[i:i + 2], 16) for i in (0, 2, 4))
        with Image.open(baked) as im:                               # the baked ink is white: lay it in the theme's bone colour
            alpha = im.convert("RGBA").getchannel("A")
        tinted = Image.new("RGBA", alpha.size, rgb + (255,))
        tinted.putalpha(alpha)
        stable = FETCH_DIR / "logo-engraving.png"                   # a path that survives a cache clean (the config names it)
        FETCH_DIR.mkdir(parents=True, exist_ok=True)
        tmp = stable.with_name(stable.name + ".tmp")
        tinted.save(tmp, format="PNG")
        if not stable.is_file() or stable.read_bytes() != tmp.read_bytes():
            os.replace(tmp, stable)
        else:
            tmp.unlink()
        return stable
    except Exception:
        return picture


def picture_logo(picture, small, pad):
    """The picture logo block: the kitty graphics protocol where the terminal has it, chafa text art otherwise. Sizes are in cells
    (20 x 10 / 40 x 20: a square, since a cell is about twice as tall as wide)."""
    w, h = (20, 10) if small else (40, 20)
    picture = logo_source(picture)
    if terminal_name() in GRAPHICS_TERMINALS:
        return {"type": "kitty-direct", "source": str(picture), "width": w, "height": h, "preserveAspectRatio": True, "padding": pad}
    return {"type": "chafa", "source": str(picture), "width": w, "height": h, "preserveAspectRatio": True,
            "chafa": {"fgOnly": False, "symbols": "all", "canvasMode": "TRUECOLOR", "colorSpace": "DIN99D", "ditherMode": "NONE"},
            "padding": pad}


def picture_sig(picture):
    """The picture's identity for the inputs hash, so a new picture in the slot makes the applied config stale."""
    try:
        st = Path(picture).stat()
        return f"{st.st_mtime_ns}:{st.st_size}"
    except (OSError, TypeError):
        return ""


def render(layout, picture):
    cfg = official()
    mods = cfg.get("modules", [])
    NOTES.clear()
    if style().get("fetchOrnaments", "ito") != "off":
        mods, done = ornament(mods)
        if not done:
            NOTES["ornaments_skipped"] = True
    if layout == "compact":
        def keep(m):
            if isinstance(m, str):
                return True
            t, cmd = m.get("type"), m.get("text", "")
            if t == "command":
                return cmd.startswith("version=")                      # the Omarchy version line only
            return t == "custom" or t in COMPACT_TYPES
        kept, skip = [], False
        for m in mods:
            fmt = m.get("format", "") if isinstance(m, dict) else ""
            if "Age / Uptime" in fmt:
                skip = True                                            # the whole third box
            if not skip and keep(m):
                kept.append(m)
        mods = kept
    cfg["modules"] = mods
    if style().get("fetchOrnaments", "ito") != "off":
        disp = dict(cfg.get("display", {}))
        sep, sepc = style_separator()
        disp["separator"] = sep
        disp["color"] = {**disp.get("color", {}), "separator": sepc}
        cfg["display"] = disp
    mode, why = logo_choice(layout, picture)
    if why:
        NOTES["logo_fallback"] = why
    pad = {"top": 2, "left": 2, "right": 6}
    if mode == "picture":
        small = layout == "compact"
        cfg["logo"] = picture_logo(picture, small, {"top": 1, "left": 1, "right": 4} if small else pad)
    elif mode == "eye":
        cfg["logo"] = {"type": "file", "source": str(eye_file()), "color": {"1": "white", "2": "red", "3": "90"}, "padding": pad}
    elif mode == "omarchy":
        pass                                                        # the official logo, as Omarchy draws it
    else:
        cfg["logo"] = {"type": "none"}
    body = json.dumps(cfg, indent=2, ensure_ascii=False) + "\n"
    sig = picture_sig(picture) + ":" + picture_sig(logo_source(picture)) if mode == "picture" else ""
    sig += style().get("fetchPicture", "photo") if mode == "picture" else ""
    return MARK + "\n" + f"// ito-inputs: {inputs_of(body + sig)}\n" + body


def inputs_of(body):
    """sha12 of the rendered JSON (the header lines are not part of it)."""
    import hashlib
    return hashlib.sha1(body.encode()).hexdigest()[:12]


def body_of(text):
    return "\n".join(l for l in (text or "").splitlines() if not l.lstrip().startswith("//")) + "\n"


def write_atomic(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=path.name + ".")
    with os.fdopen(fd, "w") as fh:
        fh.write(text)
    os.replace(tmp, path)


def read(path):
    try:
        return path.read_text()
    except OSError:
        return None


def ours(text):
    return text is not None and text.startswith(MARK)


def stamp():
    return time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())


def backup(path, text):
    """Keep a timestamped copy of a file that is about to be replaced; the first one ever is also the .orig."""
    BK.mkdir(parents=True, exist_ok=True)
    (BK / f"{path.name}.{stamp()}").write_text(text)
    orig, absent = BK / f"{path.name}.orig", BK / f"{path.name}.orig.absent"
    if not orig.exists():
        orig.write_text(text)
        absent.unlink(missing_ok=True)


def normalise(name):
    name = ALIASES.get(name, name)
    if name not in LAYOUTS:
        fail(f"unknown layout {name!r}; valid layouts: {', '.join(LAYOUTS)}")
    return name


def target(layout):
    return FF / f"config-ito-{layout}.jsonc"


def cmd_layouts():
    out({"layouts": [{"name": l, "file": str(target(l))} for l in LAYOUTS], "default": DEFAULT_LAYOUT})


STYLE = HOME / ".config" / "omarchy" / "bar" / "modules" / "ito-style.json"


def saved_layout():
    try:
        v = json.loads(STYLE.read_text()).get("fastfetchLayout")
    except (OSError, ValueError, AttributeError):
        v = None
    return v if v in LAYOUTS else DEFAULT_LAYOUT


def libchafa_missing():
    """fastfetch dlopens libchafa for the chafa logo; without it the logo silently falls back to Omarchy's about logo."""
    if terminal_name() in GRAPHICS_TERMINALS:
        return False                                                # kitty-direct needs no libchafa
    import glob
    return not glob.glob("/usr/lib/libchafa*") and not glob.glob("/usr/lib64/libchafa*")


CHAFA_FIX = "libchafa is not installed, so the image logo falls back to Omarchy's logo. Fix: sudo pacman -S chafa"


def cmd_status():
    """v2 (boot-lock-v2 §2.2): state, what was applied and when, the inputs hash now, issues. Writes nothing."""
    pic = None
    for ext in IMG_EXT:
        if (MARKS / ("_fastfetch" + ext)).is_file():
            pic = MARKS / ("_fastfetch" + ext)
            break
    cur = read(DEFAULT)
    issues, state, applied = [], "off", None
    layout = saved_layout()
    try:
        mm = re.search(r"^// ito-inputs: ([0-9a-f]{12})\s*$", render(layout, pic), re.M)
        current = mm.group(1) if mm else None
    except SystemExit:
        current = None
    if ours(cur):
        m = re.search(r"^// ito-inputs: ([0-9a-f]{12})\s*$", cur, re.M)
        try:
            mt = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(DEFAULT.stat().st_mtime))
        except OSError:
            mt = None
        applied = {"layout": layout, "at": mt, "inputs": m.group(1) if m else None}
        try:
            json.loads(body_of(cur))
            valid = True
        except ValueError:
            valid = False
        missing = [l for l in LAYOUTS if not target(l).is_file()]
        if not valid:
            state = "error"
            issues.append({"code": "invalid", "level": "warn", "text": "config.jsonc is not valid JSON any more."})
        elif missing:
            state = "partial"
            issues.append({"code": "layouts_missing", "level": "warn", "text": "Missing layouts: " + ", ".join(missing) + "."})
        elif applied["inputs"] != current:
            state = "stale"
        else:
            state = "on"
    if layout == "image" and libchafa_missing():
        issues.append({"code": "libchafa_missing", "level": "warn", "text": CHAFA_FIX})
    out({"ok": True, "surface": "terminal", "state": state, "engine": "fastfetch", "applied": applied,
         "current_inputs": current, "issues": issues,
         "picture": str(pic) if pic else "",
         "installed": {l: target(l).is_file() for l in LAYOUTS},
         "default": "ito" if ours(cur) else ("yours" if DEFAULT.exists() else "none")})


def cmd_apply(args):
    names, set_default = [], False
    for a in args:
        if a == "--set-default":
            set_default = True
        elif a.startswith("-"):
            fail(f"unknown option {a!r}; usage: ito-fastfetch apply [LAYOUT] [--set-default]")
        else:
            names.append(normalise(a))
    if len(names) > 1:
        fail("name one layout, or none for all three")
    chosen = names or list(LAYOUTS)
    picture = slot_picture()
    result, notice = {}, ""
    if "image" in chosen and picture is None:
        notice = "The _fastfetch slot is empty, so the image layout shows no picture. Choose one with: ito-marks pick --as _fastfetch"
        print("ito-fastfetch: " + notice, file=sys.stderr)
    for layout in chosen:
        text = render(layout, picture)
        f = target(layout)
        current = read(f)
        if current == text:
            result[layout] = "unchanged"
            continue
        if current is not None and not ours(current):
            backup(f, current)                                      # a file of yours with the same name
        write_atomic(f, text)
        result[layout] = "written"
    reply = {"ok": True, "layouts": result}
    if "image" in chosen and libchafa_missing():
        reply["warning"] = CHAFA_FIX
        print("ito-fastfetch: " + CHAFA_FIX, file=sys.stderr)
    if not set_default:                                  # the default config is a copy of the saved layout: an apply that redraws that
        cur_default = read(DEFAULT)                      # layout redraws our copy too, or `status` reports it out of date forever
        keep = saved_layout()
        if cur_default is not None and ours(cur_default) and keep in chosen:
            text = render(keep, picture)
            if cur_default != text:
                write_atomic(DEFAULT, text)
                reply["default"] = keep
    if set_default:
        layout = names[0] if names else DEFAULT_LAYOUT
        text = render(layout, picture)
        current = read(DEFAULT)
        if current == text:
            reply["default"] = "unchanged"
        else:
            if current is not None and not ours(current):
                backup(DEFAULT, current)
            elif current is None and not (BK / "config.jsonc.orig").exists():
                BK.mkdir(parents=True, exist_ok=True)
                (BK / "config.jsonc.orig.absent").write_text("there was no config.jsonc before ito-fastfetch\n")
            write_atomic(DEFAULT, text)
            reply["default"] = layout
    if notice:
        reply["notice"] = notice
    out(reply)


def strip_ansi(text):
    text = re.sub(r"\x1b_.*?\x1b\\", "", text, flags=re.S)
    return re.sub(r"\x1b\[[0-9;?]*[a-zA-Z]", "", text)


# ---- logo choice and the preview inputs ------------------------------------------------------------------------------

import ito_colours as COL
import ito_fetch as FET

ASSETS_DIR = Path(os.environ.get("ITO_ASSETS_DIR") or HOME / ".config" / "ito" / "assets")
ASSETS_INDEX = Path(os.environ.get("ITO_ASSETS_INDEX") or HOME / ".cache" / "ito" / "assets-index.json")
OMARCHY_BIN = Path(os.environ.get("OMARCHY_PATH") or "/usr/share/omarchy") / "bin"
STATE = HOME / ".local" / "state" / "ito"
SHADOW = Path(os.environ.get("ITO_ABOUT_SHADOW") or HOME / ".local" / "bin" / "omarchy-launch-about")
SHADOW_MARK = "# ito-verse: generated by `ito-fastfetch about --install`; remove with `ito-fastfetch about --uninstall`."
REAL_FASTFETCH = os.environ.get("ITO_REAL_FASTFETCH") or ("/usr/bin/fastfetch" if os.access("/usr/bin/fastfetch", os.X_OK) else "fastfetch")
WRAPPER = Path(os.environ.get("ITO_FETCH_WRAPPER") or HOME / ".local" / "bin" / "fastfetch")
WRAPPER_MARK = "# ito-verse: generated by `ito-fastfetch wrapper --install`; remove with `ito-fastfetch wrapper --uninstall` or `ito-fastfetch revert`."
EYE_COLOURS = {"1": "white", "2": "red", "3": "90"}


def lum(hex_colour):
    h = hex_colour.lstrip("#")
    return 0.2126 * int(h[0:2], 16) + 0.7152 * int(h[2:4], 16) + 0.0722 * int(h[4:6], 16)


def user_assets_on():
    return style().get("userAssets", True) not in (False, "false", "0", 0, "off")


def user_slot(rel):
    """~/.config/ito/assets/<rel> when the index lists it as a valid slot, else None. A file that is there but not indexed yet is
    indexed once (ito-assets index --if-stale)."""
    if not user_assets_on() or not (ASSETS_DIR / rel).is_file():
        return None
    def listed():
        try:
            return rel in json.loads(ASSETS_INDEX.read_text()).get("slots", {})
        except (OSError, ValueError):
            return False
    if not listed():
        import subprocess
        subprocess.run([sys.executable, "-I", str(Path(os.environ.get("ITO_BIN_DIR", ".")) / "ito-assets"), "index", "--if-stale"],
                       capture_output=True, timeout=30)
    return ASSETS_DIR / rel if listed() else None


def about_logo_colours():
    try:
        return official().get("logo", {}).get("color") or {"1": "green"}
    except SystemExit:
        return {"1": "green"}


def resolve_logo(layout, picture):
    """(logo, why): the first valid of boot-screens-v2 A.3.3 -- your fetch/logo.png, the eye (fetchLogo eye), your _fastfetch picture,
    Omarchy's logo -- and None when the layout shows no logo. The `text` layout keeps Omarchy's logo unless fetchLogo says otherwise."""
    want = style().get("fetchLogo")
    mode, why = logo_choice(layout, picture)
    try:
        if layout != "text" or want:
            slot = user_slot("fetch/logo.png")
            if slot:
                light = ASSETS_DIR / "fetch" / "logo.light.png"
                return FET.ImageLogo(slot, light if light.is_file() else None, "image", "fetch/logo"), why
        if mode == "eye":
            if user_assets_on():
                dark = ASSETS_DIR / "eye" / "spiral-eye-ink-for-dark-themes.png"
                light = ASSETS_DIR / "eye" / "spiral-eye-ink-for-light-themes.png"
                if dark.is_file():
                    try:
                        return FET.ImageLogo(dark, light if light.is_file() else None, "image", "eye"), why
                    except Exception:
                        why = why or "eye_asset_unreadable"
            if eye_file():
                return FET.TextLogo(read(eye_file()) or "", EYE_COLOURS, "eye"), why
            mode = "omarchy"
        if mode == "picture" and picture is not None:
            if style().get("fetchPicture", "photo") == "engraving":
                try:
                    cols_, _i = COL.resolve()
                    light_ = lum(cols_["ink"]) > lum(cols_["bone"])
                    pol = style().get("fetchPicturePolarity", "auto")
                    baked, bmode = FET.bake_engraving(picture, pol if pol in FET.POLARITIES else "auto", light_)
                    return FET.ImageLogo(baked, None, "engraving", "engraving", engrave=(bmode == "engrave")), why
                except Exception as e:
                    why = why or f"engraving_failed:{type(e).__name__}"      # the photo, as before
            return FET.ImageLogo(picture, None, "picture", "picture"), why
        if mode == "omarchy":
            return FET.TextLogo(read(LOGO_FILE) or "", about_logo_colours(), "omarchy"), why
    except Exception as e:
        why = why or f"logo_unreadable:{type(e).__name__}"
        try:
            return FET.TextLogo(read(LOGO_FILE) or "", about_logo_colours(), "omarchy"), why
        except Exception:
            return None, why
    return None, why


def dims(lines):
    return max((FET.columns(FET.strip_ansi(l).rstrip()) for l in lines), default=0), len(lines)


def legacy_remove(path, mark, label):
    """Older installs wrote a launcher (the About shadow, the `fastfetch` wrapper). Ours are removed on `revert`; a foreign file is left alone."""
    cur = read(path)
    if cur is None:
        return "absent"
    if not cur.startswith("#!/bin/bash\n" + mark):
        return "foreign"
    path.unlink()
    return "removed"


def cmd_wrapper(args):
    """`wrapper --uninstall | --status`: only to clean up the launchers older versions wrote. Omarchy's own fastfetch and About run untouched."""
    if "--uninstall" in args:
        out({"ok": True, "about_shadow": legacy_remove(SHADOW, SHADOW_MARK, "shadow"), "fastfetch_wrapper": legacy_remove(WRAPPER, WRAPPER_MARK, "wrapper")})
    state = lambda p, m: (lambda c: "absent" if c is None else ("legacy" if c.startswith("#!/bin/bash\n" + m) else "foreign"))(read(p))
    out({"ok": True, "about_shadow": state(SHADOW, SHADOW_MARK), "fastfetch_wrapper": state(WRAPPER, WRAPPER_MARK)})


def cmd_run(args):
    """Show a layout now with the real fastfetch, in Omarchy's own placement (nothing is centred or moved)."""
    names = [a for a in args if not a.startswith("-")][:1]
    layout = normalise(names[0]) if names else saved_layout()
    f = target(layout)
    if not f.is_file():
        fail(f"{f} is not written yet; run: ito-fastfetch apply {layout}")
    os.execv(REAL_FASTFETCH, [REAL_FASTFETCH, "-c", str(f)]) if os.path.isabs(REAL_FASTFETCH) else os.execvp(REAL_FASTFETCH, [REAL_FASTFETCH, "-c", str(f)])


def cmd_revert():
    removed = []
    for l in LAYOUTS:
        f = target(l)
        if ours(read(f)):
            f.unlink()
            removed.append(f.name)
    state = "untouched"
    cur = read(DEFAULT)
    if ours(cur):
        orig, absent = BK / "config.jsonc.orig", BK / "config.jsonc.orig.absent"
        if orig.is_file():
            write_atomic(DEFAULT, orig.read_text())
            state = "restored"
        elif absent.exists():
            DEFAULT.unlink()
            state = "removed"
        else:
            state = "kept (no backup to restore)"
    if ABOUT_RULE_FILE.is_file() and ABOUT_RULE_MARK in read(ABOUT_RULE_FILE):
        ABOUT_RULE_FILE.unlink()
        removed.append(ABOUT_RULE_FILE.name)
        if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
            hypr_eval(f"if {ABOUT_RULE_VAR} then {ABOUT_RULE_VAR}:set_enabled(false) end; {ABOUT_RULE_VAR} = nil")
    out({"ok": True, "removed": removed, "default": state, "about_shadow": legacy_remove(SHADOW, SHADOW_MARK, "shadow"),
         "fastfetch_wrapper": legacy_remove(WRAPPER, WRAPPER_MARK, "wrapper")})



# ---- About window size (omarchy-launch-about skips its own size fitting when ~/.config/fastfetch/config.jsonc exists) --

ABOUT_CLASS = "org.omarchy.about"
ABOUT_RULE_FILE = HOME / ".config" / "hypr" / "ito-about.lua"
ABOUT_RULE_MARK = "-- ito-verse: generated by `ito-fastfetch fit`; removed by `ito-fastfetch revert`."
ABOUT_RULE_VAR = "ito_about_size_rule"


def about_content_cells(config_text):
    """Columns and rows About needs: the logo block as the config places it, the modules beside it, one cursor row."""
    import subprocess
    try:
        cfg = json.loads(body_of(config_text))
    except ValueError:
        fail("config.jsonc is not valid JSON; run: ito-fastfetch apply --set-default")
    logo = cfg.get("logo") or {}
    pad = logo.get("padding") or {}
    logo_w, logo_h = int(logo.get("width", 0)), int(logo.get("height", 0))
    shown = subprocess.run([REAL_FASTFETCH, "--logo", "none"], capture_output=True, text=True, timeout=30).stdout
    lines = strip_ansi(shown).split("\n")
    if lines and lines[-1] == "":
        lines.pop()
    mod_w = max((columns(l) for l in lines), default=0)
    cols = int(pad.get("left", 0)) + logo_w + int(pad.get("right", 0)) + mod_w + 2
    rows = max(logo_h + int(pad.get("top", 0)), len(lines)) + 1
    return cols, rows


def about_rule_lua(w, h, mark=True):
    return ((ABOUT_RULE_MARK + "\n" if mark else "") +   # hyprctl reads a leading "--" as a flag, so the live copy has no comment
            f'if {ABOUT_RULE_VAR} then {ABOUT_RULE_VAR}:set_enabled(false) end\n'
            f'{ABOUT_RULE_VAR} = hl.window_rule({{ match = {{ class = "{ABOUT_CLASS}" }}, size = {{ {w}, {h} }} }})\n')


def hypr_eval(lua):
    import subprocess
    return subprocess.run(["hyprctl", "eval", lua], capture_output=True, text=True).returncode == 0


def about_client():
    import subprocess
    try:
        r = subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True, timeout=10)
        for c in json.loads(r.stdout):
            if c.get("class") == ABOUT_CLASS:
                return c
    except (OSError, ValueError, subprocess.SubprocessError):
        pass
    return None


def about_tty(pid):
    """The pty of the terminal inside the About window: the first descendant of the window process with a /dev/pts stdin."""
    todo, seen = [pid], set()
    while todo:
        p = todo.pop()
        if p in seen:
            continue
        seen.add(p)
        try:
            tty = os.readlink(f"/proc/{p}/fd/0")
            if tty.startswith("/dev/pts/"):
                return tty
        except OSError:
            pass
        try:
            for t in os.listdir(f"/proc/{p}/task"):                  # a child belongs to the thread that forked it
                todo += [int(x) for x in Path(f"/proc/{p}/task/{t}/children").read_text().split()]
        except (OSError, ValueError):
            pass
    return None


def tty_grid(tty):
    import subprocess
    r = subprocess.run(["stty", "-F", tty, "size"], capture_output=True, text=True)
    try:
        rows, cols = map(int, r.stdout.split())
        return rows, cols
    except ValueError:
        return 0, 0


def cmd_fit(args):
    """Measure the real About window and make it open hugging our content: a size rule (live now, and in
    ~/.config/hypr/ito-about.lua for the next Hyprland start). Opens About if it is not open, and closes it again."""
    import subprocess
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        fail("no Hyprland session; run ito-fastfetch fit from the desktop")
    cur = read(DEFAULT)
    if not ours(cur):
        fail("config.jsonc is not ours; About sizes itself when there is no Ito config (run: ito-fastfetch apply --set-default)")
    cols_t, rows_t = about_content_cells(cur)
    opened = False
    client = about_client()
    if client is None:
        subprocess.Popen(["omarchy-launch-about"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
        opened = True
        for _ in range(60):
            time.sleep(0.1)
            client = about_client()
            if client:
                break
    if client is None:
        fail("About did not open")
    time.sleep(1.0)
    result = None
    try:
        tty = None
        for _ in range(100):
            client = about_client() or client
            tty = about_tty(client["pid"])
            if tty:
                break
            time.sleep(0.1)
        if not tty:
            fail("could not find the About terminal")
        addr = client["address"]
        for _ in range(4):
            client = about_client()
            if client is None:
                fail("the About window went away while measuring")
            w, h = client["size"]
            rows, cols = tty_grid(tty)
            if rows <= 0 or cols <= 0:
                fail("could not read the About terminal size")
            if cols_t <= cols <= cols_t + 1 and rows_t <= rows <= rows_t + 1:
                result = (w, h, cols, rows)
                break
            sw, sh = (cols_t - cols) * w, (rows_t - rows) * h
            nw = w + (-(-sw // cols) if sw >= 0 else -((-sw) // cols))
            nh = h + (-(-sh // rows) if sh >= 0 else -((-sh) // rows))
            hypr_eval(f'hl.dispatch(hl.dsp.window.resize({{ window = "address:{addr}", x = {nw}, y = {nh} }}))')
            last = None
            for _ in range(20):                      # wait for the animated resize and the reflow to hold still
                time.sleep(0.1)
                now = tty_grid(tty)
                if now == last:
                    break
                last = now
    finally:
        if opened:
            c = about_client()
            if c:
                hypr_eval(f'hl.dispatch(hl.dsp.window.close({{ window = "address:{c["address"]}" }}))')
    if result is None:
        fail(f"About did not settle on {cols_t}x{rows_t} cells")
    w, h, cols, rows = result
    ABOUT_RULE_FILE.parent.mkdir(parents=True, exist_ok=True)
    write_atomic(ABOUT_RULE_FILE, about_rule_lua(w, h))
    live = hypr_eval(about_rule_lua(w, h, mark=False))
    user_cfg = read(HOME / ".config" / "hypr" / "hyprland.lua") or ""
    out({"ok": True, "cells": [cols_t, rows_t], "window": [w, h], "grid": [cols, rows], "rule_file": str(ABOUT_RULE_FILE),
         "live_rule": live, "loaded_at_start": "hypr.ito-about" in user_cfg})


# ---- the eye logo (boot-lock-v2 §4.3): drawn by ito_art.py (shared with the screensaver) ------------------------------

sys.path.insert(0, os.environ.get("ITO_BIN_DIR", "."))
import ito_art as ART
