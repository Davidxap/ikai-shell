# ---- the preview: the REAL fastfetch, run in an offscreen pty and rasterised (same config, same picture, same output) ----

SGR_NAMES = {"black": 0, "red": 1, "green": 2, "yellow": 3, "blue": 4, "magenta": 5, "cyan": 6, "white": 7}


def theme_path(name=None):
    if name:
        for base in (HOME / ".config" / "omarchy" / "themes", Path("/usr/share/omarchy/themes")):
            if (base / name / "colors.toml").is_file():
                return base / name / "colors.toml"
        fail(f"no theme named {name!r}")
    return Path(os.environ.get("ITO_THEME_COLORS") or HOME / ".local" / "state" / "omarchy" / "current" / "theme" / "colors.toml")


def theme_palette(path=None):
    """background, foreground and the 16 terminal colours of a theme's colors.toml (what the terminal shows; default: the current theme)."""
    path = path or theme_path()
    t = read(path) or ""
    def get(key):
        m = re.search(rf'^\s*{key}\s*=\s*"(#[0-9A-Fa-f]{{6}})"', t, re.M)
        return m.group(1) if m else None
    pal = {"bg": get("background"), "fg": get("foreground"), "c": [get(f"color{i}") for i in range(16)]}
    return pal


PTY_SCRIPT = r"""
import fcntl, os, pty, select, struct, sys, termios, time
cfg, ff, cols, rows, timeout = sys.argv[1], sys.argv[2], int(sys.argv[3]), int(sys.argv[4]), float(sys.argv[5])
pid, fd = pty.fork()
if pid == 0:
    os.environ.update({"TERM": "xterm-ghostty", "TERM_PROGRAM": "ghostty", "COLORTERM": "truecolor", "COLUMNS": str(cols), "LINES": str(rows)})
    try:
        os.execvp(ff, [ff, "-c", cfg])
    finally:
        os._exit(127)
fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", rows, cols, cols * 10, rows * 20))
out, end = sys.stdout.buffer, time.time() + timeout
while time.time() < end:
    r, _, _ = select.select([fd], [], [], 0.5)
    if not r:
        continue
    try:
        d = os.read(fd, 65536)
    except OSError:
        break
    if not d:
        break
    out.write(d)
out.flush()
try:
    os.waitpid(pid, 0)
except ChildProcessError:
    pass
"""


def run_offscreen(config_path, cols=160, rows=60, timeout=25):
    """The bytes the real fastfetch writes to a terminal of cols x rows when given config_path (a pty; nothing is shown).
    The pty's parent is a python copy named `ghostty` (in the cache), so fastfetch's Terminal lines read as they do in About."""
    import subprocess
    CACHE.mkdir(parents=True, exist_ok=True)
    name = CACHE / "ghostty"
    exe = os.path.realpath(sys.executable)
    if not name.is_file() or name.stat().st_size != os.stat(exe).st_size:
        import shutil
        tmp = name.with_name(f"ghostty.{os.getpid()}.tmp")
        shutil.copy2(exe, tmp)
        os.replace(tmp, name)
    # two layers: fastfetch skips its direct parent when looking for the terminal, as it does for the shell in a real terminal
    wrap = "import subprocess, sys; sys.stdout.buffer.write(subprocess.run([sys.argv[1], '-I', '-c', *sys.argv[2:]], capture_output=True).stdout)"
    r = subprocess.run([str(name), "-I", "-c", wrap, str(name), PTY_SCRIPT, str(config_path), REAL_FASTFETCH, str(cols), str(rows), str(timeout)],
                       capture_output=True, timeout=timeout + 10)
    if os.environ.get("ITO_PREVIEW_RAW"):                    # the tests parse these same bytes with their own terminal model
        Path(os.environ["ITO_PREVIEW_RAW"]).write_bytes(r.stdout)
    return r.stdout


def vt_parse(raw, cols=160, rows=60, cw=7.0, ch=16.5):
    """A small terminal model of fastfetch's output: cells (char, fg, faint, bold) and kitty-graphics placements.
    fg is None (default), 0-15 (palette index), or an (r, g, b). Returns (grid, images), images = dicts row/col/c/r/path|data."""
    import base64
    grid = [[None] * cols for _ in range(rows)]
    images, chunks = [], b""
    x = y = 0
    st = {"fg": None, "faint": False, "bold": False}
    pending = None
    text = raw.decode("utf-8", "replace")
    for m in re.finditer(r"\x1b_G([^;\x1b]*);?([^\x1b]*)\x1b\\|\x1b\[([?0-9;:]*)([A-Za-z])|\x1b[()][A-Za-z0-9]|\x1b[=>78]|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)|(\r\n|\r|\n|\t|\x08)|([^\x00-\x1f\x7f]+)", text):
        if m.group(1) is not None or (m.group(0).startswith("\x1b_G")):
            params = dict(p.split("=", 1) for p in (m.group(1) or "").split(",") if "=" in p)
            payload = m.group(2) or ""
            if pending is not None:
                pending["b64"] += payload
                params_ = pending
            else:
                params_ = {"p": params, "b64": payload}
            if params.get("m") == "1":
                pending = params_
                continue
            pending = None
            p, b64 = params_["p"], params_["b64"]
            blob = base64.b64decode(b64 + "=" * (-len(b64) % 4)) if b64 else b""
            im = {"row": y, "col": x, "c": int(p.get("c", 0) or 0), "r": int(p.get("r", 0) or 0)}
            if p.get("t") == "f":
                im["path"] = blob.decode("utf-8", "replace")
            else:
                im["data"] = blob
            images.append(im)
            if im["c"] and im["r"]:
                y, x = y + im["r"] - 1, x + im["c"]          # kitty leaves the cursor on the image's last row, past its right edge
            continue
        if m.group(4):
            f, args = m.group(4), [a for a in (m.group(3) or "").replace(":", ";").split(";")]
            n = int(args[0]) if args and args[0].isdigit() else None
            if f == "C":
                x = min(cols - 1, x + (n or 1))
            elif f == "D":
                x = max(0, x - (n or 1))
            elif f == "A":
                y = max(0, y - (n or 1))
            elif f == "B":
                y = min(rows - 1, y + (n or 1))
            elif f in "Hf":
                y = max(0, (int(args[0]) if args and args[0].isdigit() else 1) - 1)
                x = max(0, (int(args[1]) if len(args) > 1 and args[1].isdigit() else 1) - 1)
            elif f == "G":
                x = max(0, (n or 1) - 1)
            elif f == "K":
                for i in range(x, cols):
                    grid[y][i] = None
            elif f == "m":
                a = [int(v) if v.isdigit() else 0 for v in (args or ["0"])] or [0]
                i = 0
                while i < len(a):
                    c = a[i]
                    if c == 0:
                        st.update(fg=None, faint=False, bold=False)
                    elif c == 1:
                        st["bold"] = True
                    elif c == 2:
                        st["faint"] = True
                    elif c == 22:
                        st.update(faint=False, bold=False)
                    elif c == 39:
                        st["fg"] = None
                    elif 30 <= c <= 37:
                        st["fg"] = c - 30
                    elif 90 <= c <= 97:
                        st["fg"] = c - 90 + 8
                    elif c == 38 and i + 2 < len(a) and a[i + 1] == 5:
                        n5 = a[i + 2]
                        if n5 < 16:
                            st["fg"] = n5
                        elif n5 < 232:
                            n5 -= 16
                            lv = lambda k: 0 if k == 0 else 55 + 40 * k
                            st["fg"] = (lv(n5 // 36), lv(n5 // 6 % 6), lv(n5 % 6))
                        else:
                            st["fg"] = (8 + 10 * (n5 - 232),) * 3
                        i += 2
                    elif c == 38 and i + 4 < len(a) and a[i + 1] == 2:
                        st["fg"] = (a[i + 2], a[i + 3], a[i + 4])
                        i += 4
                    i += 1
            continue
        if m.group(5):
            t = m.group(5)
            if t == "\r\n":
                x, y = 0, min(rows - 1, y + 1)
            elif t == "\r":
                x = 0
            elif t == "\n":
                y = min(rows - 1, y + 1)
            elif t == "\t":
                x = min(cols - 1, (x // 8 + 1) * 8)
            elif t == "\x08":
                x = max(0, x - 1)
            continue
        if m.group(6):
            for chn in m.group(6):
                w_ = wide(chn)
                if w_ == 0:
                    continue
                if x + w_ > cols:
                    break
                grid[y][x] = (chn, st["fg"], st["faint"], st["bold"])
                if w_ == 2 and x + 1 < cols:
                    grid[y][x + 1] = ("", st["fg"], st["faint"], st["bold"])
                x += w_
    return grid, images


def preview_image(layout, pic, theme, frame, cw=7.0, ch=16.5, PX=12):
    """The About window as the terminal draws it: the config `render` would write is run through the REAL fastfetch in an offscreen
    pty (live data, the picture file the config names, kitty graphics placed at the cursor, stretched to its c x r cells) and rasterised
    in the theme's palette. Nothing is simulated except the terminal itself."""
    from PIL import Image, ImageDraw, ImageFont
    import subprocess, io
    path = theme_path(theme)
    pal = theme_palette(path)
    COL.THEME_COLORS = path
    colours, _i = COL.resolve()
    light = lum(colours["ink"]) > lum(colours["bone"])
    CACHE.mkdir(parents=True, exist_ok=True)
    cfgfile = CACHE / f"preview-real-{layout}-{os.getpid()}.jsonc"
    cfgfile.write_text(render(layout, pic))
    try:
        raw = run_offscreen(cfgfile)
    finally:
        try:
            cfgfile.unlink()
        except OSError:
            pass
    GC, GR = 160, 60
    grid, images = vt_parse(raw, GC, GR, cw, ch)
    used_c = used_r = 0
    for yy, row in enumerate(grid):
        for xx, cell in enumerate(row):
            if cell and cell[0].strip():
                used_c, used_r = max(used_c, xx + 1), max(used_r, yy + 1)
    for im_ in images:
        used_c, used_r = max(used_c, im_["col"] + im_["c"]), max(used_r, im_["row"] + im_["r"])
    cols, rows = used_c + 2, used_r + 1                      # About's own slack: two columns, one cursor row
    def font_for(pattern, px):
        f = subprocess.run(["fc-match", "-f", "%{file}", pattern], capture_output=True, text=True).stdout.strip()
        return ImageFont.truetype(f, px) if f else ImageFont.load_default()
    try:
        fam = subprocess.run(["omarchy-font-current"], capture_output=True, text=True, timeout=5).stdout.strip() or "monospace"
    except (OSError, subprocess.SubprocessError):
        fam = "monospace"
    mono, cjk, nerd = font_for(fam, PX), font_for("Noto Serif CJK JP", PX), font_for("JetBrainsMono Nerd Font", PX)
    monob = font_for(fam + ":bold", PX)
    fallback = {}
    def glyph_font(o):
        if o < 0x2E80 and o > 0x7F and not 0x2800 <= o <= 0x28FF:
            if o not in fallback:
                fallback[o] = font_for(f"{fam}:charset={o:x}", PX)
            return fallback[o]
        return None
    pad = 14
    img = Image.new("RGB", (int(cols * cw) + 2 * pad, int(rows * ch) + 2 * pad), pal["bg"] or colours["ink"])
    d = ImageDraw.Draw(img)
    def rgb(hexc):
        return tuple(int(hexc[i:i + 2], 16) for i in (1, 3, 5))
    bg = rgb(pal["bg"] or colours["ink"])
    def pcolour(code, faint):
        if isinstance(code, tuple):
            c = code
        else:
            hexc = (pal["c"][code] if code is not None else pal["fg"]) or pal["fg"] or colours["bone"]
            c = rgb(hexc)
        return tuple((a + b_) // 2 for a, b_ in zip(c, bg)) if faint else c
    for im_ in images:
        try:
            src = Image.open(im_["path"]) if "path" in im_ else Image.open(io.BytesIO(im_["data"]))
            src = src.convert("RGBA")
        except (OSError, ValueError):
            continue
        box = (max(1, int(im_["c"] * cw)), max(1, int(im_["r"] * ch)))
        src = src.resize(box, Image.LANCZOS)                 # kitty stretches the picture to its c x r cells
        img.paste(src, (pad + int(im_["col"] * cw), pad + int(im_["row"] * ch)), src)
    for yy in range(min(rows, GR)):
        for xx in range(min(cols, GC)):
            cell = grid[yy][xx]
            if not cell or not cell[0].strip():
                continue
            chn, code, faint, bold = cell
            o = ord(chn)
            if 0xE000 <= o <= 0xF8FF or o >= 0xF0000 or 0x2800 <= o <= 0x28FF:
                f = nerd
            elif o >= 0x2E80:
                f = cjk
            else:
                f = glyph_font(o) or (monob if bold else mono)
            d.text((pad + xx * cw, pad + yy * ch), chn, font=f, fill=pcolour(code, faint))
    return img, {"W": cols, "H": rows, "cols": cols, "rows": rows, "light": light, "real": True,
                 "placements": [{k: v for k, v in i.items() if k != "data"} for i in images],
                 "text": ["".join((c[0] if c else " ") for c in grid[r][:cols]).rstrip() for r in range(rows)]}


def cmd_preview(args):
    """A PNG of the fetch (the About window), with sample data in your theme's colours. Writes only to ~/.cache/ito/fetch/.
    --themes a,b,c,d renders each theme and a 2 x 2 sheet; --frame ito|off overrides fetchFrame for the preview."""
    from PIL import Image
    opts = {}
    names = []
    i = 0
    while i < len(args):
        if args[i] in ("--themes", "--frame", "--style", "--picture") and i + 1 < len(args):
            opts[args[i]] = args[i + 1]
            i += 2
        else:
            if not args[i].startswith("-"):
                names.append(args[i])
            i += 1
    for flag, key, valid in (("--style", "fetchStyle", STYLE_KEYS), ("--picture", "fetchPicture", ("photo", "engraving"))):
        if opts.get(flag):
            if opts[flag] not in valid:
                fail(f"unknown {flag[2:]} {opts[flag]!r}; valid: {', '.join(valid)}")
            STYLE_OVERRIDE[key] = opts[flag]
    layouts = list(LAYOUTS) if "--all" in args else [normalise(a) for a in names] or [saved_layout()]
    if "--styles" in args:
        layouts = layouts[:1]
    themes = opts.get("--themes", "").split(",") if opts.get("--themes") else [None]
    frame_opt = opts.get("--frame")
    frame = (frame_opt == "ito") if frame_opt else (style().get("fetchFrame", "off") == "ito")
    pic = None
    for ext in IMG_EXT:
        if (MARKS / ("_fastfetch" + ext)).is_file():
            pic = MARKS / ("_fastfetch" + ext)
            break
    CACHE.mkdir(parents=True, exist_ok=True)
    items = []
    if "--styles" in args:                                          # one image per style (the Terminal pane's cards) and one sheet
        made = []
        for key in STYLE_KEYS:
            STYLE_OVERRIDE["fetchStyle"] = key
            img, info = preview_image(layouts[0], pic, themes[0], frame)
            tag = inputs_of(f"{layouts[0]}{themes[0]}{frame}{key}{img.size}{img.tobytes()[::997]!r}")
            out_png = CACHE / f"preview-style-{key}-{layouts[0]}-{themes[0] or 'current'}-{tag}.png"
            img.save(out_png)
            made.append(img)
            items.append({"style": key, "layout": layouts[0], "theme": themes[0] or "current", "path": str(out_png), "size": list(img.size), **info})
        w, h = max(m.width for m in made), max(m.height for m in made)
        sheet = Image.new("RGB", (2 * w, ((len(made) + 1) // 2) * h), (0, 0, 0))
        for k, m in enumerate(made):
            sheet.paste(m, ((k % 2) * w, (k // 2) * h))
        sp = CACHE / f"preview-styles-sheet-{inputs_of(','.join(it['path'] for it in items))}.png"
        sheet.save(sp)
        items.append({"sheet": str(sp), "size": list(sheet.size)})
        layouts = []
    for layout in layouts:
        made = []
        for theme in themes:
            img, info = preview_image(layout, pic, theme, frame)
            tag = inputs_of(f"{layout}{theme}{frame}{img.size}{img.tobytes()[::997]!r}")
            skey = style_key() + "-" if style_key() != "ito" else ""
            out_png = CACHE / f"preview-{layout}-{skey}{theme or 'current'}-{'frame' if frame else 'plain'}-{tag}.png"
            img.save(out_png)
            made.append(img)
            items.append({"layout": layout, "theme": theme or "current", "frame": frame, "path": str(out_png), "size": list(img.size), **info})
        if len(made) > 1:
            w = max(m.width for m in made)
            h = max(m.height for m in made)
            cols_ = 2
            rows_ = (len(made) + 1) // 2
            sheet = Image.new("RGB", (cols_ * w, rows_ * h), (0, 0, 0))
            for k, m in enumerate(made):
                sheet.paste(m, ((k % cols_) * w, (k // cols_) * h))
            sp = CACHE / f"preview-sheet-{layout}-{'frame' if frame else 'plain'}-{inputs_of(','.join(it['path'] for it in items))}.png"
            sheet.save(sp)
            items.append({"layout": layout, "sheet": str(sp), "size": list(sheet.size)})
    out({"ok": True, "items": items})


def cmd_doctor():
    """Plain-text findings (read-only): the same issues `status` reports."""
    probs = []
    if saved_layout() == "image" and libchafa_missing():
        probs.append(CHAFA_FIX)
    print("\n".join(probs) if probs else "ito-fastfetch: no problems found")
    sys.exit(1 if probs else 0)


args = sys.argv[1:]
if not args or args[0] in ("-h", "--help", "help"):
    print("usage: ito-fastfetch layouts|doctor|apply [LAYOUT] [--set-default]|fit|status|run|wrapper --uninstall|revert|preview [--style K|--styles|--picture photo|engraving]|eye")
    sys.exit(0 if args else 2)
cmd = args[0]
if cmd == "layouts":
    cmd_layouts()
elif cmd == "status":
    cmd_status()
elif cmd == "doctor":
    cmd_doctor()
elif cmd == "apply":
    cmd_apply(args[1:])
elif cmd == "run":
    cmd_run(args[1:])
elif cmd == "wrapper":
    cmd_wrapper(args[1:])
elif cmd == "revert":
    cmd_revert()
elif cmd == "fit":
    cmd_fit(args[1:])
elif cmd == "eye":
    cmd_eye()
elif cmd == "preview":
    cmd_preview(args[1:])
else:
    fail(f"unknown command {cmd!r}; usage: ito-fastfetch layouts|apply [LAYOUT] [--set-default]|status|run|wrapper --uninstall|revert|preview|eye")
