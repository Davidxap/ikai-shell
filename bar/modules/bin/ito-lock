#!/usr/bin/env bash
# ito-lock — a designed lock screen (hyprlock) painted in the colours of the shell.
#
# It writes ~/.config/hypr/hyprlock.conf as a whole screen: a large clock and date, the seal's letters, the
# user name, the password field and a quiet status line, all centred and placed relative to the screen size.
# Authentication is never touched (hyprlock's input-field is what unlocks), and hypridle.conf is never touched.
#
# DESIGNS (`ito-lock designs`): fog (the default), lantern, amigara, watcher, and the sheet scenes tomie, pyramid, road (Welcome Road)
# and moth (offered when `ito-assets recipe sheets` has written their pictures to ~/.config/ito/assets/lock/). Old removed names
# (panel, signpost, spiral, ...) map to fog. The saved choice is `lockDesign` in ito-style.json.
#
# Usage: ito-lock apply [--design NAME]   save your hyprlock.conf, then write the themed one (checked first; a config that
#                              fails the check is not written and your file stays byte-identical). It also installs
#                              the theme-set hook, so the screen follows theme changes. Running it twice changes nothing.
#        ito-lock revert      put back the hyprlock.conf you had before the first apply, and remove the hook
#        ito-lock designs     the designs, and which one is saved
#        ito-lock test [--design NAME|--all]   lock the screen for at most 15 seconds with the themed config, to see
#                              it render. It is unlocked by a signal, not a password; the live file is not changed
#                              and nothing is saved (the design is only tried)
#        ito-lock status      one JSON line: state (off|on|stale|partial|blocked|error), engine, what was applied and
#                              when, the inputs hash now, and the issues (see boot-lock-v2 §2.2); v1 keys kept
#        ito-lock guard [--fix|--lock]   is the running lock service's `locked` stale (status says locked with nothing behind it)?
#                              exit 0 ok, 1 stuck, 2 shell not answering. --fix restarts the shell once; --lock fixes, then locks
#        ito-lock chain       read-only: every lock path (keybind, menu, idle, suspend) and the engine behind it
#        ito-lock own ENGINE|--undo   choose who locks (omarchy-lock | ito-qs | hyprlock): prints the exact change, asks, backs
#                              up, changes; a terminal step. ito-qs installs nothing by itself: plugins/ito.lock is deployed
#        ito-lock candidate [--design NAME|--all] --out DIR   draw the layers and write validated candidate confs there
#        ito-lock preview [--design NAME|--all]   the mock lock from sample data (never a screenshot, never a locker)
#        ito-lock validate FILE [--design NAME]   the static check on any conf
#        ito-lock colours     the colours that would be used right now (writes nothing)
#
# COLOURS follow the shell exactly as ItoConfig.qml resolves them, never a fixed palette:
#   colorMode "theme" (the default): blood = pickAccent() (accentSource / accentCustom in ito-style.json, else the
#   theme accent), bone = theme foreground, ink = theme background, all from the current theme's colors.toml.
#   Any other colorMode: blood = bloodLive, bone and ink are the shell's own fixed pair.
#   lit = blood lightened like Qt.lighter(blood, 1.18). Fixed hex values are only a last resort when a file is unreadable.
# Test overrides (never with apply): ITO_LOCK_COLORS=<colors.toml>, ITO_LOCK_STYLE=<ito-style.json>.
#
# The picture is the _lockbg slot of ito-marks; with none set the background stays `path = screenshot`.
# Every command prints one JSON line and exits 0, or prints {"error": ...} and exits 1.
set -euo pipefail
ITO_LOCK_DIR="$(dirname "$(readlink -f "$0")")"
export ITO_LOCK_DIR

python3 - "$@" <<'PY'
import colorsys, glob, hashlib, json, os, re, shutil, subprocess, sys, tempfile, time
from pathlib import Path

HOME = Path(os.environ.get("HOME", "~")).expanduser()
LIVE = HOME / ".config" / "hypr" / "hyprlock.conf"
BK = HOME / ".config" / "ito" / "backups"
MARKS = HOME / ".config" / "ito" / "marks"
MARK_CACHE = HOME / ".cache" / "ito" / "marks"
CANDIDATE = HOME / ".cache" / "ito" / "lock-candidate.conf"
LOCK_MARK_PNG = HOME / ".cache" / "ito" / "lock-mark.png"
OMARCHY = HOME / ".config" / "omarchy"
ART = OMARCHY / "bar" / "modules" / "ito-art"
HOOK_DST = OMARCHY / "hooks" / "theme-set.d" / "60-ito-lock.sh"
HOOK_SRC = Path(os.environ.get("ITO_LOCK_DIR", ".")) / ".." / "hooks" / "ito-lock-theme-set.sh"
OVERRIDDEN = bool(os.environ.get("ITO_LOCK_EYE_DIR") or os.environ.get("ITO_LOCK_COLORS") or os.environ.get("ITO_LOCK_STYLE") or os.environ.get("ITO_LOCK_MONITORS"))

IMG_EXT = (".png", ".jpg", ".jpeg", ".webp")
MARK = "# ito-verse: generated by ito-lock; run `ito-lock apply` to regenerate, `ito-lock revert` to undo."
TEST_SECONDS = 15
CACHE = HOME / ".cache" / "ito" / "lock"      # the baked lock layers and the duotone fog picture, keyed by colours
TEST_DIR = HOME / ".cache" / "ito" / "lock-test"


def out(obj, code=0):
    print(json.dumps(obj))
    sys.exit(code)


def fail(message):
    out({"error": message}, 1)


def stamp():
    return time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())


def read(path):
    try:
        return path.read_text()
    except OSError:
        return None


def write_atomic(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=path.name + ".")
    with os.fdopen(fd, "w") as fh:
        fh.write(text)
    os.replace(tmp, path)


def backup(path, text):
    """Keep a timestamped copy of a file about to be replaced; the first one ever is also the .orig."""
    BK.mkdir(parents=True, exist_ok=True)
    (BK / f"{path.name}.{stamp()}").write_text(text)
    orig = BK / f"{path.name}.orig"
    if not orig.exists():
        orig.write_text(text)


# ---- colours: the same resolution as ItoConfig.qml (ito_colours.py, shared by every Boot & Lock helper) ------------

sys.path.insert(0, os.environ.get("ITO_LOCK_DIR", "."))
import ito_colours as COL
STYLE, THEME_COLORS = COL.STYLE, COL.THEME_COLORS
style, theme_colors, get, clean, hsv, from_hsv = COL.style, COL.theme_colors, COL.get, COL.clean, COL.hsv, COL.from_hsv
vivid, lighter, error_red, resolve, rgba = COL.vivid, COL.lighter, COL.error_red, COL.resolve, COL.rgba


# ---- pictures and fonts ---------------------------------------------------------------------------------------

def slot_picture():
    """The picture in the _lockbg slot, or None."""
    for ext in IMG_EXT:
        f = MARKS / ("_lockbg" + ext)
        if f.is_file() and f.stat().st_size > 0:
            return f
    return None


NOT_ON_LOCK = {"key"}      # menu marks that stay on the bar only (the lock shows no mark for them)


def find_mark_png():
    """The PNG of the user's current menuMark (custom marks and overrides first, then the shipped menu art)."""
    name = str(get(style(), "menuMark", "")).strip()
    if not name or "/" in name.replace("custom:", "", 1):
        return None
    bare = name.replace("custom:", "", 1)
    if bare in NOT_ON_LOCK:
        return None
    cands = [MARK_CACHE / f"{bare}.png", MARKS / f"{bare}.png"]
    for pattern in (f"menu-{bare}.png", f"{bare}.png"):
        cands += sorted(Path(p) for p in glob.glob(str(ART / "**" / pattern), recursive=True))
    return next((c for c in cands if c.is_file() and c.stat().st_size > 0), None)


def tinted_mark(colours):
    """The mark repainted in the resolved colours (reddish pixels become blood, the rest bone), cached; the source
    picture when Pillow is missing. Returns a path or None."""
    src = find_mark_png()
    if src is None:
        return None
    try:
        from PIL import Image
    except ImportError:
        return src
    key = hashlib.sha1(f"{src}{src.stat().st_mtime_ns}{colours['blood']}{colours['bone']}".encode()).hexdigest()[:12]
    tagged = LOCK_MARK_PNG.with_name(f"lock-mark-{key}.png")
    if not tagged.is_file():
        blood = tuple(int(colours["lit"][i:i + 2], 16) for i in (1, 3, 5))
        bone = tuple(int(colours["bone"][i:i + 2], 16) for i in (1, 3, 5))
        im = Image.open(src).convert("RGBA")
        px = im.load()
        for y in range(im.height):
            for x in range(im.width):
                r, g, b, a = px[x, y]
                if a == 0:
                    continue
                w = max(0.0, min(1.0, (r - max(g, b)) / 120))      # how red the pixel is
                lum = min(1.0, max(r, g, b) / 225)
                px[x, y] = tuple(min(255, round((blood[c] * w + bone[c] * (1 - w)) * lum)) for c in range(3)) + (a,)
        tagged.parent.mkdir(parents=True, exist_ok=True)
        tmp = tagged.with_name(f".{tagged.name}.tmp")
        im.save(tmp, format="PNG")
        os.replace(tmp, tagged)
    prune_marks(tagged)
    return tagged


def prune_marks(keep):
    """Delete old lock-mark-*.png files that no model, candidate or live conf names (the tinted mark is shared by every
    design: wiping all others on each write broke the model the shell was showing)."""
    named = (read(LIVE) or "") + (read(CANDIDATE) or "")
    for m in CACHE.glob("model-*.json") if CACHE.is_dir() else []:
        named += read(m) or ""
    for old in LOCK_MARK_PNG.parent.glob("lock-mark-*.png"):
        if old != keep and old.name not in named:
            old.unlink(missing_ok=True)


def families():
    """Every installed font family name (and alias), as a set."""
    try:
        text = subprocess.run(["fc-list", ":", "family"], capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return set()
    return {n.strip() for line in text.splitlines() for n in line.split(",") if n.strip()}


def seal_info():
    """(glyphs, scale) of the user's current seal, read from the shell's own table (ItoMarks.js); ([], 1.0) when unknown."""
    key = str(get(style(), "seal", "")).strip()
    js = read(OMARCHY / "bar" / "modules" / "ItoMarks.js") or ""
    m = re.search(r'key:\s*"%s"\s*,\s*text:\s*"([^"]*)"\s*,\s*scale:\s*([0-9.]+)' % re.escape(key), js)
    if not m:
        return [], 1.0
    return [ch for ch in m.group(1).replace("\\n", "") if not ch.isspace()], float(m.group(2))


def battery_path():
    """The capacity file of a real system battery (not a mouse or a headset), or None."""
    for d in sorted(glob.glob("/sys/class/power_supply/*")):
        p = Path(d)
        if (read(p / "type") or "").strip() == "Battery" and (read(p / "scope") or "System").strip() != "Device" \
                and (p / "capacity").is_file():
            return p / "capacity"
    return None


# ---- screen metrics and the design registry ------------------------------------------------------------------

sys.path.insert(0, os.environ.get("ITO_LOCK_DIR", "."))
try:
    import ito_ink as INK                      # numpy + Pillow; without them only the screenshot background is possible
    import ito_lock_model as LM
except ImportError as _e:                       # pragma: no cover
    INK = LM = None
    IMPORT_ERROR = str(_e)

SCENE_DIR = Path(os.environ.get("ITO_LOCK_SCENE_DIR") or HOME / ".config" / "ito" / "assets" / "lock")   # the user's scenes (recipe sheets): read here, never copied into the repo (the env var is for tests)


def scene_files():
    """{design: [(w, h, path), ...]} of the scene pictures in SCENE_DIR (<design>-<w>x<h>.png, regular files only). Never raises."""
    found = {}
    try:
        for f in SCENE_DIR.glob("*.png"):
            m = re.fullmatch(r"([a-z]+)-(\d{3,4})x(\d{3,4})\.png", f.name)
            if m and LM and m.group(1) in LM.SCENES and f.is_file() and not f.is_symlink() and f.stat().st_size > 0:
                found.setdefault(m.group(1), []).append((int(m.group(2)), int(m.group(3)), f))
    except OSError:
        pass
    return found


DESIGNS = [{**{k: d[k] for k in ("key", "name", "note", "kanji", "available")},
            **({"available": d["key"] in scene_files()} if d.get("scene") else {})} for d in LM.REGISTRY] if LM else []
DEFAULT_DESIGN = "fog"


def design_key():
    """(key, fallback): the saved lockDesign; the old keys `horizon`, `spiral`, `otherworld`, `vortex`, `weeper`, `panel`, `signpost` are aliases of `fog`; a missing key is the
    default, an unknown one (or a scene whose picture is missing) falls back to it and says so."""
    saved = style().get("lockDesign")
    key = LM.key_of(saved) if LM and saved else None
    if key and [d for d in DESIGNS if d["key"] == key and d["available"]]:
        return key, False
    return DEFAULT_DESIGN, saved not in (None, "")


def screen():
    """The largest monitor (W, H, k = H / 1440) and the list of all monitors, from `hyprctl monitors -j`;
    2560x1440 when hyprctl says nothing."""
    mons = []
    forced = os.environ.get("ITO_LOCK_MONITORS")        # tests and the nested bench: "NAME:WxH,NAME:WxH"
    if forced:
        for part in forced.split(","):
            name, _, dim = part.partition(":")
            w_, _, h_ = dim.partition("x")
            mons.append({"name": name, "width": int(w_), "height": int(h_)})
    else:
        try:
            r = subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True, text=True, timeout=5)
            for m in json.loads(r.stdout):
                mons.append({"name": str(m["name"]), "width": int(m["width"]), "height": int(m["height"])})
        except (OSError, subprocess.SubprocessError, ValueError, KeyError, TypeError):
            mons = []
    fallback = not mons
    if fallback:
        mons = [{"name": "", "width": 2560, "height": 1440}]
    big = max(mons, key=lambda m: m["width"] * m["height"])
    return {"width": big["width"], "height": big["height"], "k": big["height"] / 1440,
            "monitors": mons, "fallback": fallback}


# ---- the layers are drawn by ito_ink.py and described by ito_lock_model.py ---------------------------------------

GEN_VERSION = 4
INK_VERSION = 4          # the baked ink layers (ito_ink.py) and the inputs hash
ITO_QS_MARK = "ito-verse lock model"


def model_path(design):
    return CACHE / f"model-{design}.json"



CACHE_PREFIXES = ("frames-", "bg-", "l1-", "l2-", "l2w-", "l4-", "l5-", "l6-", "l7-", "duotone-", "ring-", "sc-")


def prune():
    """Delete cached layers that neither the live conf, the candidate nor a Quickshell model names."""
    keep = (read(LIVE) or "") + (read(CANDIDATE) or "")
    for m in CACHE.glob("model-*.json") if CACHE.is_dir() else []:
        keep += read(m) or ""
    if not CACHE.is_dir():
        return
    for item in CACHE.iterdir():
        if item.name.startswith("."):
            continue   # another run's temporary work
        if item.name.startswith(CACHE_PREFIXES) and item.name not in keep:
            shutil.rmtree(item, ignore_errors=True) if item.is_dir() else item.unlink(missing_ok=True)
    prune_marks(None)


# ---- the screen -----------------------------------------------------------------------------------------------

EYE_DIR = Path(os.environ.get("ITO_LOCK_EYE_DIR") or HOME / ".config" / "ito" / "assets" / "eye")   # the user's own art: read here, never copied into the repo (the env var is for tests)


def eye_resolve(design):
    """The user's engraved eye for the watcher: {"folder", "sig"} when `eyeArt` is not `drawn` and the file is usable, else
    None (the drawn eye) plus a reason for the health line. Never raises."""
    if design != "watcher" or str(style().get("eyeArt") or "asset") == "drawn" or INK is None:
        return None, None
    try:
        INK.eye_load(EYE_DIR)
    except INK.EyeArtError as e:
        return None, f"eye art unreadable: {e}; using the drawn eye"
    except Exception as e:
        return None, f"eye art unreadable: {type(e).__name__}; using the drawn eye"
    return {"folder": str(EYE_DIR), "sig": INK.eye_signature(EYE_DIR)}, None


def reduced_motion():
    """The system's reduced-motion preference (GNOME `enable-animations` false), the one the shell reads too. Missing tool = False."""
    try:
        r = subprocess.run(["gsettings", "get", "org.gnome.desktop.interface", "enable-animations"],
                           capture_output=True, text=True, timeout=2)
        return r.stdout.strip() == "false"
    except (OSError, subprocess.SubprocessError):
        return False


LOCK_TONE_DEFAULT = "sync"      # the user chose duotone + accent in the eye; `ito-config set lockTone flat` is the rollback


def lock_tone():
    """sync | flat: whether the lock takes a duotone with the accent hint, and the accent in the eye (lock-theme-sync)."""
    v = str(style().get("lockTone") or LOCK_TONE_DEFAULT)
    return v if v in ("sync", "flat") else LOCK_TONE_DEFAULT


def lock_ctx(bg=None, design=None):
    """Everything a design is built from, resolved now: colours, monitors, fonts, picture, mark, seal, options."""
    c, _ = resolve()
    eye, eye_note = eye_resolve(design)
    scr = screen()
    names = families()
    serif = "Noto Serif" if "Noto Serif" in names else None
    fonts = {"serif": serif,
             "clock": "Noto Serif Display Light" if "Noto Serif Display Light" in names else serif,
             "micro": next((f for f in ("JetBrains Mono Light", "JetBrainsMono Nerd Font") if f in names), None),
             "cjk": "Noto Serif CJK JP" if "Noto Serif CJK JP" in names else None}
    glyphs, seal_scale = seal_info() if fonts["cjk"] else ([], 1.0)
    saved_bg = str(style().get("lockBg") or "engraved")
    try:
        beam = max(0.50, min(0.95, float(style().get("lockBeam", 0.88))))
    except (TypeError, ValueError):
        beam = 0.88
    return {"colours": c, "monitors": scr["monitors"], "screen": scr, "fonts": names, "font_names": fonts,
            "picture": slot_picture(), "mark": tinted_mark(c), "glyphs": glyphs, "seal_scale": seal_scale,
            "tick": HOME / ".config" / "omarchy" / "bar" / "modules" / "bin" / "ito-lock-tick", "cache": CACHE,
            "lock_bg": bg or (saved_bg if saved_bg in ("engraved", "duotone", "raw", "screenshot", "ink") else "engraved"),
            "beam": beam, "eye": eye, "eye_note": eye_note, "tone": lock_tone(),
            "scenes": {design: scene_files().get(design, [])} if LM and design in LM.SCENES else {}}


def generate(design, bg=None):
    """(text, background, meta) for one design. Pure: it writes nothing; meta lists the layers stage() must draw."""
    if LM is None:
        fail("numpy and Pillow are needed to draw the lock layers (python-numpy, python-pillow): " + IMPORT_ERROR)
    design = LM.key_of(design) or DEFAULT_DESIGN
    ctx = lock_ctx(bg, design)
    c = ctx["colours"]
    spec = [("blood", "blood", 1.0, "accent: used twice at most per design"),
            ("lit", "lit", 1.0, "accent lightened 18%: the check"),
            ("bone", "bone", 1.0, "theme foreground"),
            ("bone_dim", "bone", 0.55, "foreground, quiet: date, line, status"),
            ("bone_soft", "bone", 0.72, "foreground, soft: the clock"),
            ("bone_line", "bone", 0.50, "foreground as a pen line: the field"),
            ("bone_ghost", "bone", 0.22, "foreground, a ghost"),
            ("ink", "ink", 1.0, "theme background: ground"),
            ("ink_field", "ink", 0.72, "field inner"),
            ("ink_glass", "ink", 0.38, "glass"),
            ("ink_shadow", "ink", 0.60, "soft shadow"),
            ("lit_dim", "lit", 0.38, "accent, dimmed: the seal letters"),
            ("blood_seam", "blood", 0.85, "accent as a seam"),
            ("warn", "warn", 1.0, "wrong password")]
    variables = [(n, rgba(c[k], str(a_)), note) for n, k, a_, note in spec]
    colour_vars = {n: {"hex": c[k], "a": a_} for n, k, a_, _ in spec}
    header = "\n".join([MARK, f"# ito-inputs: {lock_inputs(design)}",
                        "# Colours are resolved from the shell config and the current theme (see `ito-lock colours`), never fixed.",
                        f"# Design: {design} (see `ito-lock designs`).", ""]
                       + [f"${n} = {v}    # {note}" for n, v, note in variables])
    model = LM.build(design, ctx)
    text = LM.emit_hyprlock(model, ctx, header)
    scr = ctx["screen"]
    battery = battery_path()
    inputs = lock_inputs(design)
    qml_motion = 0 if (str(style().get("motion") or "calm") == "off" or reduced_motion()) else 1
    meta = {"design": design, "screen": {"width": scr["width"], "height": scr["height"], "k": scr["k"]},
            "tick": str(ctx["tick"]), "model": model, "ctx": ctx, "jobs": LM.jobs_of(model, ctx),
            "qml": LM.qml_model(model, ctx, colour_vars, inputs, str(battery) if battery else None),
            "background": ctx["lock_bg"] if ctx["picture"] is not None else "screenshot"}
    meta["qml"]["motion"] = qml_motion      # 0 = reduced motion / motion off: the Quickshell lock keeps every still still
    return text, ("picture" if ctx["picture"] is not None else "screenshot"), meta


def blocks_of(text):
    """[(kind, body)] for every top-level `kind { ... }` block of a hyprlock conf (no nesting in this file)."""
    return [(m.group(1), m.group(2)) for m in re.finditer(r"^([\w-]+)\s*\{\n(.*?)^\}", text, re.M | re.S)]


def block_value(body, key):
    m = re.search(rf"^[ \t]*{re.escape(key)}[ \t]*=[ \t]*(.*?)[ \t]*$", body, re.M)
    return m.group(1) if m else None


ACCENT_RE = re.compile(r"^\$(blood|lit)(_\w+)?$")


def monitor_groups(text):
    """{monitor name or '': [(kind, body)]} for the size-dependent blocks (everything but general and animations)."""
    groups = {}
    for kind, body in blocks_of(text):
        if kind in ("general", "animations"):
            continue
        groups.setdefault(block_value(body, "monitor") or "", []).append((kind, body))
    return groups


def validate(text, meta=None):
    """Static check (boot-lock-v2 §3.0 validator v2): balanced braces, a password input that still exists, every
    $variable defined, well-formed colours, no fixed hex, no signal, kill, xray or onclick, capped sizes, real fonts,
    real pictures and layers at the exact size of their monitor, and the shape of the chosen design. Returns a reason
    on failure, else None. The rendering check is the bench (scripts/lock-bench.sh) and `ito-lock test`."""
    if text.count("{") != text.count("}"):
        return "unbalanced braces"
    if not re.search(r"^input-field\s*\{", text, re.M):
        return "no input-field block: the password field would be missing"
    if not re.search(r"^background\s*\{", text, re.M):
        return "no background block"
    defined = set(re.findall(r"^\$(\w+)\s*=", text, re.M))
    # $USER and friends are hyprlock's own variables, filled in at lock time.
    used = set(re.findall(r"=\s*\$(\w+)", text)) - {"USER", "TIME", "FAIL", "ATTEMPTS", "LAYOUT", "PROMPT"}
    missing = sorted(used - defined)
    if missing:
        return "undefined variables: " + ", ".join(missing)
    good = r"rgba\(\s*\d+\s*,\s*\d+\s*,\s*\d+\s*,\s*[\d.]+\s*\)"
    for line in text.splitlines():
        m = re.match(r"^\s*(?:\$\w+|\w+)\s*=\s*(rgba?\(.*?\))", line)
        if m and not re.fullmatch(good, m.group(1)):
            return f"malformed colour: {m.group(1)}"
    for m in re.finditer(r"cmd\[update:\d+\]\s+(\S*ito-lock-tick)", text):
        if not Path(m.group(1)).is_file():
            return f"helper not found: {m.group(1)}"
    for m in re.finditer(r"^\s*path\s*=\s*(.*)$", text, re.M):
        p = m.group(1).strip()
        if p and p != "screenshot" and not Path(p).is_file():
            return f"picture not found: {p}"

    # no xray, no onclick, no fixed colour outside comments, no signal or kill, no rotate (the scroll is retired)
    code = [re.sub(r"\s#\s.*$", "", l) for l in text.splitlines() if not l.lstrip().startswith("#")]
    for line in code:
        if re.search(r"xray\s*=\s*true", line):
            return "xray is never allowed: it shows what lies under the lock"
        if re.search(r"#[0-9a-fA-F]{6}\b|\b0x[0-9a-fA-F]+", line):
            return f"fixed colour outside a comment: {line.strip()}"
        if re.search(r"^\s*onclick\s*=|^\s*rotate\s*=", line):
            return f"onclick and rotate are never used: {line.strip()}"
    if re.search(r"\bkill\b|USR[12]", text):
        return "the conf mentions kill or a USR signal: it must never signal anything"
    # the visible words: never the project's own name; lowercase outside $VARS and markup
    for kind, body in blocks_of(text):
        for key in ("text", "placeholder_text", "fail_text"):
            v = block_value(body, key)
            if v is None:
                continue
            if re.search(r"ito.?.?verse", v, re.I):
                return f"visible text names the project: {v}"
            if kind == "label" and key == "text" and not v.startswith("cmd["):
                bare = re.sub(r"<[^>]*>", "", re.sub(r"\$[A-Z0-9_]+", "", v))
                if re.search(r"[A-Z]", bare):
                    return f"label text has uppercase: {v}"
    # sizes and fonts
    names = families()
    for kind, body in blocks_of(text):
        size = block_value(body, "font_size")
        if size is not None:
            limit = 42 if re.search(r"[\u3000-\u9fff]", block_value(body, "text") or "") else 110
            if int(size) > limit:
                return f"font_size {size} above the cap of {limit}"
        fam = block_value(body, "font_family")
        if fam and fam not in names:
            return f"font not installed: {fam}"
    if "fail_timeout" not in text:
        return "general must set fail_timeout (the rust lingers 2.4 s)"

    design = (meta or {}).get("design")
    if design is None:
        m = re.search(r"^# Design: (\w+)", text, re.M)
        design = m.group(1) if m else None
    if LM is None or design not in LM.SPEC:
        return f"unknown design {design!r}"
    spec = LM.SPEC[design]
    ph, fail = LM.FIELD_TEXT[design]
    scr = screen()
    sizes = {m["name"]: (m["width"], m["height"]) for m in scr["monitors"]}
    tick = re.escape(str(HOME / ".config" / "omarchy" / "bar" / "modules" / "bin" / "ito-lock-tick"))
    groups = monitor_groups(text)
    if len(groups) > 1 and "" in groups:
        return "some blocks name a monitor and some do not"
    for mon, blks in groups.items():
        want = sizes.get(mon) if mon else (scr["width"], scr["height"])
        kinds = [k for k, _ in blks]
        # exactly one input-field per monitor, with the design's own wording
        fields = [b for k, b in blks if k == "input-field"]
        if len(fields) != 1:
            return f"expected exactly one input-field per monitor, found {len(fields)}"
        if block_value(fields[0], "fade_on_empty") != "false":
            return "input-field must set fade_on_empty = false"
        if block_value(fields[0], "placeholder_text") != ph:
            return f"input-field placeholder is not the one of {design}"
        if block_value(fields[0], "fail_text") != fail:
            return f"input-field fail text is not the one of {design}"
        # the layer stack
        bgs = [b for k, b in blks if k == "background"]
        zs = sorted(int(block_value(b, "zindex") or 0) for b in bgs)
        if zs != sorted(spec["bg"]):
            return f"{design} wants backgrounds at zindex {sorted(spec['bg'])}, found {zs}"
        timers = [b for b in bgs if block_value(b, "reload_time") is not None or block_value(b, "reload_cmd") is not None]
        if len(timers) != spec["reload"]:
            return f"{design} wants {spec['reload']} reload timer(s), found {len(timers)}"
        for body in timers:
            if block_value(body, "reload_time") != "1":
                return "reload_time must be 1 (hyprlock takes whole seconds)"
            m = re.fullmatch(rf"{tick} frame (\S+) (\d+)", block_value(body, "reload_cmd") or "")
            if not m:
                return "reload_cmd is not the frame helper"
            d, n = Path(m.group(1)), int(m.group(2))
            files = sorted(d.glob("[0-9][0-9].png"))
            if len(files) != n:
                return f"frame set {d} holds {len(files)} PNGs, wanted {n}"
            try:
                from PIL import Image
                for f in files:
                    with Image.open(f) as im:
                        if want and im.size != want:
                            return f"frame {f.name} is {im.size[0]}x{im.size[1]}, wanted {want[0]}x{want[1]}"
            except ImportError:
                return "Pillow is missing: the layers cannot be checked"
        for body in bgs:     # every baked layer at the exact size of its monitor
            path = (block_value(body, "path") or "").strip()
            if re.search(r"/(l[1-9]|l2w|duotone|sc)-[0-9a-f]{12}\.png$", path):
                try:
                    from PIL import Image
                    with Image.open(path) as im:
                        if want and im.size != want:
                            return f"layer {Path(path).name} is {im.size[0]}x{im.size[1]}, wanted {want[0]}x{want[1]}"
                except ImportError:
                    return "Pillow is missing: the layers cannot be checked"
        # images: the mark (and its ring), or none when there is no mark
        images = [b for k, b in blks if k == "image"]
        n_img = 1 if design in ("amigara", "watcher") else 2
        if design == "watcher" and len(images) != 1:
            return f"watcher carries exactly one image (the eye), found {len(images)}"
        if len(images) not in (0, n_img):
            return f"{design} carries {n_img} images (mark and ring) or none, found {len(images)}"
        if design == "watcher":     # the eye: ONE still (hyprlock reloads at most once a second, so no animation, no timer)
            body = images[0]
            if block_value(body, "reload_time") is not None or block_value(body, "reload_cmd") is not None:
                return "the eye is a still: it carries no reload_time or reload_cmd"
            path = (block_value(body, "path") or "").strip()
            if not re.search(r"/frames-[0-9a-f]{12}/eye\.png$", path):
                return "the eye's path is not a baked eye.png"
            try:
                from PIL import Image
                with Image.open(path) as im:
                    im.verify()
            except ImportError:
                return "Pillow is missing: the layers cannot be checked"
            except Exception:
                return "the eye's image is missing or unreadable"
        shapes = [b for k, b in blks if k == "shape"]
        if len(shapes) != spec["shapes"]:
            return f"{design} wants {spec['shapes']} shape(s), found {len(shapes)}"
        for sh in shapes:
            sw, shh = [int(v) for v in (block_value(sh, "size") or "0, 0").replace(" ", "").split(",")]
            if want and (sw < 0.6 * want[0] or shh > 3 * want[1] / 1440 + 1):
                return "the seam must be at least 0.6 of the width and at most 3 px tall"
            if block_value(sh, "rounding") != "0":
                return "the seam must have rounding 0"
        # restraint: at most two accent uses (the seal letters count as one use)
        uses, kanji_seen = 0, False
        for k, b in blks:
            col = block_value(b, "color")
            if k in ("label", "shape") and col and ACCENT_RE.match(col):
                if k == "label" and re.search(r"[\u3000-\u9fff]", block_value(b, "text") or ""):
                    if not kanji_seen:
                        uses, kanji_seen = uses + 1, True
                else:
                    uses += 1
        if uses > 2:
            return f"{uses} accent uses in {design}, at most 2"
        # the clock is never the accent, and the largest type is capped by design
        for k, b in blks:
            if k == "label" and "$TIME" in (block_value(b, "text") or "") and ACCENT_RE.match(block_value(b, "color") or ""):
                return "the clock is never the accent"
        if kinds.count("label") > 12:
            return "too many labels"
    return None


def stage(design, bg=None, out=None):
    """Generate the candidate for `design`, draw its layers (cached by content), write it and its metadata."""
    text, background, meta = generate(design, bg)
    ctx = meta["ctx"]
    try:
        for job, _path in meta["jobs"]:
            try:
                LM.ensure(job, ctx)
            except Exception as e:
                if job["op"] in ("l1", "duotone") and ctx["lock_bg"] in ("engraved", "duotone"):
                    # a broken picture must not stop the lock: start again with the screenshot background
                    text, background, meta = generate(design, "screenshot")
                    meta["picture_error"] = str(e)
                    return stage_finish(text, background, meta, retry=True, out=out)
                raise
    except ImportError:
        fail("numpy and Pillow are needed to draw the lock layers (install python-numpy and python-pillow)")
    return stage_finish(text, background, meta, out=out)


def stage_finish(text, background, meta, retry=False, out=None):
    if retry:
        try:
            for job, _path in meta["jobs"]:
                LM.ensure(job, meta["ctx"])
        except ImportError:
            fail("numpy and Pillow are needed to draw the lock layers (install python-numpy and python-pillow)")
    target = Path(out) if out else CANDIDATE
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(text)
    jmeta = {"design": meta["design"], "screen": meta["screen"], "tick": meta["tick"], "background": meta["background"],
             "picture_error": meta.get("picture_error")}
    target.with_suffix(".json").write_text(json.dumps(jmeta))
    return text, background, meta


def install_hook():
    """Copy the theme-set hook into Omarchy's hook directory (backed up first when a different file is there).
    Returns 'installed', 'unchanged' or 'missing source'."""
    src = read(HOOK_SRC.resolve())
    if src is None:
        return "missing source"
    current = read(HOOK_DST)
    if current == src:
        return "unchanged"
    if current is not None:
        backup(HOOK_DST, current)
    write_atomic(HOOK_DST, src)
    HOOK_DST.chmod(0o755)
    return "installed"


def remove_hook():
    if HOOK_DST.is_file():
        backup(HOOK_DST, HOOK_DST.read_text())
        HOOK_DST.unlink()
        return "removed"
    return "absent"


def take_design(argv):
    """Pull `--design NAME` and `--all` out of argv: (design or None, all_flag, rest)."""
    design, all_flag, rest, it = None, False, [], iter(argv)
    for a in it:
        if a == "--design":
            design = next(it, None)
            if design is None:
                fail("--design needs a name; run `ito-lock designs`")
        elif a.startswith("--design="):
            design = a.split("=", 1)[1]
        elif a == "--all":
            all_flag = True
        else:
            rest.append(a)
    if design is not None and design not in [d["key"] for d in DESIGNS]:
        fail(f"unknown design {design!r}; run `ito-lock designs` (see the list)")
    if rest:
        fail(f"unexpected argument {rest[0]!r}")
    return design, all_flag


def cmd_apply(argv):
    if OVERRIDDEN:
        fail("ITO_LOCK_COLORS / ITO_LOCK_STYLE are test overrides; apply refuses to write the live file with them")
    design, all_flag = take_design(argv)
    if all_flag:
        fail("--all is for `ito-lock test`")
    if design:
        # the single writer of ito-style.json persists the choice, before anything is generated
        r = subprocess.run([str(Path(os.environ["ITO_LOCK_DIR"]) / "ito-config"), "set", "lockDesign", design],
                           capture_output=True, text=True)
        if r.returncode != 0:
            fail(f"could not save lockDesign: {r.stderr.strip() or r.stdout.strip()}")
    key, fallback = design_key()
    text, background, meta = stage(key)
    reason = validate(text, meta)
    if reason:
        fail(f"candidate hyprlock.conf failed validation ({reason}); live file left untouched")
    hook = install_hook()
    extra = {"design": key, **({"design_fallback": True} if fallback else {})}
    if str(style().get("lockEngine") or "hyprlock") == "ito-qs":
        # engine B: the Quickshell view reads the model; hyprlock.conf is not touched
        body = json.dumps(meta["qml"], indent=1, sort_keys=True) + "\n"
        mp, cur = model_path(key), model_path("current")
        changed = read(mp) != body or read(cur) != body
        if changed:
            CACHE.mkdir(parents=True, exist_ok=True)
            write_atomic(mp, body)
            write_atomic(cur, body)
        prune()
        out({"ok": True, "changed": changed, "engine": "ito-qs", "model": str(cur), "hook": hook, **extra})
    current = read(LIVE)
    if current == text:
        prune()
        out({"ok": True, "changed": False, "background": background, "hook": hook, **extra})
    if current is not None:
        backup(LIVE, current)
    write_atomic(LIVE, text)
    prune()
    out({"ok": True, "changed": True, "background": background, "hook": hook, **extra,
         "backup": str(BK / f"{LIVE.name}.orig")})


# ---- who locks: one owner, chosen with its tradeoffs (boot-lock-v2 §2.3). Always a terminal step. -----------------------

OWN_DIR = BK / "own"
CLONE_ID, SOURCE_ID = "ito.lock", "omarchy.lock"
EXPLORER_ID = "io.github.sirjul1337.lock-explorer"


def json_read(path):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return None


def own_plan(engine):
    """(new shell.json dict or None, notes, hand_edits) for switching to `engine`. Nothing is written."""
    cfg = json_read(SHELL_JSON)
    if cfg is None:
        fail(f"{SHELL_JSON} is missing or not valid JSON; nothing was changed")
    new = json.loads(json.dumps(cfg))
    notes, hand = [], []
    plugins = new.setdefault("plugins", [])
    ids = [p.get("id") if isinstance(p, dict) else p for p in plugins]
    disabled = new.setdefault("disabledPlugins", [])
    restores = new.get("cloneSourceRestores", [])
    if engine == "ito-qs":
        plugin_dir = OMARCHY / "plugins" / CLONE_ID
        if not (plugin_dir / "manifest.json").is_file():
            fail(f"{plugin_dir} is not installed; deploy the suite first (scripts/deploy.sh)")
        if CLONE_ID not in ids:
            plugins.append({"id": CLONE_ID})
        if SOURCE_ID not in disabled:
            disabled.append(SOURCE_ID)
        if CLONE_ID not in restores:
            restores = restores + [CLONE_ID]
        new["cloneSourceRestores"] = restores
        notes.append(f"enables {CLONE_ID} (a clone of {SOURCE_ID}) and disables the stock lock; every path then shows the Ito lock")
        notes.append("the shell must be restarted once for the swap: ito-restart")
        if EXPLORER_ID in ids:
            notes.append(f"shell.json also lists {EXPLORER_ID}, a lock clone whose folder is not installed (it is in ~/.config.bak): "
                         "it is left as it is, but remove that entry if you ever reinstall it, two lock clones cannot both be in charge")
        hand += ["hypridle.conf: remove the 300 s listener and `lock_cmd` so only Omarchy's idle (150 s screensaver, 300 s lock) acts",
                 "Super+Ctrl+L reaches the Ito lock only when no ~/.local/bin/omarchy-system-lock wrapper shadows the stock command: `ito-repair apply paths` handles both"]
    elif engine == "omarchy-lock":
        notes.append("writes only the [lock] table of ~/.config/omarchy/shell.toml (colours of this theme); the stock lock stays in charge")
        hand += ["hypridle.conf: remove the 300 s lock listener and `lock_cmd` (two schedulers lock at 300 s otherwise)"]
    else:
        notes.append("keeps hyprlock as the lock; nothing in shell.json changes")
        hand += ["~/.local/bin/omarchy-system-lock must be what the menu runs (pending by hand, H2)",
                 "hypridle's `hyprctl dispatch exec` listener does not run under the Lua Hyprland: fix it by hand",
                 "Omarchy's own idle still locks at 300 s with its stock lock; only the ito-qs owner can make that one the Ito lock"]
    return new, notes, hand


def own_apply(engine):
    new, notes, hand = own_plan(engine)
    cfg_before = read(SHELL_JSON)
    OWN_DIR.mkdir(parents=True, exist_ok=True)
    tag = stamp()
    bdir = OWN_DIR / tag
    bdir.mkdir()
    (bdir / "shell.json").write_text(cfg_before)
    record = {"engine": engine, "at": tag, "previous_engine": str(style().get("lockEngine") or "hyprlock"),
              "shell_json_backup": str(bdir / "shell.json"), "touched_shell_json": False}
    if engine == "ito-qs":
        write_atomic(SHELL_JSON, json.dumps(new, indent=2) + "\n")
        record["touched_shell_json"] = True
        record["shell_json_after"] = hashlib.sha1(read(SHELL_JSON).encode()).hexdigest()
    r = subprocess.run([str(Path(os.environ["ITO_LOCK_DIR"]) / "ito-config"), "set", "lockEngine", engine], capture_output=True, text=True)
    if r.returncode != 0:
        fail(f"could not save lockEngine: {r.stderr.strip() or r.stdout.strip()}")
    (OWN_DIR / "last.json").write_text(json.dumps(record, indent=1))
    return record


def own_undo():
    rec = json_read(OWN_DIR / "last.json")
    if not rec:
        fail("nothing to undo: no recorded owner change")
    prev = rec.get("previous_engine", "hyprlock")
    result = "unchanged"
    if rec.get("touched_shell_json"):
        now = read(SHELL_JSON) or ""
        backup = read(Path(rec["shell_json_backup"]))
        if backup is not None and hashlib.sha1(now.encode()).hexdigest() == rec.get("shell_json_after"):
            write_atomic(SHELL_JSON, backup)                    # nothing else touched it since: byte-identical
            result = "restored byte for byte"
        else:                                                    # Omarchy changed it since: remove only our three entries
            cfg = json_read(SHELL_JSON) or {}
            cfg["plugins"] = [p for p in cfg.get("plugins", []) if (p.get("id") if isinstance(p, dict) else p) != CLONE_ID]
            cfg["disabledPlugins"] = [d for d in cfg.get("disabledPlugins", []) if d != SOURCE_ID]
            rest = [r for r in cfg.get("cloneSourceRestores", []) if r != CLONE_ID]
            if rest:
                cfg["cloneSourceRestores"] = rest
            else:
                cfg.pop("cloneSourceRestores", None)
            write_atomic(SHELL_JSON, json.dumps(cfg, indent=2) + "\n")
            result = "removed the three entries"
    subprocess.run([str(Path(os.environ["ITO_LOCK_DIR"]) / "ito-config"), "set", "lockEngine", prev], capture_output=True, text=True)
    (OWN_DIR / "last.json").unlink(missing_ok=True)
    return {"restored": result, "engine": prev}


def ask_continue():
    """True after a typed yes on the controlling terminal; None without one (this script's stdin is its own source, so the
    terminal is opened directly: a detached run from the Control Centre has none)."""
    try:
        tin, tout = open("/dev/tty", "r"), open("/dev/tty", "w")
    except OSError:
        return None
    tout.write("Continue? [y/N] ")
    tout.flush()
    return tin.readline().strip().lower() in ("y", "yes")


def cmd_own(argv):
    """ito-lock own ENGINE | --undo [--dry-run]: print exactly what changes, ask, back up every file, then change it.
    A terminal step: with no TTY it refuses (exit 1) so the Control Centre can never run it detached."""
    dry = "--dry-run" in argv
    argv = [a for a in argv if a != "--dry-run"]
    if OVERRIDDEN:
        fail("ITO_LOCK_* overrides are test-only; own refuses to run with them")
    if not argv or (argv[0] != "--undo" and argv[0] not in LM_ENGINES):
        fail(f"usage: ito-lock own {{{'|'.join(LM_ENGINES)}}} | --undo   (see boot-lock-v2 section 2.3)")
    if argv[0] == "--undo":
        print("This puts back what the last `ito-lock own` changed (the lock owner, and shell.json if it was touched).")
        if dry:
            out({"ok": True, "dry_run": True, "undo": json_read(OWN_DIR / "last.json")})
        answer = ask_continue()
        if answer is None:
            fail("this is a terminal step: run `ito-lock own --undo` in a terminal (no TTY here, nothing was changed)")
        if not answer:
            fail("cancelled; nothing was changed")
        out({"ok": True, **own_undo(), "next": "restart the shell once: ito-restart"})
    engine = argv[0]
    new, notes, hand = own_plan(engine)
    cur = str(style().get("lockEngine") or "hyprlock")
    print(f"Lock owner: {cur} -> {engine}")
    for n in notes:
        print("  - " + n)
    if engine == "ito-qs":
        before = (read(SHELL_JSON) or "").splitlines()
        after = json.dumps(new, indent=2).splitlines()
        import difflib
        d = [l for l in difflib.unified_diff(before, after, "shell.json (now)", "shell.json (after)", lineterm="", n=1)]
        print("\n".join(d) if d else "  shell.json is already as it should be")
    print("Back up first: " + str(OWN_DIR) + "/<time>/shell.json. Undo any time: ito-lock own --undo")
    if hand:
        print("By hand (this tool never edits them):")
        for h in hand:
            print("  - " + h)
    if dry:
        out({"ok": True, "dry_run": True, "engine": engine, "notes": notes, "by_hand": hand})
    answer = ask_continue()
    if answer is None:
        fail("this is a terminal step: run it in a terminal (no TTY here, nothing was changed)")
    if not answer:
        fail("cancelled; nothing was changed")
    rec = own_apply(engine)
    r = subprocess.run([str(Path(os.environ["ITO_LOCK_DIR"]) / "ito-lock"), "apply"], capture_output=True, text=True)
    out({"ok": r.returncode == 0, "engine": engine, "backup": rec["shell_json_backup"],
         "apply": (r.stdout.strip().splitlines() or [""])[-1],
         "next": ("restart the shell once: ito-restart" if engine == "ito-qs" else "done") if r.returncode == 0
                 else "the owner is set but the first apply failed: run `ito-lock apply` and read its error, or `ito-lock own --undo`"},
        0 if r.returncode == 0 else 1)


LM_ENGINES = ("omarchy-lock", "ito-qs", "hyprlock")


def cmd_validate(argv):
    """ito-lock validate FILE [--design NAME]: run the static check on any conf (read-only)."""
    design, rest = None, []
    it = iter(argv)
    for a in it:
        if a == "--design":
            design = next(it, None)
        else:
            rest.append(a)
    if len(rest) != 1:
        fail("usage: ito-lock validate FILE [--design NAME]")
    text = read(Path(rest[0]))
    if text is None:
        fail(f"cannot read {rest[0]}")
    reason = validate(text, {"design": design} if design else None)
    out({"ok": reason is None, "valid": reason is None, **({"reason": reason} if reason else {})}, 0 if reason is None else 1)


def cmd_candidate(argv):
    """Draw the layers and write the candidate conf of one design (or all) into --out DIR, validated; touches nothing
    live and locks nothing. This is what the bench, the mock renderer and the tests read."""
    outdir, rest, it = None, [], iter(argv)
    for a in it:
        if a == "--out":
            outdir = next(it, None)
        else:
            rest.append(a)
    if not outdir:
        fail("usage: ito-lock candidate [--design NAME|--all] --out DIR")
    design, all_flag = take_design(rest)
    keys = [d["key"] for d in DESIGNS if d["available"]] if all_flag else [design or design_key()[0]]
    results = []
    for key in keys:
        t0 = time.time()
        text, background, meta = stage(key, out=Path(outdir) / f"{key}.conf")
        reason = validate(text, meta)
        (Path(outdir) / f"{key}.model.json").write_text(json.dumps(meta["qml"], indent=1, sort_keys=True) + "\n")
        results.append({"design": key, "conf": str(Path(outdir) / f"{key}.conf"), "model": str(Path(outdir) / f"{key}.model.json"), "valid": reason is None,
                        **({"reason": reason} if reason else {}), "seconds": round(time.time() - t0, 2),
                        "background": background})
    out({"ok": all(r["valid"] for r in results), "candidates": results}, 0 if all(r["valid"] for r in results) else 1)


def cmd_revert():
    hook = remove_hook()
    orig = BK / f"{LIVE.name}.orig"
    if not orig.is_file():
        out({"ok": True, "restored": "no backup", "changed": False, "hook": hook})
    wanted = orig.read_text()
    if read(LIVE) == wanted:
        out({"ok": True, "restored": "unchanged", "changed": False, "hook": hook})
    write_atomic(LIVE, wanted)
    prune()
    out({"ok": True, "restored": "restored", "changed": True, "hook": hook})


def run_test(design):
    """Lock the screen for TEST_SECONDS with the candidate of `design`; unlock by SIGUSR1 (timeout sends it)."""
    text, background, meta = stage(design)
    reason = validate(text, meta)
    if reason:
        return {"design": design, "ok": False, "error": f"candidate failed validation ({reason}); nothing was started"}
    prune()
    TEST_DIR.mkdir(parents=True, exist_ok=True)
    logfile = TEST_DIR / f"{design}.log"
    cmdline = ["timeout", "-s", "USR1", "-k", "5", str(TEST_SECONDS), "hyprlock", "-c", str(CANDIDATE)]
    with open(logfile, "w") as lf:
        proc = subprocess.Popen(cmdline, stdout=lf, stderr=subprocess.STDOUT)
        alive = []
        for wait in (5, 2):          # is hyprlock still up at t=5 s and t=7 s
            time.sleep(wait)
            alive.append(proc.poll() is None)
        proc.wait()
    log = logfile.read_text()
    errors = [l for l in log.splitlines() if re.search(r"error|fail|invalid|could not|unknown", l, re.I)
              and "stray release" not in l
              and "pam_authenticate failed" not in l]   # both are teardown/input noise of the signal unlock, not config
    # a hyprlock of this test that outlived its own timeout is killed, and only that one
    mine = ["pgrep", "-f", "--", f"hyprlock -c {CANDIDATE}"]
    leftover = subprocess.run(mine, capture_output=True).returncode == 0
    if leftover:
        subprocess.run(["pkill", "-KILL", "-f", "--", f"hyprlock -c {CANDIDATE}"], capture_output=True)
        time.sleep(0.5)
    stray = subprocess.run(["pgrep", "-x", "hyprlock"], capture_output=True).returncode == 0
    return {
        "design": design, "ok": not errors and all(alive), "exit": proc.returncode,
        "seconds": TEST_SECONDS, "background": background, "errors": errors[:8], "log_lines": len(log.splitlines()),
        "alive_at_samples": alive,
        "exit_hang": proc.returncode == 137, "leftover": leftover, "stray_hyprlock_now": stray,
    }


def cmd_test(argv):
    design, all_flag = take_design(argv)
    if not os.environ.get("WAYLAND_DISPLAY"):
        fail("no Wayland session in this environment; run it from a terminal inside Hyprland")
    if subprocess.run(["pgrep", "-x", "hyprlock"], capture_output=True).returncode == 0:
        fail("hyprlock is already running; nothing was started")
    if all_flag:
        reports = []
        for d in DESIGNS:
            reports.append(run_test(d["key"]))
            if reports[-1].get("stray_hyprlock_now"):
                break
            time.sleep(2)
        out({"ok": all(r["ok"] for r in reports), "designs": reports,
             "hangs": sum(1 for r in reports if r.get("exit_hang")),
             "leftovers": sum(1 for r in reports if r.get("leftover"))}, 0 if all(r["ok"] for r in reports) else 1)
    key = design or design_key()[0]
    report = run_test(key)
    out(report, 0 if report["ok"] else 1)


# ---- the lock chain: who locks on each path (read-only; nothing here locks, writes or signals) ---------------------

# ITO_LOCK_OFFLINE=1 (tests, fixture HOMEs): no hyprctl, pgrep or systemctl; hypridle counts as running when its conf
# exists, and Omarchy's sleep lock when a marker file says the unit is enabled.
OFFLINE = os.environ.get("ITO_LOCK_OFFLINE") == "1"
OMARCHY_BIN = Path(os.environ.get("ITO_OMARCHY_BIN") or "/usr/share/omarchy/bin")
OMARCHY_DEFAULT = Path(os.environ.get("ITO_OMARCHY_DEFAULT") or "/usr/share/omarchy/default")
SHELL_JSON = OMARCHY / "shell.json"
HYPR = HOME / ".config" / "hypr"
MENU_EXT = OMARCHY / "extensions" / "omarchy-menu.jsonc"
SLEEP_MARKER = HOME / ".config" / "systemd" / "user" / "graphical-session.target.wants" / "omarchy-sleep-lock.service"
ENGINES = ("omarchy-lock", "ito-qs", "hyprlock")
ITO_PLUGIN = "ito.lock"


def shell_config():
    try:
        data = json.loads(SHELL_JSON.read_text())
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def lock_plugin(cfg=None):
    """(id, dangling): the enabled plugin cloned from omarchy.lock (it replaces the stock lock), else omarchy.lock;
    dangling = clones listed in shell.json whose folder is gone."""
    cfg = shell_config() if cfg is None else cfg
    active, dangling = None, []
    for entry in cfg.get("plugins") or []:
        pid = str((entry or {}).get("id") or "") if isinstance(entry, dict) else str(entry)
        if not pid:
            continue
        man = OMARCHY / "plugins" / pid / "manifest.json"
        try:
            meta = json.loads(man.read_text()).get("omarchy") or {}
        except (OSError, ValueError):
            if "lock" in pid:
                dangling.append(pid)
            continue
        if meta.get("clonedFrom") == "omarchy.lock" and active is None:
            active = pid
    if active and "omarchy.lock" not in (cfg.get("disabledPlugins") or []):
        dangling.append(f"{active} (omarchy.lock not disabled)")
    return active or "omarchy.lock", dangling


def strip_comments(text):
    return "\n".join(re.sub(r"(^|\s)#.*$", "", l) for l in text.splitlines())


def resolve_cmd(command):
    """The file a command line runs, resolved in Omarchy's PATH order (its bin first), or None."""
    words = command.strip().split()
    if not words:
        return None
    first = words[0]
    if first.startswith("/") or first.startswith("~"):
        p = Path(first.replace("~", str(HOME), 1))
        return p if p.is_file() else None
    dirs = [OMARCHY_BIN] + ([] if OFFLINE else [Path(d) for d in os.environ.get("PATH", "").split(":") if d])
    if OFFLINE:
        dirs.append(HOME / ".local" / "bin")
    for d in dirs:
        if (d / first).is_file():
            return d / first
    return None


def engine_of(command, plugin):
    """hyprlock | omarchy-shell | ito-qs | unknown, by what the resolved command runs."""
    base = command.strip().split()[0] if command.strip() else ""
    if base == "hyprlock":
        return "hyprlock"
    if command.strip().startswith("omarchy-shell lock"):
        return "ito-qs" if plugin == ITO_PLUGIN else "omarchy-shell"
    f = resolve_cmd(command)
    body = strip_comments(read(f) or "") if f else ""
    if re.search(r"omarchy-shell\s+lock\s+lock", body):
        return "ito-qs" if plugin == ITO_PLUGIN else "omarchy-shell"
    if re.search(r"(^|[\s;&|(])hyprlock(\s|$)", body, re.M):
        return "hyprlock"
    return "unknown"


def last_alternative(cmd):
    """`pidof hyprlock || X` runs X: the command after the last ||."""
    return cmd.split("||")[-1].strip()


def keybind_command():
    """(trigger present, command) of SUPER+CTRL+L: the user's bindings.lua override, else Omarchy's default."""
    pat = r'o\.bind\(\s*"SUPER \+ CTRL \+ L"\s*,\s*(?:"[^"]*"|nil)\s*,\s*"([^"]*)"'
    user = read(HYPR / "bindings.lua") or ""
    user_code = "\n".join(l for l in user.splitlines() if not l.lstrip().startswith("--"))
    hits = re.findall(pat, user_code, re.S)
    if hits:
        return hits[-1]
    default = read(OMARCHY_DEFAULT / "hypr" / "bindings" / "utilities.lua") or ""
    hits = re.findall(pat, default, re.S)
    if hits and not re.search(r'hl\.unbind\("SUPER \+ CTRL \+ L"\)', user_code):
        return hits[-1]
    return None


def keybind_live():
    if OFFLINE:
        return True
    try:
        binds = json.loads(subprocess.run(["hyprctl", "binds", "-j"], capture_output=True, text=True, timeout=5).stdout)
        return any(str(b.get("key", "")).upper() == "L" and int(b.get("modmask", 0)) == 68 for b in binds)
    except (OSError, subprocess.SubprocessError, ValueError, TypeError):
        return None


def menu_command():
    text = read(MENU_EXT) or ""
    hits = re.findall(r'"system\.lock"\s*:\s*\{[^}]*"action"\s*:\s*"((?:[^"\\]|\\.)*)"', text)
    if hits:
        return hits[-1], "override"
    return "omarchy-system-lock", "stock"


def hypridle_running():
    if OFFLINE:
        return (HYPR / "hypridle.conf").is_file()
    return subprocess.run(["pgrep", "-x", "hypridle"], capture_output=True).returncode == 0


def sleep_lock_enabled():
    if OFFLINE:
        return SLEEP_MARKER.exists()
    r = subprocess.run(["systemctl", "--user", "is-enabled", "omarchy-sleep-lock.service"], capture_output=True, text=True)
    return r.stdout.strip() == "enabled"


def hypridle_parts(text):
    """(general dict, [(timeout, on-timeout)]) of a hypridle.conf."""
    general, listeners = {}, []
    for kind, body in blocks_of(text):
        if kind == "general":
            for key in ("lock_cmd", "before_sleep_cmd", "after_sleep_cmd"):
                v = block_value(body, key)
                if v is not None:
                    general[key] = v
        elif kind == "listener":
            t, cmd = block_value(body, "timeout"), block_value(body, "on-timeout") or ""
            try:
                listeners.append((int(t), cmd))
            except (TypeError, ValueError):
                pass
    return general, listeners


LOCKY = r"hyprlock|omarchy-system-lock|loginctl\s+lock-session|omarchy-shell\s+lock\s+lock"


def chain():
    """Every lock path and the engine behind it, with conflicts and issues. Pure: reads files, runs nothing that
    locks."""
    cfg = shell_config()
    plugin, dangling = lock_plugin(cfg)
    paths, conflicts, issues = [], [], []
    bind = keybind_command()
    if bind:
        live = keybind_live()
        paths.append({"path": "keybind", "trigger": "SUPER+CTRL+L", "command": bind,
                      "resolved": str(resolve_cmd(bind) or ""), "engine": engine_of(bind, plugin),
                      **({} if live is not False else {"live": False})})
    mcmd, origin = menu_command()
    paths.append({"path": "menu", "command": mcmd, "origin": origin, "resolved": str(resolve_cmd(mcmd) or ""),
                  "engine": engine_of(mcmd, plugin)})
    idle = cfg.get("idle") if isinstance(cfg.get("idle"), dict) else {}
    try:
        olock = int(idle.get("lock")) if idle.get("lock") is not None else None
    except (TypeError, ValueError):
        olock = None
    if olock is not None:
        entry = {"path": "idle", "scheduler": "omarchy", "timeout": olock, "engine": engine_of("omarchy-system-lock", plugin)}
        if olock == 0:
            entry["note"] = "0 means lock immediately"
        paths.append(entry)
    hy_text = read(HYPR / "hypridle.conf") or ""
    running = hypridle_running()
    if running and hy_text:
        general, listeners = hypridle_parts(hy_text)
        for t, cmd in listeners:
            if re.search(LOCKY, cmd):
                target = last_alternative(cmd)
                broken = target.startswith("hyprctl dispatch exec")
                if broken:
                    target = target[len("hyprctl dispatch exec"):].strip()
                paths.append({"path": "idle", "scheduler": "hypridle", "timeout": t, "command": cmd,
                              "engine": engine_of(target, plugin), **({"runs": False} if broken else {})})
                if broken:
                    issues.append({"code": "hypridle_dispatch_exec", "level": "warn",
                                   "text": f"hypridle's {t} s lock goes through `hyprctl dispatch exec`, which this Hyprland does not run."})
        if general.get("before_sleep_cmd") and re.search(LOCKY, general["before_sleep_cmd"]):
            paths.append({"path": "suspend", "scheduler": "hypridle before_sleep_cmd",
                          "command": general["before_sleep_cmd"],
                          "engine": engine_of(last_alternative(general["before_sleep_cmd"]), plugin)})
    if sleep_lock_enabled():
        paths.append({"path": "suspend", "scheduler": "omarchy", "engine": engine_of("omarchy-system-lock", plugin)})
    idle_lockers = [p for p in paths if p["path"] == "idle" and p.get("runs", True)]
    by_t = {}
    for p in idle_lockers:
        by_t.setdefault(p["timeout"], []).append(p)
    for t, ps in sorted(by_t.items()):
        if len(ps) > 1:
            conflicts.append(f"two schedulers lock at {t} s")
    if len({p["scheduler"] for p in idle_lockers}) > 1 and not any(len(v) > 1 for v in by_t.values()):
        conflicts.append("two schedulers lock on idle")
    engines = {p["engine"] for p in paths if p.get("runs", True)}
    if len(engines) > 1:
        issues.append({"code": "chain_mixed", "level": "warn",
                       "text": "The lock paths use different engines: " + ", ".join(sorted(engines)) + "."})
    for d in dangling:
        issues.append({"code": "dangling_lock_plugin", "level": "warn",
                       "text": f"shell.json lists the lock plugin {d}, but its folder is not installed."})
    stay = sorted({"omarchy"} if olock is not None else set())
    return {"ok": True, "paths": paths, "conflicts": conflicts, "lock_plugin": plugin,
            "stay_awake_respected_by": stay, "issues": issues}


def engine_name(engine):
    """chain engine words -> lockEngine words."""
    return {"omarchy-shell": "omarchy-lock", "ito-qs": "ito-qs", "hyprlock": "hyprlock"}.get(engine, engine)


def in_charge(ch, engine):
    """How many of the four paths (keybind, menu, idle, suspend) the engine holds alone."""
    held = 0
    for kind in ("keybind", "menu", "idle", "suspend"):
        es = {engine_name(p["engine"]) for p in ch["paths"] if p["path"] == kind and p.get("runs", True)}
        if es == {engine}:
            held += 1
    return held


def cmd_chain():
    out(chain())


# ---- live status (§2.2): one contract for every helper -------------------------------------------------------------

INPUTS_RE = re.compile(r"^(?:#|//) ito-inputs: ([0-9a-f]{12})\s*$", re.M)


def lock_inputs(design):
    """sha12 of everything the generated lock depends on: design, the lock options, colours, picture and mark (path
    and mtime), monitors and the generator version. Pure."""
    c, _ = resolve()
    opts = {k: v for k, v in sorted(style().items()) if k.startswith("lock") and k not in ("lockTheme",)}
    pic, mark = slot_picture(), find_mark_png()
    scr = screen()

    def stat(p):
        return [str(p), p.stat().st_mtime_ns] if p else None
    eye = eye_resolve(design)[0]
    tone = lock_tone()
    scenes = sorted([str(f[2]), f[2].stat().st_mtime_ns] for f in scene_files().get(design, [])) if LM and design in LM.SCENES else []
    blob = json.dumps([design, opts, c, stat(pic), stat(mark), scr["monitors"], GEN_VERSION, INK_VERSION]
                      + ([["scenes", scenes]] if scenes else [])
                      + ([eye["sig"]] if eye else []) + ([["tone", tone, INK.TONE_VERSION]] if tone == "sync" and INK else []),
                      sort_keys=True, default=str)
    return hashlib.sha1(blob.encode()).hexdigest()[:12]


def iso_mtime(path):
    try:
        return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(path.stat().st_mtime))
    except OSError:
        return None


def missing_model_files(model_text):
    """Absolute PNG paths a lock model names that are not on disk (empty when the model does not parse)."""
    try:
        data = json.loads(model_text)
    except ValueError:
        return []
    found = []

    def walk(node):
        if isinstance(node, dict):
            p = node.get("path")
            if isinstance(p, str) and p.startswith("/") and p.lower().endswith(".png") and not Path(p).is_file():
                found.append(p)
            for v in node.values():
                walk(v)
        elif isinstance(node, list):
            for v in node:
                walk(v)
    walk(data)
    return found


def cmd_status():
    live = read(LIVE) or ""
    picture = slot_picture()
    key, fallback = design_key()
    engine = str(style().get("lockEngine") or "hyprlock")
    ch = chain()
    issues = list(ch["issues"])
    if engine == "ito-qs":
        model = read(model_path(key)) or ""
        artifact, ours = model, ITO_QS_MARK in model
        m = re.search(r'"inputs":\s*"([0-9a-f]{12})"', model)
        applied_inputs = m.group(1) if m else None
        at = iso_mtime(model_path(key))
    else:
        artifact, ours = live, MARK in live
        m = INPUTS_RE.search(live)
        applied_inputs = m.group(1) if m else None
        at = iso_mtime(LIVE)
    d = re.search(r"^# Design: (\w+)", live, re.M) if engine != "ito-qs" else re.search(r'"design":\s*"(\w+)"', artifact)
    applied_design = d.group(1) if d else None
    current = lock_inputs(key)
    held = in_charge(ch, engine)
    state = "off"
    if ours:
        reason = validate(live, {"design": applied_design}) if engine == "hyprlock" else None
        if reason:
            state = "error"
            issues.append({"code": "invalid", "level": "warn", "text": f"The lock file fails today's check: {reason}."})
        elif engine == "hyprlock" and not HOOK_DST.is_file():
            state = "partial"
            issues.append({"code": "hook_missing", "level": "warn", "text": "The theme hook is missing, so a theme change will not reach the lock."})
        elif held < 4:
            state = "blocked"
        elif applied_inputs != current or applied_design != key:
            state = "stale"
        else:
            state = "on"
    if engine == "ito-qs" and ours and missing_model_files(artifact):
        if state == "on":
            state = "stale"
        issues.append({"code": "model_file_missing", "level": "info",
                       "text": "The lock model names a picture that is gone from the cache; apply the lock again to redraw it."})
    if key == "watcher":
        note = eye_resolve(key)[1]
        if note:
            issues.append({"code": "eye_art", "level": "info", "text": note[0].upper() + note[1:] + "."})
    if lock_tone() == "sync" and style().get("lockTheme") is not True:
        issues.append({"code": "tone_no_theme", "level": "info",
                       "text": "lockTone sync is on but lockTheme is off: the lock will not follow theme changes until lockTheme is on."})
    if held < 4:
        issues.append({"code": "not_in_charge", "level": "warn",
                       "text": f"This lock is in charge of {held} of the 4 lock paths."})
    out({
        "ok": True, "surface": "lock", "state": state, "engine": engine,
        "applied": {"design": applied_design, "at": at, "inputs": applied_inputs} if ours else None,
        "current_inputs": current, "in_charge": held, "issues": issues, "conflicts": ch["conflicts"],
        # the keys of v1, kept for the page
        "installed": MARK in live, "design": key, "hook": HOOK_DST.is_file(),
        "backup": (BK / f"{LIVE.name}.orig").is_file(),
        "picture": str(picture) if picture else None,
        "background": "picture" if (MARK in live and picture and (str(picture) in live or str(CACHE / "bg-") in live)) else "screenshot",
        **({"design_fallback": True} if fallback else {}),
    })


PREVIEWS = HOME / ".cache" / "ito" / "previews"
PREVIEW_W, PREVIEW_H = 1120, 630          # the hero is shown at 560 x 315; a card thumbnail is this scaled to 532 x 300


class forced_monitors:
    """Draw for a fixed preview size, whatever the real screen is (the mock never depends on the monitor)."""
    def __enter__(self):
        self.old = os.environ.get("ITO_LOCK_MONITORS")
        os.environ["ITO_LOCK_MONITORS"] = f":{PREVIEW_W}x{PREVIEW_H}"

    def __exit__(self, *a):
        if self.old is None:
            os.environ.pop("ITO_LOCK_MONITORS", None)
        else:
            os.environ["ITO_LOCK_MONITORS"] = self.old


def preview_paths(key):
    """(hero, thumb) for the design as it would be generated now. Pure: nothing is drawn."""
    with forced_monitors():
        text = generate(key)[0]
    sha = hashlib.sha1((text + f"|{PREVIEW_W}x{PREVIEW_H}|{GEN_VERSION}").encode()).hexdigest()[:12]
    return PREVIEWS / f"lock-{key}-{sha}.png", PREVIEWS / f"lock-{key}-{sha}-thumb.png"


def cmd_preview(argv):
    """ito-lock preview [--design NAME|--all]: the mock lock, drawn from the generated conf and fixture data (never a
    screenshot, never a locker). One JSON line: {"ok": true, "items": [{"key", "path", "thumb", "cached", "ms"}]}."""
    import ito_preview
    design, all_flag = take_design(argv)
    keys = [d["key"] for d in DESIGNS if d["available"]] if all_flag else [design or design_key()[0]]
    PREVIEWS.mkdir(parents=True, exist_ok=True)
    items = []
    for key in keys:
        t0 = time.time()
        hero, thumb = preview_paths(key)
        cached = hero.is_file() and thumb.is_file()
        if not cached:
            with forced_monitors():
                text, _bg, meta = stage(key, out=PREVIEWS / f"{key}.conf")
                im = ito_preview.render_lock(text, PREVIEW_W, PREVIEW_H)
            im.save(hero, compress_level=3)
            im.resize((532, 300), INK.Image.LANCZOS).save(thumb, compress_level=3)
        items.append({"key": key, "path": str(hero), "thumb": str(thumb), "cached": cached, "ms": round((time.time() - t0) * 1000)})
    for conf in PREVIEWS.glob("*.conf"):
        conf.unlink(missing_ok=True)
        conf.with_suffix(".json").unlink(missing_ok=True)
    pngs = sorted(PREVIEWS.glob("lock-*.png"), key=lambda f: f.stat().st_mtime, reverse=True)
    for old in pngs[120:]:
        old.unlink(missing_ok=True)
    out({"ok": True, "items": items})


def cmd_designs():
    key, fallback = design_key()
    designs = []
    for d in DESIGNS:
        item = dict(d)
        item["thumb"], item["hero"] = "", ""
        if d["available"] and LM is not None:
            try:
                hero, thumb = preview_paths(d["key"])
                if thumb.is_file():
                    item["thumb"], item["hero"] = str(thumb), str(hero)
            except SystemExit:
                raise
            except Exception:
                pass
        designs.append(item)
    out({"ok": True, "current": key, "default": DEFAULT_DESIGN, "designs": designs,
         **({"design_fallback": True} if fallback else {})})


def cmd_colours():
    c, info = resolve()
    key, _ = design_key()
    text, _, _ = generate(key)
    scr = screen()
    out({"ok": True, **info, "design": key, "colours": c,
         "screen": {"width": scr["width"], "height": scr["height"], "k": round(scr["k"], 4),
                    "monitors": [m["name"] for m in scr["monitors"]], "fallback": scr["fallback"]},
         "vars": [l.split("    #")[0] for l in text.splitlines() if l.startswith("$")]})


def lock_service_status():
    """The ito.lock service's own `status` (the IPC `omarchy-shell lock status`), or None when the shell does not answer.
    ITO_LOCK_STATUS_JSON stands in for it in tests."""
    raw = os.environ.get("ITO_LOCK_STATUS_JSON")
    if raw is None:
        try:
            raw = subprocess.run(["omarchy-shell", "lock", "status"], capture_output=True, text=True, timeout=4).stdout
        except (OSError, subprocess.SubprocessError):
            return None
    try:
        data = json.loads(raw.strip().splitlines()[-1])
    except (ValueError, IndexError):
        return None
    return data if isinstance(data, dict) and "locked" in data else None


def lock_guard_state(st):
    """ok | stuck | unreachable. The service derives `locked` from requested / sessionLocked / secure; the Qt binding behind
    it has been seen to stay stale after an unlock (status said locked:true with all three false), so `lock` answered
    "ok" without locking until the shell restarted. Read-only: the answer is judged from the status alone."""
    if st is None:
        return "unreachable"
    evidence = bool(st.get("requested") or st.get("sessionLocked") or st.get("secure"))
    return "ok" if bool(st.get("locked")) == evidence else "stuck"


def cmd_guard(args):
    """ito-lock guard [--fix|--lock]: is the lock service's `locked` stale? Exit 0 ok, 1 stuck, 2 shell not answering.
      --fix   when stuck, restart the shell once (ito-restart); never locks
      --lock  fix a stuck service first (restart, wait for it), then run omarchy-system-lock: a keybind-safe lock"""
    unknown = [a for a in args if a not in ("--fix", "--lock")]
    if unknown:
        fail("usage: ito-lock guard [--fix|--lock]")
    st = lock_service_status()
    state = lock_guard_state(st)
    reply = {"ok": state == "ok", "state": state, "status": st}
    offline = OFFLINE or os.environ.get("ITO_LOCK_STATUS_JSON") is not None
    restart = Path(os.environ.get("ITO_LOCK_DIR", ".")) / "ito-restart"
    if state == "stuck" and ("--fix" in args or "--lock" in args):
        reply["action"] = "restart"
        if not offline:
            if "--lock" in args:
                subprocess.run([str(restart)], capture_output=True, timeout=90)
                for _ in range(40):
                    time.sleep(0.5)
                    if lock_guard_state(lock_service_status()) == "ok":
                        break
            else:
                subprocess.Popen([str(restart)], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                 start_new_session=True)
    if "--lock" in args and state != "unreachable":
        reply["action"] = (reply.get("action", "") + " lock").strip()
        if not offline:
            subprocess.run([str(OMARCHY_BIN / "omarchy-system-lock")], capture_output=True, timeout=30)
    out(reply, {"ok": 0, "stuck": 1, "unreachable": 2}[state])


args = sys.argv[1:]
if not args or args[0] in ("-h", "--help", "help"):
    print("usage: ito-lock apply [--design NAME]|revert|test [--design NAME|--all]|status|chain|guard|designs|colours")
    sys.exit(0 if args else 2)
cmd = args[0]
if cmd == "apply":
    cmd_apply(args[1:])
elif cmd == "revert":
    cmd_revert()
elif cmd == "own":
    cmd_own(args[1:])
elif cmd == "preview":
    cmd_preview(args[1:])
elif cmd == "validate":
    cmd_validate(args[1:])
elif cmd == "candidate":
    cmd_candidate(args[1:])
elif cmd == "test":
    cmd_test(args[1:])
elif cmd == "status":
    cmd_status()
elif cmd == "chain":
    cmd_chain()
elif cmd == "guard":
    cmd_guard(args[1:])
elif cmd == "designs":
    cmd_designs()
elif cmd == "colours":
    cmd_colours()
else:
    fail(f"unknown command {cmd!r}; usage: ito-lock apply|revert|test|status|designs|colours")
