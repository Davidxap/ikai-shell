#!/usr/bin/env python3
"""ito-health — what is wrong with the shell, why, and how to put it right.

    ito-health              JSON: a list of checks (the control centre's Health page reads this)
    ito-health --text       the same as a plain report, to paste to someone
    ito-health --report     a full report written for an AI assistant: the findings, the machine, the bar's state, the
                            log and how to fix each thing. Paste it into any assistant and it can act on it
    ito-health --report --save   the same, written to ~/ito-health-report.md
    ito-health --fix ID     run the safe fix for one check, print JSON {"ok": bool, "message": "..."}
    ito-health --fix all    run every fix that is offered
    ito-health --table      the known problems as Markdown (docs/TROUBLESHOOTING.md is made from it)

Each check is {id, name, status: ok|warn|fail, detail, why, fix, fixId, items}.
  detail  what was found, in a sentence
  why     what it means for the user (only when something is wrong)
  fix     what to do, in words (only when something is wrong)
  fixId   when set, `ito-health --fix <fixId>` does it, and the panel shows a Fix button
  items   for the error log: each distinct error once, with where it comes from, how often, why and what to do

Nothing changes unless --fix is asked for.
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

HOME = Path.home()
MODULES = Path(__file__).resolve().parent.parent
BIN = Path(__file__).resolve().parent
OMARCHY = HOME / ".config" / "omarchy"


def shutil_which(name: str):
    import shutil
    return shutil.which(name)


def sh(cmd, timeout=8) -> str:
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def repo_root():
    for cand in (os.environ.get("ITO_REPO"),
                 (HOME / ".config/ito/repo").read_text().strip() if (HOME / ".config/ito/repo").exists() else None,
                 str(Path(__file__).resolve().parents[3])):   # a run from the repo checkout itself (install.sh marks a checkout)
        if cand and (Path(cand) / "plugins").is_dir() and (Path(cand) / "install.sh").is_file():
            return Path(cand)
    return None


# ----------------------------------------------------------------------------------------- known problems
