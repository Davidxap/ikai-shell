[Icon Theme]
Name=IKAI icons
Comment=Bone linework on ink, with blood only where something is alive.
Inherits=Adwaita,hicolor
Example=folder
Directories=scalable/places,scalable/devices,scalable/mimetypes

[scalable/places]
Size=64
MinSize=8
MaxSize=512
Type=Scalable
Context=Places

[scalable/devices]
Size=64
MinSize=8
MaxSize=512
Type=Scalable
Context=Devices

[scalable/mimetypes]
Size=64
MinSize=8
MaxSize=512
Type=Scalable
Context=MimeTypes
